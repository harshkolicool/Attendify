NODE_ENV=development

PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# MONGO_URI=mongodb://127.0.0.1:27017/attendance-app
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/attendance-app

# ─── Redis (Optional but REQUIRED for cluster/multi-worker deployments) ────────
# When set, Redis is used for:
#   - Shared live location store across workers
#   - Cluster-safe rate limiting (auth, attendance, global)
#   - Distributed job locks (prevents duplicate absent-marking / push notifications)
#   - Shared student dashboard cache
# Leave empty for single-server / development deployments (falls back to in-memory).
REDIS_URL=

# ─── Secrets ─────────────────────────────────────────────────────────────────
# ⚠️  SECURITY: Generate strong random values for these secrets.
# Minimum 32 characters. Never share or commit real values.
SESSION_SECRET=change-this-to-a-long-random-session-secret-at-least-32-characters

ATTENDANCE_TOKEN_SECRET=change-this-to-a-long-random-attendance-secret-at-least-32-characters

# ─── Application URLs ─────────────────────────────────────────────────────────
APP_ORIGIN=http://localhost:3000

WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# ─── Platform Admin Seed ──────────────────────────────────────────────────────
SEED_PLATFORM_ADMIN_NAME=Platform Super Admin
SEED_PLATFORM_ADMIN_EMAIL=superadmin@attendify.com
SEED_PLATFORM_ADMIN_PASSWORD=change_this_to_a_strong_password

# ─── Vercel / Realtime Configuration ─────────────────────────────────────────
REALTIME_MODE=auto
REALTIME_POLL_INTERVAL_MS=5000

# ─── Trust Proxy (set to 1 for deployments behind Render/Railway/Vercel) ──────
# TRUST_PROXY=1

# ─── Geolocation accuracy tuning ──────────────────────────────────────────────
GPS_MAX_ACCEPTABLE_ACCURACY_METERS=300
GPS_UNCERTAINTY_CAP_METERS=250
GPS_MIN_PRACTICAL_RADIUS_METERS=80
GPS_SMALL_RADIUS_GRACE_METERS=30
GPS_NEAR_BOUNDARY_RATIO=0.5
GPS_MINIMUM_CLASSROOM_RADIUS_METERS=80

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=<your-vapid-public-key>
VAPID_PRIVATE_KEY=<your-vapid-private-key>
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ─── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=debug   # options: debug, info, warn, error (default: info)
