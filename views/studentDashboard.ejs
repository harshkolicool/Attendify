</head>
<body>

<%
    const scheduleList = typeof schedules !== "undefined" ? schedules : [];
    const activeList = typeof activeSessions !== "undefined" ? activeSessions : [];
    const todaySessionList = typeof todaySessions !== "undefined" ? todaySessions : [];
    const studentLiveBootstrap = activeList.map(function (session) {
        return {
            sessionId: session._id.toString(),
            radius: Number(session.radius || (session.classroom ? session.classroom.radius : 0) || 100)
        };
    });
    const markedList = typeof markedSessionIds !== "undefined" ? markedSessionIds : [];
    const statusMap = typeof attendanceStatusBySchedule !== "undefined" ? attendanceStatusBySchedule : {};
    const subjectSummary = typeof dashboardSubjectSummary !== "undefined" ? dashboardSubjectSummary : [];
    let presentCountView = typeof presentCount !== "undefined" ? presentCount : 0;
    let absentCountView = typeof absentCount !== "undefined" ? absentCount : 0;
    let percentageView = typeof attendancePercentage !== "undefined" ? attendancePercentage : 0;
    let totalSessionsView = typeof totalAttendanceSessions !== "undefined" ? totalAttendanceSessions : (presentCountView + absentCountView);
    const dashboardNow = new Date();
    const dashboardNowMinutes = (dashboardNow.getHours() * 60) + dashboardNow.getMinutes();

    function dashboardTimeToMinutes(timeText) {
        if (!timeText || typeof timeText !== "string") {
            return -1;
        }

        const text = timeText.trim().toUpperCase();
        const match = text.match(/^(\d{1,2}):(\d{2})\s*(AM|PM)$/);

        if (!match) {
            return -1;
        }

        let hours = Number(match[1]);
        const minutes = Number(match[2]);
        const meridian = match[3];

        if (meridian === "PM" && hours !== 12) {
            hours += 12;
        }

        if (meridian === "AM" && hours === 12) {
            hours = 0;
        }

        return (hours * 60) + minutes;
    }

    function dashboardIsLiveWindow(startTime, endTime) {
        const startMinutes = dashboardTimeToMinutes(startTime);
        const endMinutes = dashboardTimeToMinutes(endTime);

        if (startMinutes < 0 || endMinutes < 0) {
            return false;
        }

        return dashboardNowMinutes >= startMinutes && dashboardNowMinutes <= endMinutes;
    }

    function dashboardSessionScheduleId(session) {
        if (!session || !session.schedule) {
            return "";
        }

        if (session.schedule._id) {
            return session.schedule._id.toString();
        }

        return session.schedule.toString();
    }
%>

<div class="schedule-layout">

    <%- include("student/partials/sidebar", { activePage: typeof activePage !== "undefined" ? activePage : "", student: typeof student !== "undefined" ? student : null }) %>

    <main class="schedule-main">
        <header class="dashboard-header">
            <div>
                <span class="dashboard-kicker">Student Panel</span>
                <h1>Student Dashboard</h1>
                <p>Mark your attendance when your teacher starts a session.</p>
            </div>

            <div class="schedule-header-actions">
                <div class="schedule-datepicker-btn" id="studentDashboardDateBtn" title="Click to view attendance calendar">
                    <div class="schedule-datepicker-icon">
                        <i class="fa-solid fa-calendar-days"></i>
                    </div>
                    <div class="schedule-datepicker-text">
                        <span class="schedule-datepicker-kicker">Calendar</span>
                        <span class="schedule-datepicker-val">
                            <%= typeof today !== 'undefined' && today ? new Date(today + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Today' %>
                        </span>
                    </div>
                    <i class="fa-solid fa-chevron-down schedule-datepicker-arrow"></i>
                    <input type="text" id="studentDashboardDatePicker" class="schedule-hidden-input" value="<%= typeof today !== 'undefined' ? today : '' %>" readonly autocomplete="off">
                </div>

                <button type="button" class="dashboard-action-btn secondary" onclick="AttendifyAcousticRadar.openInspector()" title="Test Ultrasonic Inaudible Signal & Distance Calibration" style="background: rgba(6, 182, 212, 0.12); color: #38bdf8; border: 1px solid rgba(6, 182, 212, 0.35); cursor: pointer;">
                    <i class="fa-solid fa-tower-broadcast" style="color: #38bdf8;"></i>
                    Test Acoustic Radar
                </button>

                <a href="/student/schedule" class="dashboard-action-btn">
                    <i class="fa-solid fa-calendar-week"></i>
                    View Schedule
                </a>
            </div>
        </header>

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const picker = document.getElementById("studentDashboardDatePicker");
                const dateBtn = document.getElementById("studentDashboardDateBtn");
                const historyDates = <%- typeof historyDates !== 'undefined' ? historyDates : '{"present":[],"absent":[],"unmarked":[]}' %>;
                
                if (picker) {
                    const fp = flatpickr(picker, {
                        dateFormat: "Y-m-d",
                        defaultDate: "<%= typeof today !== 'undefined' ? today : '' %>",
                        disableMobile: true,
                        position: "auto right",
                        locale: {
                            weekdays: {
                                shorthand: ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"],
                                longhand: ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
                            }
                        },
                        onReady: function(selectedDates, dateStr, instance) {
                            if (!instance.calendarContainer.querySelector(".flatpickr-attendance-legend")) {
                                const legend = document.createElement("div");
                                legend.className = "flatpickr-attendance-legend";
                                legend.innerHTML = `
                                    <span class="legend-item"><span class="legend-dot green"></span> Present</span>
                                    <span class="legend-item"><span class="legend-dot red"></span> Absent</span>
                                    <span class="legend-item"><span class="legend-dot yellow"></span> Unmarked</span>
                                `;
                                instance.calendarContainer.appendChild(legend);
                            }
                        },
                        onChange: function(selectedDates, dateStr, instance) {
                            if (dateStr) {
                                window.location.href = '/student/schedule?date=' + dateStr;
                            }
                        },
                        onDayCreate: function(dObj, dStr, fp, dayElem) {
                            const dateObj = dayElem.dateObj;
                            if (!dateObj) return;
                            
                            const year = dateObj.getFullYear();
                            const month = String(dateObj.getMonth() + 1).padStart(2, "0");
                            const day = String(dateObj.getDate()).padStart(2, "0");
                            const localISOTime = year + "-" + month + "-" + day;
                            
                            if (historyDates.present && historyDates.present.includes(localISOTime)) {
                                dayElem.classList.add("attendance-status-present");
                                dayElem.setAttribute("title", "Present (" + localISOTime + ")");
                            } else if (historyDates.absent && historyDates.absent.includes(localISOTime)) {
                                dayElem.classList.add("attendance-status-absent");
                                dayElem.setAttribute("title", "Absent (" + localISOTime + ")");
                            } else if (historyDates.unmarked && historyDates.unmarked.includes(localISOTime)) {
                                dayElem.classList.add("attendance-status-unmarked");
                                dayElem.setAttribute("title", "Unmarked (" + localISOTime + ")");
                            }
                        }
                    });

                    if (dateBtn && fp) {
                        dateBtn.addEventListener('click', function(e) {
                            if (e.target !== picker) {
                                fp.open();
                            }
                        });
                    }
                }
            });
        </script>

        <section class="dashboard-stats-grid">
            <div class="dashboard-stat-card">
                <div class="stat-icon blue">
                    <i class="fa-solid fa-users-rectangle"></i>
                </div>
                <div>
                    <span>Class Group</span>
                    <h2><%= typeof student !== "undefined" && student.classGroup && student.classGroup.name ? student.classGroup.name : "N/A" %></h2>
                </div>
            </div>

            <button id="enablePushBtn" class="student-enable-push-pill" style="display: none;" title="Enable Notifications">
                <i class="fa-solid fa-bell"></i> Enable Notifications
            </button>

            <div class="dashboard-stat-card">
                <div class="stat-icon purple">
                    <i class="fa-solid fa-book-open"></i>
                </div>
                <div>
                    <span>Subjects</span>
                    <h2><%= Math.max((typeof student !== "undefined" && student.subjects ? student.subjects.length : 0), (typeof subjectSummary !== "undefined" ? subjectSummary.length : 0)) %></h2>
                </div>
            </div>

            <div class="dashboard-stat-card">
                <div class="stat-icon green">
                    <i class="fa-solid fa-broadcast-tower"></i>
                </div>
                <div>
                    <span>Active Sessions</span>
                    <h2><%= activeList.length %></h2>
                </div>
            </div>

            <div class="dashboard-stat-card">
                <div class="stat-icon green">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div>
                    <span>Present Today</span>
                    <h2><%= presentCountView %></h2>
                </div>
            </div>

            <div class="dashboard-stat-card">
                <div class="stat-icon red">
                    <i class="fa-solid fa-circle-xmark"></i>
                </div>
                <div>
                    <span>Absent Today</span>
                    <h2><%= absentCountView %></h2>
                </div>
            </div>

            <div class="dashboard-stat-card">
                <div class="stat-icon <%= totalSessionsView > 0 ? (percentageView >= 75 ? 'green' : 'red') : 'blue' %>">
                    <i class="fa-solid fa-chart-simple"></i>
                </div>
                <div>
                    <span>Overall Attendance</span>
                    <h2><%= percentageView %>%</h2>
                </div>
            </div>
        </section>

        <section class="student-history-card">
            <div class="student-history-card-head">
                <div>
                    <h3>Subject-wise Attendance</h3>
                    <p>Your overall attendance percentage in each subject.</p>
                </div>

                <a href="/student/attendance-history" class="view-btn">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    View Details
                </a>
            </div>

            <% if (!subjectSummary || subjectSummary.length === 0) { %>
                <div class="student-history-empty">
                    No subject-wise attendance records found yet.
                </div>
            <% } else { %>
                <div class="student-history-table-wrap">
                    <table class="student-history-table">
                        <thead>
                            <tr>
                                <th>Subject</th>
                                <th>Code</th>
                                <th>Total</th>
                                <th>Present</th>
                                <th>Absent</th>
                                <th>Attendance Rate</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% subjectSummary.forEach(function(item) { %>
                                <tr>
                                    <td><strong><%= item.name %></strong></td>
                                    <td><span class="subject-code-chip"><%= item.code || "-" %></span></td>
                                    <td><%= item.total %></td>
                                    <td class="student-success"><strong><%= item.present %></strong></td>
                                    <td class="student-danger"><strong><%= item.absent %></strong></td>
                                    <td>
                                        <div class="student-progress-wrapper">
                                            <span class="student-percent-pill <%= item.percentage >= 75 ? 'good' : (item.percentage >= 60 ? 'warning' : 'bad') %>">
                                                <%= item.percentage %>%
                                            </span>
                                            <div class="student-progress-track">
                                                <div class="student-progress-bar <%= item.percentage >= 75 ? 'good' : (item.percentage >= 60 ? 'warning' : 'bad') %>" style="width: <%= Math.min(item.percentage, 100) %>%;"></div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>

        <section class="dashboard-panel">
            <div class="dashboard-panel-head">
                <div>
                    <h3>Verification Preference</h3>
                    <p>Choose your preferred method for marking attendance on this device.</p>
                </div>
            </div>
            
            <div class="student-auth-preference-wrap">
                <label class="student-auth-option" id="studentAuthPasskeyLabel">
                    <input type="radio" name="auth_preference" value="passkey">
                    <div class="student-auth-content">
                        <div class="student-auth-icon-box passkey">
                            <i class="fa-solid fa-fingerprint"></i>
                        </div>
                        <div class="student-auth-text">
                            <div class="student-auth-title-row">
                                <strong>Use Passkey</strong>
                                <span class="student-auth-rec-badge">Recommended</span>
                            </div>
                            <p>Verify attendance securely using biometrics (Face ID / Touch ID).</p>
                        </div>
                        <div class="student-auth-check-indicator">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                    </div>
                </label>
                
                <label class="student-auth-option" id="studentAuthTrustedLabel">
                    <input type="radio" name="auth_preference" value="trusted_browser">
                    <div class="student-auth-content">
                        <div class="student-auth-icon-box trusted">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <div class="student-auth-text">
                            <div class="student-auth-title-row">
                                <strong>Use Trusted Browser</strong>
                                <span class="student-auth-badge neutral">Instant</span>
                            </div>
                            <p>Verify instantly using browser trust (Skip biometric prompt).</p>
                        </div>
                        <div class="student-auth-check-indicator">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                    </div>
                </label>
            </div>
        </section>

        <section class="dashboard-panel">
            <div class="dashboard-panel-head">
                <div>
                    <h3>Today's Schedule</h3>
                    <p>Your classes for <%= typeof today !== "undefined" ? today : "" %></p>
                </div>

                <span class="panel-count"><i class="fa-solid fa-calendar-day"></i> <%= scheduleList.length %> <%= scheduleList.length === 1 ? 'Event' : 'Events' %></span>
            </div>

            <div id="messageBox" class="schedule-message"></div>

            <% if (typeof hasPasskey !== "undefined" && !hasPasskey && typeof hasUsableTrustedDevice !== "undefined" && !hasUsableTrustedDevice) { %>
                <section class="passkey-security-card">
                    <div>
                        <h3>
                            <i class="fa-solid fa-fingerprint"></i>
                            Verification setup required
                        </h3>
                        <p>Use a passkey, or trust this browser if passkeys are not supported on this device.</p>
                    </div>
                    <a href="/student/passkeys" class="view-btn live">Open Security</a>
                </section>
            <% } %>

            <% if (!scheduleList || scheduleList.length === 0) { %>
                <div class="empty-state">
                    <i class="fa-solid fa-calendar-xmark"></i>
                    <h3>No classes today</h3>
                    <p>Your schedule is clear for today.</p>
                </div>
            <% } else { %>
                <div class="gps-help-banner">
                    <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                    <div>
                        <strong>GPS Tip:</strong> For best accuracy, use mobile Chrome, enable precise location, turn off battery saver, and wait 5–10 seconds.
                    </div>
                </div>
                <div class="schedule-list">
                    <% scheduleList.forEach(function(item) { %>
                        <%
                            const scheduleId = item._id.toString();
                            const activeSession = activeList.find(function(session) {
                                return session.schedule && session.schedule._id && session.schedule._id.toString() === scheduleId;
                            });
                            const todaySession = todaySessionList.find(function(session) {
                                return dashboardSessionScheduleId(session) === scheduleId;
                            });
                            let attendanceInfo = statusMap[scheduleId];

                            if (!attendanceInfo && activeSession && markedList.includes(activeSession._id.toString())) {
                                attendanceInfo = {
                                    status: "PRESENT",
                                    sessionId: activeSession._id.toString()
                                };
                            }

                            let cardState = "waiting";
                            let cardSessionId = "";
                            const isLiveWindow = dashboardIsLiveWindow(item.startTime, item.endTime);
                            const endMinutes = dashboardTimeToMinutes(item.endTime);
                            const isEndedWithoutAttendance = endMinutes >= 0
                                && dashboardNowMinutes > endMinutes
                                && !activeSession
                                && !attendanceInfo;

                            let actionResult = null;
                            if (typeof attendanceWindow !== "undefined" && attendanceWindow && typeof attendanceWindow.getStudentAttendanceAction === "function") {
                                actionResult = attendanceWindow.getStudentAttendanceAction({
                                    record: attendanceInfo ? attendanceInfo.record : null,
                                    session: activeSession,
                                    schedule: item
                                });
                            }

                            if (actionResult) {
                                if (actionResult.action === "PRESENT" || actionResult.action === "LATE") {
                                    cardState = "present";
                                } else if (actionResult.canMark && activeSession) {
                                    cardState = "live";
                                    cardSessionId = activeSession._id.toString();
                                } else if (actionResult.action === "AUTO_ABSENT_LOCKED" || actionResult.action === "MANUAL_ABSENT") {
                                    cardState = "absent";
                                } else if (attendanceInfo && attendanceInfo.status === "ABSENT") {
                                    cardState = "absent";
                                } else if (todaySession && !activeSession) {
                                    cardState = "pending";
                                    cardSessionId = todaySession._id.toString();
                                } else if (isLiveWindow) {
                                    cardState = "ongoing";
                                } else if (isEndedWithoutAttendance) {
                                    cardState = "unmarked";
                                }
                            } else {
                                // Fallback if helper is missing
                                if (attendanceInfo && (attendanceInfo.status === "PRESENT" || attendanceInfo.status === "LATE")) {
                                    cardState = "present";
                                } else if (attendanceInfo && attendanceInfo.status === "ABSENT") {
                                    if (activeSession) {
                                        cardState = "live";
                                        cardSessionId = activeSession._id.toString();
                                    } else {
                                        cardState = "absent";
                                    }
                                } else if (activeSession) {
                                    cardState = "live";
                                    cardSessionId = activeSession._id.toString();
                                } else if (todaySession) {
                                    cardState = "pending";
                                    cardSessionId = todaySession._id.toString();
                                } else if (isLiveWindow) {
                                    cardState = "ongoing";
                                } else if (isEndedWithoutAttendance) {
                                    cardState = "unmarked";
                                }
                            }
                        %>

                        <article
                            class="class-card"
                            data-schedule-id="<%= scheduleId %>"
                            data-session-id="<%= cardSessionId %>"
                            data-attendance-state="<%= cardState %>"
                            data-start-time="<%= item.startTime %>"
                            data-end-time="<%= item.endTime %>"
                            data-classroom-radius="<%= item.classroom ? (item.classroom.radius || 100) : 100 %>"
                        >
                            <div class="class-card-top">
                                <div class="class-card-badges">
                                    <span class="subject-pill">
                                        <%= item.subject ? item.subject.subjectCode || item.subject.subjectName : "Subject" %>
                                    </span>
                                </div>

                                <div class="class-card-status-wrap">
                                    <% if (cardState === "live") { %>
                                        <span class="status-badge live">
                                            <span class="pulse-dot"></span>
                                            Live Attendance
                                        </span>
                                    <% } else if (cardState === "ongoing") { %>
                                        <span class="status-badge ongoing">
                                            <i class="fa-solid fa-chalkboard-user"></i>
                                            In Session
                                        </span>
                                    <% } else if (cardState === "present") { %>
                                        <span class="status-badge present">
                                            <i class="fa-solid fa-circle-check"></i>
                                            Present
                                        </span>
                                    <% } else if (cardState === "absent") { %>
                                        <span class="status-badge absent">
                                            <i class="fa-solid fa-circle-xmark"></i>
                                            Absent
                                        </span>
                                    <% } else if (cardState === "unmarked") { %>
                                        <span class="status-badge unmarked">
                                            <i class="fa-solid fa-triangle-exclamation"></i>
                                            Unmarked
                                        </span>
                                    <% } else if (cardState === "pending") { %>
                                        <span class="status-badge pending">
                                            <i class="fa-solid fa-hourglass-half"></i>
                                            Pending
                                        </span>
                                    <% } else { %>
                                        <span class="status-badge waiting">
                                            <i class="fa-solid fa-clock"></i>
                                            Upcoming
                                        </span>
                                    <% } %>
                                </div>
                            </div>

                            <div class="class-content">
                                <div class="class-info">
                                    <h4><%= item.subject ? item.subject.subjectName : "Subject Missing" %></h4>
                                    <div class="class-meta-row">
                                        <span class="class-meta-item">
                                            <i class="fa-solid fa-user-tie"></i>
                                            <%= item.teacher ? item.teacher.fullName : "Teacher Missing" %>
                                        </span>
                                        <span class="class-meta-dot">·</span>
                                        <span class="class-meta-item">
                                            <i class="fa-solid fa-door-open"></i>
                                            <%= item.classroom ? item.classroom.classroomName : "Room Missing" %>
                                        </span>
                                    </div>
                                </div>

                                <div class="class-action-group">
                                    <div class="class-time">
                                        <i class="fa-regular fa-clock"></i>
                                        <span><%= item.startTime %> – <%= item.endTime %></span>
                                    </div>

                                    <div class="js-schedule-action class-action">
                                        <% if (cardState === "live") { %>
                                            <button
                                                class="view-btn live js-mark-attendance-btn"
                                                type="button"
                                                data-session-id="<%= cardSessionId %>"
                                            >
                                                <i class="fa-solid fa-location-crosshairs"></i>
                                                Mark Attendance
                                            </button>
                                        <% } else if (cardState === "ongoing") { %>
                                            <button class="view-btn" type="button" disabled title="Attendance not yet started by teacher">
                                                <i class="fa-solid fa-hourglass-half"></i>
                                                Waiting for Teacher
                                            </button>
                                        <% } else if (cardState === "present") { %>
                                            <button class="view-btn marked" type="button" disabled>
                                                <i class="fa-solid fa-check"></i>
                                                Attendance Marked
                                            </button>
                                        <% } else if (cardState === "absent") { %>
                                            <button class="view-btn marked absent" type="button" disabled>
                                                <i class="fa-solid fa-xmark"></i>
                                                Marked Absent
                                            </button>
                                        <% } else if (cardState === "unmarked") { %>
                                            <button class="view-btn unmarked" type="button" disabled>
                                                Unmarked
                                            </button>
                                        <% } else if (cardState === "pending") { %>
                                            <button class="view-btn pending" type="button" disabled>
                                                Pending Review
                                            </button>
                                        <% } else { %>
                                            <button class="view-btn" type="button" disabled>
                                                Upcoming
                                            </button>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } %>
        </section>
    </main>


</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const radios = document.querySelectorAll('input[name="auth_preference"]');
    const savedPref = localStorage.getItem('attendify_auth_pref') || 'passkey';
    
    radios.forEach(r => {
        if (r.value === savedPref) {
            r.checked = true;
        }
        r.addEventListener('change', function() {
            if (this.checked) {
                localStorage.setItem('attendify_auth_pref', this.value);
            }
        });
    });
});

const vapidPublicKey = "<%= typeof vapidPublicKey !== 'undefined' ? vapidPublicKey : '' %>";

function urlB64ToUint8Array(base64String) {
    const padding = '='.repeat((4 - base64String.length % 4) % 4);
    const base64 = (base64String + padding)
        .replace(/\-/g, '+')
        .replace(/_/g, '/');
    const rawData = window.atob(base64);
    const outputArray = new Uint8Array(rawData.length);
    for (let i = 0; i < rawData.length; ++i) {
        outputArray[i] = rawData.charCodeAt(i);
    }
    return outputArray;
}

if ('serviceWorker' in navigator && 'PushManager' in window && vapidPublicKey) {
    navigator.serviceWorker.ready.then(function(registration) {
        registration.pushManager.getSubscription().then(function(subscription) {
            if (!subscription) {
                // Subscribe automatically if we already have permission, or ask if not asked yet
                if (Notification.permission === 'granted' || Notification.permission === 'default') {
                    registration.pushManager.subscribe({
                        userVisibleOnly: true,
                        applicationServerKey: urlB64ToUint8Array(vapidPublicKey)
                    }).then(function(newSubscription) {
                        // Send subscription to server
                        fetch('/student/push/subscribe', {
                            method: 'POST',
                            headers: { 
                                'Content-Type': 'application/json',
                                'CSRF-Token': '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>'
                            },
                            body: JSON.stringify(newSubscription)
                        });
                    }).catch(function(err) {
                        console.error('Failed to subscribe to push', err);
                    });
                }
            } else {
                // Already subscribed, optionally send to server to ensure it is saved
                fetch('/student/push/subscribe', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'CSRF-Token': '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>'
                    },
                    body: JSON.stringify(subscription)
                });
            }
        });
    });
}
</script>

