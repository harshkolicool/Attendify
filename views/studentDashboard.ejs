<script>
document.addEventListener("DOMContentLoaded", async () => {
    const btn = document.getElementById("enablePushBtn");
    if (!btn || !window.PushManagerHelper) return;
    
    try {
        const status = await window.PushManagerHelper.init("student");
        if (status.supported && !status.subscribed) {
            if (Notification.permission === 'granted') {
                try { 
                    await window.PushManagerHelper.subscribe("student"); 
                } catch (err) {
                    console.warn("Auto-subscribe on granted permission:", err);
                }
                btn.style.display = "none";
            } else if (Notification.permission === 'default' || !Notification.permission) {
                btn.style.display = "inline-flex";
            } else {
                btn.style.display = "none";
            }
            
            // Attach listener for click
            btn.addEventListener("click", async () => {
                if (Notification.permission === 'denied') {
                    alert("You have blocked notifications in your browser settings. Please enable them to continue.");
                    return;
                }
                const originalText = btn.innerHTML;
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Enabling...';
                btn.disabled = true;
                try {
                    await window.PushManagerHelper.subscribe("student");
                    btn.innerHTML = '<i class="fa-solid fa-check"></i> Enabled';
                    setTimeout(() => { btn.style.display = "none"; }, 1500);
                } catch (err) {
                    btn.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> Error: ' + (err.message || 'Failed');
                    setTimeout(() => { btn.innerHTML = originalText; btn.disabled = false; }, 3000);
                }
            });
        } else {
            btn.style.display = "none";
        }
    } catch (e) {
        btn.style.display = "none";
    }
});
</script>

