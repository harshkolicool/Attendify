<!DOCTYPE html>
<html lang="en">
<head>
    <script>
        (function(){try{var t=localStorage.getItem('attendifyTheme')||localStorage.getItem('theme');if(t==='dark'||(!t&&window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches)){document.documentElement.setAttribute('data-theme','dark');document.documentElement.classList.add('dark-mode');document.documentElement.style.backgroundColor='#0b0f19';}else{document.documentElement.setAttribute('data-theme','light');document.documentElement.classList.remove('dark-mode');document.documentElement.style.backgroundColor='#f8fafc';}}catch(e){}})();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notification Inbox | Student | Attendify</title>

    <link rel="stylesheet" href="/css/uiShell.css?v=20260901_fixed3">
    <link rel="stylesheet" href="/css/studentSchedule.css?v=20260901_fixed">
    <link rel="stylesheet" href="/css/studentNotifications.css?v=20260901_fixed3">
    <link rel="stylesheet" href="/css/attendifyDarkFix.css?v=8">
    <link rel="stylesheet" href="/css/attendifyUIOverhaul.css?v=2">
    <link rel="stylesheet" href="/css/attendifyUIOverhaulExtra.css?v=19">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >
    <link rel="icon" type="image/png" href="/favicon.png">

    <!-- SweetAlert2 for Custom UI Alerts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" defer></script>
    <script src="/js/customAlerts.js" defer></script>

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#4f46e5">
    <link rel="apple-touch-icon" href="/icon-192.png">
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/service-worker.js');
            });
        }
    </script>

    <% if (typeof csrfToken !== "undefined") { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
    <% if (typeof realtimeMode !== "undefined") { %>
    <script>
    window.AttendifyRealtimeConfig = {
        mode: <%- JSON.stringify(realtimeMode) %>,
        pollIntervalMs: <%= typeof realtimePollIntervalMs !== "undefined" ? realtimePollIntervalMs : 5000 %>
    };
    </script>
    <% } %>
</head>
<body>

<%
    const safeNotifications = (typeof notifications !== "undefined" && notifications) ? notifications : [];
    const safeUnreadCount = (typeof unreadCount !== "undefined") ? unreadCount : safeNotifications.filter(n => !n.isRead).length;
    const safeStudent = (typeof student !== "undefined" && student) ? student : null;
%>

<div class="student-layout">
    <%- include("student/partials/sidebar", { activePage: "notifications", student: safeStudent }) %>

    <main class="student-main student-notifications-page">
        <!-- COMPACT RESPONSIVE HEADER -->
        <header class="student-header student-notif-header">
            <div class="student-notif-header-left">
                <div class="student-avatar-badge" style="width: 40px; height: 40px; font-size: 1.05rem; border-radius: 12px; flex-shrink: 0; background: rgba(99, 102, 241, 0.15); color: #6366f1; display: inline-flex; align-items: center; justify-content: center; font-weight: 800;">
                    <%= safeStudent && (safeStudent.fullName || safeStudent.name) ? (safeStudent.fullName || safeStudent.name).charAt(0).toUpperCase() : "S" %>
                </div>
                <div class="student-notif-header-titles">
                    <h1>Notification Inbox</h1>
                    <p>Track attendance verifications, passkey approvals, and campus announcements.</p>
                </div>
            </div>
            <div>
                <a href="/student/dashboard" class="notif-btn secondary" title="Dashboard">
                    <i class="fa-solid fa-gauge-high"></i>
                    <span>Dashboard</span>
                </a>
            </div>
        </header>

        <!-- 4-KPI RADAR CARDS (2x2 ON MOBILE) -->
        <section class="student-notif-kpi-grid">
            <div class="student-notif-kpi-card">
                <div class="student-notif-kpi-icon bell">
                    <i class="fa-solid fa-bell"></i>
                </div>
                <div class="student-notif-kpi-body">
                    <span class="student-notif-kpi-label">Total Notices</span>
                    <strong class="student-notif-kpi-val"><%= safeNotifications.length %> Alerts</strong>
                </div>
            </div>

            <div class="student-notif-kpi-card">
                <div class="student-notif-kpi-icon mail">
                    <i class="fa-solid fa-envelope-open-text"></i>
                </div>
                <div class="student-notif-kpi-body">
                    <span class="student-notif-kpi-label">Unread Messages</span>
                    <strong class="student-notif-kpi-val <%= safeUnreadCount > 0 ? 'primary' : 'success' %>">
                        <%= safeUnreadCount %> Unread
                    </strong>
                </div>
            </div>

            <div class="student-notif-kpi-card">
                <div class="student-notif-kpi-icon fido">
                    <i class="fa-solid fa-fingerprint"></i>
                </div>
                <div class="student-notif-kpi-body">
                    <span class="student-notif-kpi-label">Biometrics</span>
                    <strong class="student-notif-kpi-val success">FIDO2 Active</strong>
                </div>
            </div>

            <div class="student-notif-kpi-card">
                <div class="student-notif-kpi-icon sync">
                    <i class="fa-solid fa-bolt"></i>
                </div>
                <div class="student-notif-kpi-body">
                    <span class="student-notif-kpi-label">Sync Engine</span>
                    <strong class="student-notif-kpi-val success">Connected</strong>
                </div>
            </div>
        </section>

        <!-- NOTIFICATION INBOX CARD -->
        <section class="student-notif-inbox-card">
            <div class="student-notif-inbox-header">
                <div class="student-notif-inbox-title">
                    <div class="student-notif-title-row">
                        <h3><i class="fa-solid fa-inbox text-indigo"></i> Recent Dispatches</h3>
                        <span class="student-notif-count-pill">
                            <%= safeUnreadCount %> <%= safeUnreadCount === 1 ? 'Unread' : 'Unread' %>
                        </span>
                    </div>
                    <p>Chronological feed of your portal notifications and authorizations.</p>
                </div>

                <div class="student-notif-inbox-actions">
                    <form action="/student/notifications/mark-all-read" method="POST" class="notif-form-action">
                        <button class="notif-btn secondary" type="submit">
                            <i class="fa-solid fa-check-double"></i>
                            <span>Mark All Read</span>
                        </button>
                    </form>

                    <form
                        action="/student/notifications/clear-all"
                        method="POST"
                        onsubmit="return uiConfirm(event, 'Clear all notifications? This cannot be undone.')"
                        class="notif-form-action"
                    >
                        <button class="notif-btn danger" type="submit">
                            <i class="fa-solid fa-trash"></i>
                            <span>Clear All</span>
                        </button>
                    </form>
                </div>
            </div>

            <% if (safeNotifications.length === 0) { %>
                <div style="padding: 36px 16px; text-align: center;">
                    <i class="fa-solid fa-envelope-open" style="font-size: 2rem; opacity: 0.3; margin-bottom: 8px; display: block;"></i>
                    <h4 style="margin: 0 0 4px 0; font-weight: 700;">Inbox Zero</h4>
                    <p style="margin: 0; color: #94a3b8; font-size: 0.82rem;">You have no notifications yet. Announcements and passkey approvals will appear here.</p>
                </div>
            <% } else { %>
                <div class="student-notif-feed">
                    <% safeNotifications.forEach(function(notification) { %>
                        <article class="student-notif-item <%= !notification.isRead ? 'is-unread' : '' %>">
                            <div class="student-notif-item-top">
                                <h4 class="student-notif-item-title">
                                    <% if (!notification.isRead) { %>
                                        <span class="student-notif-unread-dot"></span>
                                    <% } %>
                                    <%= notification.title %>
                                </h4>
                                <span class="student-notif-item-time">
                                    <i class="fa-solid fa-clock"></i>
                                    <%= new Date(notification.createdAt).toLocaleDateString() %>, <%= new Date(notification.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                                </span>
                            </div>

                            <p class="student-notif-item-msg"><%= notification.message %></p>

                            <div class="student-notif-item-footer">
                                <span class="student-notif-category-chip">
                                    <i class="fa-solid fa-tag"></i>
                                    <%= notification.category || "GENERAL" %>
                                </span>

                                <div class="student-notif-actions">
                                    <% if (notification.link) { %>
                                        <a class="notif-btn secondary" href="<%= notification.link %>">
                                            <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                            <span>Open</span>
                                        </a>
                                    <% } %>

                                    <% if (!notification.isRead) { %>
                                        <form action="/student/notifications/<%= notification.id || notification._id %>/read" method="POST">
                                            <button class="notif-btn primary" type="submit">
                                                <i class="fa-solid fa-check"></i>
                                                <span>Mark Read</span>
                                            </button>
                                        </form>
                                    <% } %>

                                    <form
                                        action="/student/notifications/<%= notification.id || notification._id %>/delete"
                                        method="POST"
                                        onsubmit="return uiConfirm(event, 'Delete this notification?')"
                                    >
                                        <button class="notif-btn danger" type="submit">
                                            <i class="fa-solid fa-trash"></i>
                                            <span>Delete</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } %>
        </section>
    </main>
</div>

<script type="application/json" id="studentLiveSessionBootstrap"><%- typeof studentLiveBootstrap !== "undefined" ? JSON.stringify(studentLiveBootstrap).replace(/</g, "\\u003c") : "[]" %></script>

<script>
    window.AttendifyRealtimeConfig = {
        mode: "<%= typeof realtimeMode !== 'undefined' ? realtimeMode : 'auto' %>",
        pollIntervalMs: <%= typeof realtimePollIntervalMs !== 'undefined' ? realtimePollIntervalMs : 5000 %>
    };
</script>

<% if (typeof realtimeMode === 'undefined' || realtimeMode === 'socket' || realtimeMode === 'auto') { %>
<script src="/socket.io/socket.io.js"></script>
<% } %>
<script src="/js/kalmanFilter.js"></script>
<script src="/js/locationStabilizer.js"></script>
<script src="/js/geoAccuracy.js"></script>
<script src="/js/studentRealtime.js"></script>
<script src="/js/studentLiveLocation.js"></script>
<script src="/js/uiShell.js"></script>

    <script src="/js/csrfAuto.js" defer></script>
    <script src="/js/selectEnhancer.js?v=3" defer></script>
</body>
</html>
