                                                        <i class="fa-solid fa-triangle-exclamation"></i>
                                                        <%= group.reasonMessage %>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="teacher-group-trailing">
                                            <span class="teacher-count-pill danger" data-teacher-attempt-visible-count>
