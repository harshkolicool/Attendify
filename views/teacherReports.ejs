<!DOCTYPE html>
<html lang="en">
<head>
    <script>
        (function(){try{var t=localStorage.getItem('attendifyTheme')||localStorage.getItem('theme');if(t==='dark'||(!t&&window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches)){document.documentElement.setAttribute('data-theme','dark');document.documentElement.classList.add('dark-mode');document.documentElement.style.backgroundColor='#0b0f19';}else{document.documentElement.setAttribute('data-theme','light');document.documentElement.classList.remove('dark-mode');document.documentElement.style.backgroundColor='#f8fafc';}}catch(e){}})();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teacher Reports | Attendify</title>

    <!-- Preconnect to external CDNs for faster DNS resolution -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://fonts.gstatic.com">

    <link rel="stylesheet" href="/css/uiShell.css?v=20260901_fixed3">
    <link rel="stylesheet" href="/css/teacherDashboard.css?v=20260901_kpi_theme">
    <link rel="stylesheet" href="/css/attendifyDarkFix.css?v=8_18">
    <link rel="stylesheet" href="/css/attendifyUIOverhaul.css?v=20260831_18">
    <link rel="stylesheet" href="/css/attendifyUIOverhaulExtra.css?v=19_20">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >
    <link rel="icon" type="image/png" href="/favicon.png">

    <!-- SweetAlert2 for Custom UI Alerts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" defer></script>
    <script src="/js/customAlerts.js" defer></script>

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#4f46e5">
    <link rel="apple-touch-icon" href="/icon-192.png">
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/service-worker.js');
            });
        }
    </script>


    <% if (typeof csrfToken !== "undefined") { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
    <% if (typeof realtimeMode !== "undefined") { %>
    <script>
    window.AttendifyRealtimeConfig = {
        mode: <%- JSON.stringify(realtimeMode) %>,
        pollIntervalMs: <%= typeof realtimePollIntervalMs !== "undefined" ? realtimePollIntervalMs : 5000 %>
    };
    </script>
    <% } %>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.js"></script>

    <style>
        @media print {
            body { background: white !important; color: black !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .teacher-sidebar, .teacher-header, .teacher-export-card, .teacher-report-filter-card, .teacher-report-nav-card, .teacher-report-directory-toolbar { display: none !important; }
            .teacher-main { padding: 0 !important; margin: 0 !important; width: 100% !important; max-width: 100% !important; }
            .teacher-report-panel { display: block !important; border: none !important; box-shadow: none !important; margin-bottom: 2rem; }
            
            /* Print Header Styling */
            .print-only-header { display: block !important; text-align: center; margin-bottom: 30px; border-bottom: 2px solid #1e293b; padding-bottom: 20px; }
            .print-only-header h1 { font-size: 24pt; color: #0f172a; margin: 0 0 10px 0; }
            .print-only-header p { font-size: 12pt; color: #475569; margin: 0; }
            
            /* General Elements */
            .teacher-card { border: none !important; box-shadow: none !important; padding: 0 !important; margin-bottom: 20px !important; }
            .teacher-report-overview-card { display: flex; flex-direction: column; align-items: center; text-align: center; margin-bottom: 40px !important; }
            .teacher-report-overview-top { justify-content: center; width: 100%; margin-bottom: 15px; }
            .teacher-report-overview-chips { justify-content: center; flex-wrap: wrap; }
            
            /* Stats Grid */
            .teacher-report-summary-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; break-inside: avoid; }
            .teacher-report-stat { border: 1px solid #e2e8f0 !important; border-radius: 12px !important; padding: 15px !important; box-shadow: none !important; }
            .teacher-report-stat strong { font-size: 20pt !important; }
            
            /* Tables */
            .teacher-report-group-panel { border: none !important; box-shadow: none !important; margin-bottom: 30px !important; break-inside: avoid; }
            .teacher-report-group-summary { border-bottom: 2px solid #e2e8f0; padding-bottom: 10px; margin-bottom: 15px; background: transparent !important; }
            .teacher-report-group-summary h4 { font-size: 14pt !important; color: #1e293b !important; }
            .teacher-report-group-summary i.fa-chevron-down { display: none !important; } 
            
            .teacher-table-wrap { overflow: visible !important; }
            .teacher-report-table { border-collapse: collapse !important; width: 100% !important; font-size: 10pt !important; margin-bottom: 20px !important; border: 1px solid #e2e8f0 !important; }
            .teacher-report-table th { background-color: #f1f5f9 !important; color: #334155 !important; font-weight: bold !important; padding: 10px !important; border-bottom: 2px solid #cbd5e1 !important; border-right: 1px solid #e2e8f0 !important; }
            .teacher-report-table td { border-bottom: 1px solid #e2e8f0 !important; border-right: 1px solid #e2e8f0 !important; padding: 10px !important; color: #1e293b !important; }
            .teacher-report-table tr:nth-child(even) td { background-color: #f8fafc !important; }
            
            /* Pills and Badges */
            .teacher-count-pill, .teacher-percent-pill, .teacher-status, .gps-distance-pill { 
                border: 1px solid #cbd5e1 !important; 
                background: transparent !important; 
                color: #0f172a !important; 
                padding: 4px 8px !important;
                border-radius: 6px !important;
                font-weight: bold !important;
            }
            .teacher-success, .teacher-status.present { color: #15803d !important; border-color: #bbf7d0 !important; background: #f0fdf4 !important; }
            .teacher-danger, .teacher-status.absent { color: #b91c1c !important; border-color: #fecaca !important; background: #fef2f2 !important; }
        }
        
        .print-only-header { display: none; }
    </style>
</head>
<body>

<div class="teacher-page">

    <%- include("teacher/partials/sidebar", { activePage: typeof activePage !== "undefined" ? activePage : "reports", teacher: typeof teacher !== "undefined" ? teacher : null }) %>

    <main class="teacher-main teacher-reports-page">
    
        <div class="print-only-header">
            <h1>Attendify Attendance Report</h1>
            <p>Generated on <%= new Date().toLocaleDateString() %> at <%= new Date().toLocaleTimeString() %></p>
            <p>Teacher: <%= teacher.fullName %></p>
        </div>

        <header class="teacher-header">
            <div>
                <span class="teacher-kicker">Teacher Panel</span>
                <h1>Attendance Reports</h1>
                <p>View your class-wise, subject-wise and student-wise attendance records.</p>
            </div>
        </header>

        <%
            const exportQuery = [
                "fromDate=" + encodeURIComponent(filters.fromDate),
                "toDate=" + encodeURIComponent(filters.toDate),
                "classGroupId=" + encodeURIComponent(filters.classGroupId),
                "subjectId=" + encodeURIComponent(filters.subjectId),
                "classroomId=" + encodeURIComponent(filters.classroomId),
                "status=" + encodeURIComponent(filters.status)
            ].join("&");

            const selectedClassGroup = (classGroups || []).find(function(group) {
                return filters.classGroupId && filters.classGroupId !== "all" && group._id.toString() === filters.classGroupId;
            });

            const selectedSubject = (subjects || []).find(function(subject) {
                return filters.subjectId && filters.subjectId !== "all" && subject._id.toString() === filters.subjectId;
            });

            const filterFlags = [
                filters.classGroupId && filters.classGroupId !== "all",
                filters.subjectId && filters.subjectId !== "all",
                filters.classroomId && filters.classroomId !== "all",
                filters.status && filters.status !== "all"
            ];

            const activeFilterCount = filterFlags.filter(function(flag) {
                return Boolean(flag);
            }).length;

            const detailedRecordGroupMap = {};

            (attendanceRecords || []).forEach(function(record) {
                const subjectName = record.subject ? record.subject.subjectName : "Subject Missing";
                const subjectCode =
                    record.subject && record.subject.subjectCode
                        ? record.subject.subjectCode
                        : "";
                const className = record.classGroup ? record.classGroup.name : "Class Missing";
                const groupKey = subjectName + "||" + className;

                if (!detailedRecordGroupMap[groupKey]) {
                    detailedRecordGroupMap[groupKey] = {
                        key: groupKey,
                        subjectName: subjectName,
                        subjectCode: subjectCode,
                        className: className,
                        present: 0,
                        absent: 0,
                        records: []
                    };
                }

                if (record.status === "PRESENT") {
                    detailedRecordGroupMap[groupKey].present += 1;
                }

                if (record.status === "ABSENT") {
                    detailedRecordGroupMap[groupKey].absent += 1;
                }

                detailedRecordGroupMap[groupKey].records.push(record);
            });

            const detailedRecordGroups = Object.values(detailedRecordGroupMap).sort(function(first, second) {
                const subjectCompare = first.subjectName.localeCompare(second.subjectName);

                if (subjectCompare !== 0) {
                    return subjectCompare;
                }

                return first.className.localeCompare(second.className);
            });

            detailedRecordGroups.forEach(function(group, index) {
                group.filterId = "record-group-" + String(index + 1);

                group.records.sort(function(firstRecord, secondRecord) {
                    const firstSession = firstRecord.attendanceSession;
                    const secondSession = secondRecord.attendanceSession;

                    const firstDate = firstSession && firstSession.startTime
                        ? new Date(firstSession.startTime)
                        : new Date(firstRecord.createdAt);
                    const secondDate = secondSession && secondSession.startTime
                        ? new Date(secondSession.startTime)
                        : new Date(secondRecord.createdAt);

                    return secondDate.getTime() - firstDate.getTime();
                });
            });

            const suspiciousAttemptGroupMap = {};

            (suspiciousAttempts || []).forEach(function(attempt) {
                const reasonCode = attempt.reasonCode || "UNKNOWN";
                const reasonMessage = attempt.reasonMessage || "Suspicious attendance attempt.";

                if (!suspiciousAttemptGroupMap[reasonCode]) {
                    suspiciousAttemptGroupMap[reasonCode] = {
                        reasonCode: reasonCode,
                        reasonMessage: reasonMessage,
                        attempts: []
                    };
                }

                suspiciousAttemptGroupMap[reasonCode].attempts.push(attempt);
            });

            const suspiciousAttemptGroups = Object.values(suspiciousAttemptGroupMap).sort(function(first, second) {
                return second.attempts.length - first.attempts.length;
            });

            suspiciousAttemptGroups.forEach(function(group, index) {
                group.filterId = "attempt-group-" + String(index + 1);

                group.attempts.sort(function(firstAttempt, secondAttempt) {
                    return new Date(secondAttempt.createdAt).getTime() - new Date(firstAttempt.createdAt).getTime();
                });
            });
        %>

        <!-- Header Banner & Active Context Bar -->
        <section class="teacher-report-header-banner">
            <div class="teacher-report-header-main">
                <div class="teacher-report-window-context">
                    <span class="teacher-report-live-badge">
                        <i class="fa-solid fa-chart-line"></i> Live Analytics
                    </span>
                    <span class="teacher-report-date-pill">
                        <i class="fa-regular fa-calendar-days"></i>
                        <%= filters.fromDate %> &mdash; <%= filters.toDate %>
                    </span>
                    <span class="teacher-report-chip-pill">
                        <i class="fa-solid fa-users-rectangle"></i>
                        <%= selectedClassGroup ? selectedClassGroup.name : "All Classes" %>
                    </span>
                    <span class="teacher-report-chip-pill">
                        <i class="fa-solid fa-book"></i>
                        <%= selectedSubject ? selectedSubject.subjectName : "All Subjects" %>
                    </span>
                    <span class="teacher-report-chip-pill">
                        <i class="fa-solid fa-filter"></i>
                        <%= activeFilterCount %> Filters Active
                    </span>
                </div>

                <div class="teacher-report-quick-exports">
                    <a href="/teacher/reports/export-attendance?<%= exportQuery %>" class="teacher-report-export-pill" title="Export as CSV">
                        <i class="fa-solid fa-file-csv"></i> CSV
                    </a>
                    <a href="/teacher/reports/export-excel?<%= exportQuery %>" class="teacher-report-export-pill excel" title="Export as Excel">
                        <i class="fa-solid fa-file-excel"></i> Excel
                    </a>
                    <a href="/teacher/reports/export-defaulters?threshold=75" class="teacher-report-export-pill warning" style="background: rgba(245, 158, 11, 0.15); border-color: rgba(245, 158, 11, 0.4); color: #f59e0b;" title="Export Defaulters (< 75%) CSV">
                        <i class="fa-solid fa-user-xmark"></i> Defaulters (< 75%)
                    </a>
                    <a href="/teacher/reports/export-suspicious?<%= exportQuery %>" class="teacher-report-export-pill danger" title="Export Suspicious CSV">
                        <i class="fa-solid fa-triangle-exclamation"></i> Security
                    </a>
                    <button type="button" class="teacher-report-export-pill pdf" id="pdfPrintBtn" onclick="prepareAndPrint()" title="Generate PDF">
                        <i class="fa-solid fa-file-pdf"></i> PDF
                    </button>
                </div>
            </div>
        </section>

        <!-- 5-KPI Intelligence Metric Grid -->
        <section class="teacher-report-summary-grid">

            <article class="teacher-report-kpi-tile blue">
                <div class="teacher-kpi-head">
                    <span class="teacher-kpi-label">Total Sessions</span>
                    <div class="teacher-kpi-icon blue">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>
                </div>
                <div class="teacher-kpi-value"><%= summary.totalSessions %></div>
                <div class="teacher-kpi-foot">
                    <span class="teacher-kpi-pill blue"><i class="fa-solid fa-signal"></i> Recorded</span>
                    <span class="teacher-kpi-subtext">Date Window</span>
                </div>
            </article>

            <article class="teacher-report-kpi-tile emerald">
                <div class="teacher-kpi-head">
                    <span class="teacher-kpi-label">Present Marks</span>
                    <div class="teacher-kpi-icon emerald">
                        <i class="fa-solid fa-user-check"></i>
                    </div>
                </div>
                <div class="teacher-kpi-value"><%= summary.totalPresent %></div>
                <div class="teacher-kpi-foot">
                    <span class="teacher-kpi-pill emerald"><i class="fa-solid fa-circle-check"></i> Verified</span>
                    <span class="teacher-kpi-subtext">Attended</span>
                </div>
            </article>

            <article class="teacher-report-kpi-tile rose">
                <div class="teacher-kpi-head">
                    <span class="teacher-kpi-label">Absent Marks</span>
                    <div class="teacher-kpi-icon rose">
                        <i class="fa-solid fa-user-xmark"></i>
                    </div>
                </div>
                <div class="teacher-kpi-value"><%= summary.totalAbsent %></div>
                <div class="teacher-kpi-foot">
                    <span class="teacher-kpi-pill rose"><i class="fa-solid fa-circle-xmark"></i> Missed</span>
                    <span class="teacher-kpi-subtext">Unmarked</span>
                </div>
            </article>

            <article class="teacher-report-kpi-tile purple">
                <div class="teacher-kpi-head">
                    <span class="teacher-kpi-label">Attendance Rate</span>
                    <div class="teacher-kpi-icon purple">
                        <i class="fa-solid fa-chart-pie"></i>
                    </div>
                </div>
                <div class="teacher-kpi-value"><%= summary.attendancePercentage %>%</div>
                <div class="teacher-kpi-foot">
                    <span class="teacher-kpi-pill purple"><i class="fa-solid fa-chart-line"></i> Average</span>
                    <span class="teacher-kpi-subtext">Overall</span>
                </div>
            </article>

            <article class="teacher-report-kpi-tile amber">
                <div class="teacher-kpi-head">
                    <span class="teacher-kpi-label">Security Flags</span>
                    <div class="teacher-kpi-icon amber">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                </div>
                <div class="teacher-kpi-value"><%= summary.suspiciousCount %></div>
                <div class="teacher-kpi-foot">
                    <span class="teacher-kpi-pill amber"><i class="fa-solid fa-triangle-exclamation"></i> Alerts</span>
                    <span class="teacher-kpi-subtext">Geo-Fence</span>
                </div>
            </article>

        </section>

        <!-- Command Filter Deck -->
        <section class="teacher-report-filter-bar-card">
            <div class="teacher-filter-bar-header">
                <div class="teacher-filter-bar-title">
                    <i class="fa-solid fa-sliders"></i>
                    <span>Filter & Query Data</span>
                </div>
                <div class="teacher-filter-presets">
                    <span class="teacher-filter-presets-label">Presets:</span>
                    <button type="button" class="teacher-preset-chip" onclick="setReportDatePreset('today')">Today</button>
                    <button type="button" class="teacher-preset-chip" onclick="setReportDatePreset('week')">7 Days</button>
                    <button type="button" class="teacher-preset-chip" onclick="setReportDatePreset('month')">Month</button>
                    <button type="button" class="teacher-preset-chip" onclick="setReportDatePreset('semester')">Semester</button>
                </div>
            </div>

            <form action="/teacher/reports" method="GET" class="teacher-report-filter-grid">

                <div class="teacher-field">
                    <label>From Date</label>
                    <input type="date" name="fromDate" value="<%= filters.fromDate %>" required>
                </div>

                <div class="teacher-field">
                    <label>To Date</label>
                    <input type="date" name="toDate" value="<%= filters.toDate %>" required>
                </div>

                <div class="teacher-field">
                    <label>Class Group</label>
                    <select name="classGroupId">
                        <option value="all">All Class Groups</option>
                        <% classGroups.forEach(function(group) { %>
                            <option
                                value="<%= group._id %>"
                                <%= filters.classGroupId === group._id.toString() ? "selected" : "" %>
                            >
                                <%= group.name %> - Sem <%= group.semester %> <%= group.section %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="teacher-field">
                    <label>Subject</label>
                    <select name="subjectId">
                        <option value="all">All Subjects</option>
                        <% subjects.forEach(function(subject) { %>
                            <option
                                value="<%= subject._id %>"
                                <%= filters.subjectId === subject._id.toString() ? "selected" : "" %>
                            >
                                <%= subject.subjectName %>
                                <% if (subject.subjectCode) { %>
                                    - <%= subject.subjectCode %>
                                <% } %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="teacher-field">
                    <label>Classroom</label>
                    <select name="classroomId">
                        <option value="all">All Classrooms</option>
                        <% classrooms.forEach(function(classroom) { %>
                            <option
                                value="<%= classroom._id %>"
                                <%= filters.classroomId === classroom._id.toString() ? "selected" : "" %>
                            >
                                <%= classroom.classroomName %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="teacher-field">
                    <label>Status</label>
                    <select name="status">
                        <option value="all" <%= filters.status === "all" ? "selected" : "" %>>All Status</option>
                        <option value="PRESENT" <%= filters.status === "PRESENT" ? "selected" : "" %>>Present Only</option>
                        <option value="ABSENT" <%= filters.status === "ABSENT" ? "selected" : "" %>>Absent Only</option>
                    </select>
                </div>

                <div class="teacher-filter-actions">
                    <button class="teacher-primary-btn" type="submit">
                        <i class="fa-solid fa-filter"></i>
                        Apply
                    </button>

                    <a href="/teacher/reports" class="teacher-secondary-btn" title="Reset all filters">
                        <i class="fa-solid fa-rotate-left"></i>
                        Reset
                    </a>
                </div>

            </form>
        </section>

        <!-- Horizontal Segmented Tab Strip -->
        <nav class="teacher-report-nav-bar" role="tablist" aria-label="Attendance report sections">
            <button type="button" class="teacher-report-nav-link is-active" data-report-tab="subject-summary">
                <i class="fa-solid fa-book-open"></i>
                Subject Summary
                <span class="teacher-tab-count-badge"><%= subjectSummary ? subjectSummary.length : 0 %></span>
            </button>
            <button type="button" class="teacher-report-nav-link" data-report-tab="class-summary">
                <i class="fa-solid fa-users"></i>
                Class Summary
                <span class="teacher-tab-count-badge"><%= classSummary ? classSummary.length : 0 %></span>
            </button>
            <button type="button" class="teacher-report-nav-link" data-report-tab="student-summary">
                <i class="fa-solid fa-user-graduate"></i>
                Student Summary
                <span class="teacher-tab-count-badge"><%= studentSummary ? studentSummary.length : 0 %></span>
            </button>
            <button type="button" class="teacher-report-nav-link" data-report-tab="detailed-records">
                <i class="fa-solid fa-table-list"></i>
                Detailed Records
                <span class="teacher-tab-count-badge"><%= attendanceRecords ? attendanceRecords.length : 0 %></span>
            </button>
            <button type="button" class="teacher-report-nav-link danger" data-report-tab="suspicious-attempts">
                <i class="fa-solid fa-shield-halved"></i>
                Suspicious Attempts
                <span class="teacher-tab-count-badge danger"><%= summary.suspiciousCount || 0 %></span>
            </button>
        </nav>

        <div class="teacher-report-panels-shell" id="teacher-report-panels">
            <section class="teacher-card teacher-report-panel is-active" id="report-subject-summary" data-report-panel="subject-summary">
                <div class="teacher-card-header">
                    <div>
                        <h3>Subject-wise Summary</h3>
                        <p>Attendance grouped by your subjects.</p>
                    </div>

                    <span class="teacher-count-pill">
                        <%= subjectSummary ? subjectSummary.length : 0 %> Subjects
                    </span>
                </div>

                <% if (!subjectSummary || subjectSummary.length === 0) { %>
                    <div class="teacher-empty">No subject report found.</div>
                <% } else { %>
                    <div class="teacher-table-wrap">
                        <table class="teacher-report-table teacher-report-table-compact">
                            <thead>
                                <tr>
                                    <th>Subject</th>
                                    <th>Code</th>
                                    <th>Total</th>
                                    <th>Present</th>
                                    <th>Absent</th>
                                    <th>Attendance Rate</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% subjectSummary.forEach(function(item) { %>
                                    <tr>
                                        <td><strong><%= item.name %></strong></td>
                                        <td><span class="teacher-dept-chip"><%= item.code || "-" %></span></td>
                                        <td><%= item.total %></td>
                                        <td class="teacher-success"><%= item.present %></td>
                                        <td class="teacher-danger"><%= item.absent %></td>
                                        <td>
                                            <div class="teacher-rate-wrap">
                                                <span class="teacher-percent-pill <%= item.percentage >= 75 ? 'good' : 'bad' %>">
                                                    <%= item.percentage %>%
                                                </span>
                                                <div class="teacher-progress-track">
                                                    <div class="teacher-progress-fill <%= item.percentage >= 75 ? 'good' : 'bad' %>" style="width: <%= Math.min(item.percentage, 100) %>%;"></div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </section>

            <section class="teacher-card teacher-report-panel" id="report-class-summary" data-report-panel="class-summary">
                <div class="teacher-card-header">
                    <div>
                        <h3>Class-wise Summary</h3>
                        <p>Attendance grouped by class groups.</p>
                    </div>

                    <span class="teacher-count-pill">
                        <%= classSummary ? classSummary.length : 0 %> Classes
                    </span>
                </div>

                <% if (!classSummary || classSummary.length === 0) { %>
                    <div class="teacher-empty">No class report found.</div>
                <% } else { %>
                    <div class="teacher-table-wrap">
                        <table class="teacher-report-table teacher-report-table-compact">
                            <thead>
                                <tr>
                                    <th>Class Group</th>
                                    <th>Total</th>
                                    <th>Present</th>
                                    <th>Absent</th>
                                    <th>Attendance Rate</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% classSummary.forEach(function(item) { %>
                                    <tr>
                                        <td><strong><%= item.name %></strong></td>
                                        <td><%= item.total %></td>
                                        <td class="teacher-success"><%= item.present %></td>
                                        <td class="teacher-danger"><%= item.absent %></td>
                                        <td>
                                            <div class="teacher-rate-wrap">
                                                <span class="teacher-percent-pill <%= item.percentage >= 75 ? 'good' : 'bad' %>">
                                                    <%= item.percentage %>%
                                                </span>
                                                <div class="teacher-progress-track">
                                                    <div class="teacher-progress-fill <%= item.percentage >= 75 ? 'good' : 'bad' %>" style="width: <%= Math.min(item.percentage, 100) %>%;"></div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </section>

            <section class="teacher-card teacher-report-panel" id="report-student-summary" data-report-panel="student-summary">
                <div class="teacher-card-header">
                    <div>
                        <h3>Student-wise Summary</h3>
                        <p>Attendance grouped by students.</p>
                    </div>

                    <span class="teacher-count-pill">
                        <%= studentSummary ? studentSummary.length : 0 %> Students
                    </span>
                </div>

                <% if (!studentSummary || studentSummary.length === 0) { %>
                    <div class="teacher-empty">No student report found.</div>
                <% } else { %>
                    <div class="teacher-table-wrap">
                        <table class="teacher-report-table teacher-report-table-compact">
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>Enrollment</th>
                                    <th>Total</th>
                                    <th>Present</th>
                                    <th>Absent</th>
                                    <th>Attendance Rate</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% studentSummary.forEach(function(item) { %>
                                    <tr>
                                        <td>
                                            <div class="teacher-student-cell">
                                                <div class="teacher-student-avatar-mini">
                                                    <%= (item.name || "S").charAt(0).toUpperCase() %>
                                                </div>
                                                <div>
                                                    <strong><%= item.name %></strong>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="teacher-dept-chip"><%= item.enrollmentNumber || "-" %></span></td>
                                        <td><%= item.total %></td>
                                        <td class="teacher-success"><%= item.present %></td>
                                        <td class="teacher-danger"><%= item.absent %></td>
                                        <td>
                                            <div class="teacher-rate-wrap">
                                                <span class="teacher-percent-pill <%= item.percentage >= 75 ? 'good' : 'bad' %>">
                                                    <%= item.percentage %>%
                                                </span>
                                                <div class="teacher-progress-track">
                                                    <div class="teacher-progress-fill <%= item.percentage >= 75 ? 'good' : 'bad' %>" style="width: <%= Math.min(item.percentage, 100) %>%;"></div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </section>

            <section class="teacher-card teacher-report-panel" id="report-detailed-records" data-report-panel="detailed-records">
                <div class="teacher-card-header">
                    <div>
                        <h3>Detailed Attendance Records</h3>
                        <p>Grouped by subject and class group for faster analysis.</p>
                    </div>

                    <span class="teacher-count-pill">
                        <%= attendanceRecords.length %> Records
                    </span>
                </div>

                <% if (!attendanceRecords || attendanceRecords.length === 0) { %>
                    <div class="teacher-empty">No attendance records found.</div>
                <% } else { %>
                    <div class="teacher-report-directory-toolbar" data-report-record-directory>
                        <div class="teacher-search-box">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input
                                type="text"
                                data-teacher-record-search
                                placeholder="Search by student, enrollment, method, class or date..."
                            >
                        </div>

                        <div class="teacher-schedule-filter-field">
                            <label for="teacherReportRecordGroupFilter">Group</label>
                            <select id="teacherReportRecordGroupFilter" data-teacher-record-filter="group">
                                <option value="">All Subject Groups</option>

                                <% detailedRecordGroups.forEach(function(group) { %>
                                    <option value="<%= group.filterId %>">
                                        <%= group.subjectName %> · <%= group.className %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="teacher-schedule-filter-field">
                            <label for="teacherReportRecordStatusFilter">Status</label>
                            <select id="teacherReportRecordStatusFilter" data-teacher-record-filter="status">
                                <option value="">All Status</option>
                                <option value="PRESENT">Present</option>
                                <option value="ABSENT">Absent</option>
                            </select>
                        </div>

                        <div class="teacher-schedule-filter-field teacher-schedule-filter-action">
                            <label>&nbsp;</label>
                            <button type="button" class="teacher-secondary-btn" data-teacher-record-reset>
                                <i class="fa-solid fa-rotate-left"></i>
                                Clear
                            </button>
                        </div>

                        <div class="teacher-report-groups">
                            <% detailedRecordGroups.forEach(function(group, groupIndex) { %>
                                <details
                                    class="teacher-report-group-panel"
                                    data-teacher-record-container
                                    data-record-group="<%= group.filterId %>"
                                    <%= groupIndex === 0 ? "open" : "" %>
                                >
                                    <summary class="teacher-report-group-summary">
                                        <div>
                                            <h4><%= group.subjectName %></h4>
                                            <p>
                                                <%= group.className %>
                                                <% if (group.subjectCode) { %>
                                                    · <%= group.subjectCode %>
                                                <% } %>
                                                ·
                                                <span class="teacher-success"><%= group.present %> Present</span>
                                                ·
                                                <span class="teacher-danger"><%= group.absent %> Absent</span>
                                            </p>
                                        </div>
                                        <span class="teacher-count-pill" data-teacher-record-visible-count>
                                            <%= group.records.length %> Records
                                        </span>
                                    </summary>

                                    <div class="teacher-table-wrap">
                                        <table class="teacher-report-table">
                                            <thead>
                                                <tr>
                                                    <th>Date</th>
                                                    <th>Student</th>
                                                    <th>Status</th>
                                                    <th>Method</th>
                                                    <th>Distance</th>
                                                </tr>
                                            </thead>

                                            <tbody>
                                                <% group.records.forEach(function(record) { %>
                                                    <%
                                                        const session = record.attendanceSession;
                                                        const sessionDate = session && session.startTime ? session.startTime : record.createdAt;
                                                    %>
                                                    <tr
                                                        data-teacher-record-item
                                                        data-filter-status="<%= record.status %>"
                                                    >
                                                        <td>
                                                            <%= new Date(sessionDate).toLocaleDateString() %>
                                                            <br>
                                                            <small><%= new Date(sessionDate).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }) %></small>
                                                        </td>

                                                        <td>
                                                            <strong><%= record.student ? record.student.fullName : "Student Missing" %></strong>
                                                            <br>
                                                            <small><%= record.student && record.student.enrollmentNumber ? record.student.enrollmentNumber : "-" %></small>
                                                        </td>

                                                        <td>
                                                            <span class="teacher-status <%= record.status === 'PRESENT' ? 'present' : 'absent' %>">
                                                                <%= record.status %>
                                                            </span>
                                                        </td>

                                                        <td><%= record.verificationMethod || "-" %></td>

                                                        <td>
                                                            <%
                                                                const teacherRecordDeviceInfo = record.deviceInfo || {};
                                                                const teacherHasVerifiedDistance =
                                                                    teacherRecordDeviceInfo.verifiedDistanceFromClassroom !== undefined ||
                                                                    teacherRecordDeviceInfo.minimumPossibleDistance !== undefined;
                                                                const teacherVerifiedDistance =
                                                                    teacherRecordDeviceInfo.verifiedDistanceFromClassroom !== undefined &&
                                                                    teacherRecordDeviceInfo.verifiedDistanceFromClassroom !== null
                                                                        ? teacherRecordDeviceInfo.verifiedDistanceFromClassroom
                                                                        : (
                                                                            teacherRecordDeviceInfo.minimumPossibleDistance !== undefined &&
                                                                            teacherRecordDeviceInfo.minimumPossibleDistance !== null
                                                                                ? teacherRecordDeviceInfo.minimumPossibleDistance
                                                                                : record.distanceFromClassroom
                                                                        );
                                                                const teacherMeasuredDistance =
                                                                    teacherRecordDeviceInfo.measuredDistanceFromClassroom !== undefined &&
                                                                    teacherRecordDeviceInfo.measuredDistanceFromClassroom !== null
                                                                        ? teacherRecordDeviceInfo.measuredDistanceFromClassroom
                                                                        : null;
                                                            %>
                                                            <% if (teacherVerifiedDistance !== undefined && teacherVerifiedDistance !== null) { %>
                                                                <span class="gps-distance-cell">
                                                                    <span class="gps-distance-pill">
                                                                        <%= teacherHasVerifiedDistance ? "Verified" : "Recorded" %>
                                                                        <%= Math.round(teacherVerifiedDistance) %>m
                                                                    </span>

                                                                    <% if (teacherMeasuredDistance !== null && Math.round(teacherMeasuredDistance) !== Math.round(teacherVerifiedDistance)) { %>
                                                                        <small>GPS read <%= Math.round(teacherMeasuredDistance) %>m</small>
                                                                    <% } %>
                                                                </span>
                                                            <% } else { %>
                                                                -
                                                            <% } %>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                </details>
                            <% }) %>
                        </div>

                        <div class="teacher-empty hidden-by-filter" data-teacher-record-empty>
                            No detailed attendance records match your current search and filters.
                        </div>
                    </div>
                <% } %>
            </section>

            <section class="teacher-card teacher-report-panel" id="report-suspicious-attempts" data-report-panel="suspicious-attempts">
                <div class="teacher-card-header">
                    <div>
                        <h3>Suspicious Attempts</h3>
                        <p>Grouped by reason code for quick incident review.</p>
                    </div>

                    <span class="teacher-count-pill danger">
                        <%= suspiciousAttempts.length %> Attempts
                    </span>
                </div>

                <% if (!suspiciousAttempts || suspiciousAttempts.length === 0) { %>
                    <div class="teacher-empty">No suspicious attempts found.</div>
                <% } else { %>
                    <div class="teacher-report-directory-toolbar compact" data-report-attempt-directory>
                        <div class="teacher-search-box">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input
                                type="text"
                                data-teacher-attempt-search
                                placeholder="Search by student, enrollment, reason message, class or date..."
                            >
                        </div>

                        <div class="teacher-schedule-filter-field">
                            <label for="teacherReportAttemptReasonFilter">Reason</label>
                            <select id="teacherReportAttemptReasonFilter" data-teacher-attempt-filter="reason">
                                <option value="">All Reasons</option>

                                <% suspiciousAttemptGroups.forEach(function(group) { %>
                                    <option value="<%= group.filterId %>">
                                        <%= group.reasonCode %> (<%= group.attempts.length %>)
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="teacher-schedule-filter-field teacher-schedule-filter-action">
                            <label>&nbsp;</label>
                            <button type="button" class="teacher-secondary-btn" data-teacher-attempt-reset>
                                <i class="fa-solid fa-rotate-left"></i>
                                Clear
                            </button>
                        </div>

                        <div class="teacher-report-groups">
                            <% suspiciousAttemptGroups.forEach(function(group, groupIndex) { %>
                                <details
                                    class="teacher-report-group-panel danger"
                                    data-teacher-attempt-container
                                    data-attempt-reason="<%= group.filterId %>"
                                    <%= groupIndex === 0 ? "open" : "" %>
                                >
                                    <summary class="teacher-report-group-summary">
                                        <div>
                                            <h4><%= group.reasonCode %></h4>
                                            <p><%= group.reasonMessage %></p>
                                        </div>
                                        <span class="teacher-count-pill danger" data-teacher-attempt-visible-count>
                                            <%= group.attempts.length %> Attempts
                                        </span>
                                    </summary>

                                    <div class="teacher-table-wrap">
                                        <table class="teacher-report-table">
                                            <thead>
                                                <tr>
                                                    <th>Date</th>
                                                    <th>Student</th>
                                                    <th>Reason Detail</th>
                                                    <th>Distance</th>
                                                    <th>Radius</th>
                                                    <th>Accuracy</th>
                                                </tr>
                                            </thead>

                                            <tbody>
                                                <% group.attempts.forEach(function(attempt) { %>
                                                    <tr data-teacher-attempt-item>
                                                        <td>
                                                            <%= new Date(attempt.createdAt).toLocaleDateString() %>
                                                            <br>
                                                            <small><%= new Date(attempt.createdAt).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }) %></small>
                                                        </td>

                                                        <td>
                                                            <strong><%= attempt.studentName %></strong>
                                                            <br>
                                                            <small><%= attempt.enrollmentNumber %></small>
                                                        </td>

                                                        <td>
                                                            <strong><%= attempt.reasonCode %></strong>
                                                            <br>
                                                            <small><%= attempt.reasonMessage %></small>
                                                        </td>

                                                        <td><%= Math.round(attempt.distanceFromTeacher || 0) %>m</td>
                                                        <td><%= Math.round(attempt.allowedRadius || 0) %>m</td>
                                                        <td><%= Math.round(attempt.gpsAccuracy || 0) %>m</td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                </details>
                            <% }) %>
                        </div>

                        <div class="teacher-empty hidden-by-filter" data-teacher-attempt-empty>
                            No suspicious attempts match your current search and filters.
                        </div>
                    </div>
                <% } %>
            </section>
        </div>

    </main>

</div>

<script src="/js/teacherNav.js"></script>
<script src="/js/teacherPanels.js"></script>
<script src="/js/uiShell.js"></script>

    <script src="/js/csrfAuto.js" defer></script>
    <script src="/js/selectEnhancer.js" defer></script>
    
    <!-- PDF Generation Libraries -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <script>
        async function prepareAndPrint() {
            // Open all expandable details so tables are visible in print
            const panels = document.querySelectorAll('.teacher-report-group-panel');
            panels.forEach(function(panel) {
                panel.open = true;
            });

            const btn = document.getElementById('pdfPrintBtn');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Generating PDF...';
            btn.disabled = true;

            // Wait for panels to expand
            setTimeout(async function() {
                try {
                    const contentArea = document.querySelector('.teacher-panels-container');
                    
                    // Temporarily hide filter cards and action buttons for cleaner PDF
                    const filterCard = document.querySelector('.teacher-report-filter-card');
                    const headerActions = document.querySelector('.teacher-report-actions');
                    
                    if (filterCard) filterCard.style.display = 'none';
                    if (headerActions) headerActions.style.display = 'none';
                    
                    // Adjust padding for PDF
                    const originalPadding = contentArea.style.padding;
                    contentArea.style.padding = '20px';
                    contentArea.style.backgroundColor = '#ffffff';

                    const canvas = await html2canvas(contentArea, {
                        scale: 2, // Higher quality
                        useCORS: true,
                        logging: false,
                        windowWidth: 1200 // Force desktop width
                    });

                    // Restore UI
                    if (filterCard) filterCard.style.display = '';
                    if (headerActions) headerActions.style.display = '';
                    contentArea.style.padding = originalPadding;
                    contentArea.style.backgroundColor = '';

                    const imgData = canvas.toDataURL('image/jpeg', 0.95);
                    const pdf = new jspdf.jsPDF({
                        orientation: 'portrait',
                        unit: 'px',
                        format: [canvas.width, canvas.height]
                    });

                    pdf.addImage(imgData, 'JPEG', 0, 0, canvas.width, canvas.height);
                    pdf.save('Attendify-Report.pdf');

                } catch (err) {
                    console.error("PDF Generation Error:", err);
                    alert("Failed to generate PDF. Falling back to basic print.");
                    window.print();
                } finally {
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            }, 300);
        }

        function setReportDatePreset(preset) {
            const fromInput = document.querySelector("input[name='fromDate']");
            const toInput = document.querySelector("input[name='toDate']");
            if (!fromInput || !toInput) return;

            const now = new Date();
            const toDateStr = now.toISOString().slice(0, 10);
            let fromDateStr = toDateStr;

            if (preset === 'week') {
                const weekAgo = new Date();
                weekAgo.setDate(now.getDate() - 7);
                fromDateStr = weekAgo.toISOString().slice(0, 10);
            } else if (preset === 'month') {
                const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);
                fromDateStr = monthStart.toISOString().slice(0, 10);
            } else if (preset === 'semester') {
                const semesterStart = new Date(now.getFullYear(), now.getMonth() >= 6 ? 6 : 0, 1);
                fromDateStr = semesterStart.toISOString().slice(0, 10);
            }

            if (fromInput._flatpickr) {
                fromInput._flatpickr.setDate(fromDateStr, true);
            } else {
                fromInput.value = fromDateStr;
            }

            if (toInput._flatpickr) {
                toInput._flatpickr.setDate(toDateStr, true);
            } else {
                toInput.value = toDateStr;
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            if (window.flatpickr) {
                flatpickr("input[name='fromDate'], input[name='toDate']", {
                    dateFormat: "Y-m-d",
                    disableMobile: true,
                    position: "auto center"
                });
            }
        });
    </script>
</body>
</html>
