                                                    <%= item.percentage %>%
                                                </span>
                                                <div class="teacher-progress-track">
                                                    <div class="teacher-progress-fill <%= item.percentage >= 75 ? 'good' : 'bad' %>" style="width: <%= Math.min(item.percentage, 100) %>%;"></div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </section>

            <section class="teacher-card teacher-report-panel" id="report-student-summary" data-report-panel="student-summary">
                <div class="teacher-card-header">
                    <div>
                        <h3>Student-wise Summary</h3>
                        <p>Attendance grouped by students.</p>
                    </div>

                    <span class="teacher-count-pill">
                        <%= studentSummary ? studentSummary.length : 0 %> Students
                    </span>
                </div>

                <% if (!studentSummary || studentSummary.length === 0) { %>
                    <div class="teacher-empty">No student report found.</div>
                <% } else { %>
                    <div class="teacher-table-wrap">
                        <table class="teacher-report-table teacher-report-table-compact">
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>Enrollment</th>
                                    <th>Total</th>
                                    <th>Present</th>
                                    <th>Absent</th>
                                    <th>Attendance Rate</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% studentSummary.forEach(function(item) { %>
                                    <tr>
                                        <td>
                                            <div class="teacher-student-cell">
                                                <div class="teacher-student-avatar-mini">
                                                    <%= (item.name || "S").charAt(0).toUpperCase() %>
                                                </div>
                                                <div>
                                                    <strong><%= item.name %></strong>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="teacher-dept-chip"><%= item.enrollmentNumber || "-" %></span></td>
                                        <td><%= item.total %></td>
                                        <td class="teacher-success"><%= item.present %></td>
                                        <td class="teacher-danger"><%= item.absent %></td>
                                        <td>
                                            <div class="teacher-rate-wrap">
                                                <span class="teacher-percent-pill <%= item.percentage >= 75 ? 'good' : 'bad' %>">
                                                    <%= item.percentage %>%
                                                </span>
                                                <div class="teacher-progress-track">
                                                    <div class="teacher-progress-fill <%= item.percentage >= 75 ? 'good' : 'bad' %>" style="width: <%= Math.min(item.percentage, 100) %>%;"></div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </section>

            <section class="teacher-card teacher-report-panel" id="report-detailed-records" data-report-panel="detailed-records">
                <div class="teacher-card-header">
                    <div>
                        <h3>Detailed Attendance Records</h3>
                        <p>Grouped by subject and class group for faster analysis.</p>
                    </div>

                    <span class="teacher-count-pill">
                        <%= attendanceRecords.length %> <%= attendanceRecords.length === 1 ? "Record" : "Records" %>
                    </span>
                </div>

                <% if (!attendanceRecords || attendanceRecords.length === 0) { %>
                    <div class="teacher-empty-state-box">
                        <div class="teacher-empty-state-icon">
                            <i class="fa-solid fa-folder-open"></i>
                        </div>
                        <h4>No Attendance Records Found</h4>
                        <p>There are no attendance records in this date window.</p>
                    </div>
                <% } else { %>
                    <div class="teacher-report-directory-toolbar" data-report-record-directory>
                        <div class="teacher-search-box">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input
                                type="text"
                                data-teacher-record-search
                                placeholder="Search by student, enrollment, method, class or date..."
                            >
                        </div>

                        <div class="teacher-schedule-filter-field">
                            <div class="teacher-select-wrap">
                                <i class="fa-solid fa-layer-group teacher-select-leading-icon"></i>
                                <select id="teacherReportRecordGroupFilter" class="no-enhance" data-teacher-record-filter="group">
                                    <option value="">All Subject Groups</option>

                                    <% detailedRecordGroups.forEach(function(group) { %>
                                        <option value="<%= group.filterId %>">
                                            <%= group.subjectName %> · <%= group.className %>
                                        </option>
                                    <% }) %>
                                </select>
                                <i class="fa-solid fa-chevron-down teacher-select-chevron"></i>
                            </div>
                        </div>

                        <div class="teacher-schedule-filter-field">
                            <div class="teacher-select-wrap">
                                <i class="fa-solid fa-filter teacher-select-leading-icon"></i>
                                <select id="teacherReportRecordStatusFilter" class="no-enhance" data-teacher-record-filter="status">
                                    <option value="">All Status</option>
                                    <option value="PRESENT">Present</option>
                                    <option value="ABSENT">Absent</option>
                                </select>
                                <i class="fa-solid fa-chevron-down teacher-select-chevron"></i>
                            </div>
                        </div>

                        <button type="button" class="teacher-toolbar-reset-btn" data-teacher-record-reset title="Clear search & filters">
                            <i class="fa-solid fa-rotate-left"></i>
                            <span>Clear</span>
                        </button>
                    </div>

                        <div class="teacher-report-groups">
                            <% detailedRecordGroups.forEach(function(group, groupIndex) { %>
                                <details
                                    class="teacher-report-group-panel"
                                    data-teacher-record-container
                                    data-record-group="<%= group.filterId %>"
                                    <%= groupIndex === 0 ? "open" : "" %>
                                >
                                    <summary class="teacher-report-group-summary">
                                        <div class="teacher-group-info">
                                            <div class="teacher-group-avatar">
                                                <i class="fa-solid fa-book-open"></i>
                                            </div>
                                            <div>
                                                <div class="teacher-group-title-row">
                                                    <h4><%= group.subjectName %></h4>
                                                </div>
                                                <div class="teacher-group-meta-chips">
                                                    <span class="teacher-meta-chip class">
                                                        <i class="fa-solid fa-users"></i>
                                                        <%= group.className %>
                                                    </span>
                                                    <% if (group.subjectCode) { %>
                                                        <span class="teacher-meta-chip code">
                                                            <i class="fa-solid fa-hashtag"></i>
                                                            <%= group.subjectCode %>
                                                        </span>
                                                    <% } %>
                                                    <span class="teacher-meta-chip present">
                                                        <i class="fa-solid fa-circle-check"></i>
                                                        <%= group.present %> Present
                                                    </span>
                                                    <span class="teacher-meta-chip absent">
                                                        <i class="fa-solid fa-circle-xmark"></i>
                                                        <%= group.absent %> Absent
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="teacher-group-trailing">
                                            <span class="teacher-count-pill" data-teacher-record-visible-count>
                                                <%= group.records.length %> <%= group.records.length === 1 ? "Record" : "Records" %>
                                            </span>
                                            <div class="teacher-chevron-wrap">
                                                <i class="fa-solid fa-chevron-down teacher-group-chevron"></i>
                                            </div>
                                        </div>
                                    </summary>

                                    <div class="teacher-table-wrap">
                                        <table class="teacher-report-table">
                                            <thead>
                                                <tr>
                                                    <th>Date &amp; Time</th>
                                                    <th>Student</th>
                                                    <th>Status</th>
                                                    <th>Method</th>
                                                    <th>Distance</th>
                                                </tr>
                                            </thead>

                                            <tbody>
                                                <% group.records.forEach(function(record) { %>
                                                    <%
                                                        const session = record.attendanceSession;
                                                        const sessionDate = session && session.startTime ? session.startTime : record.createdAt;
                                                    %>
                                                    <tr
                                                        data-teacher-record-item
                                                        data-filter-status="<%= record.status %>"
                                                    >
                                                        <td>
                                                            <div class="teacher-date-cell">
                                                                <span class="teacher-date-primary">
                                                                    <i class="fa-regular fa-calendar"></i>
                                                                    <%= new Date(sessionDate).toLocaleDateString() %>
                                                                </span>
                                                                <span class="teacher-date-secondary">
                                                                    <i class="fa-regular fa-clock"></i>
                                                                    <%= new Date(sessionDate).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }) %>
                                                                </span>
                                                            </div>
                                                        </td>

                                                        <td>
                                                            <div class="teacher-student-cell">
                                                                <div class="teacher-student-avatar-mini">
                                                                    <%= (record.student && record.student.fullName ? record.student.fullName.charAt(0) : "S").toUpperCase() %>
                                                                </div>
                                                                <div class="teacher-student-info">
                                                                    <strong class="teacher-student-name"><%= record.student ? record.student.fullName : "Student Missing" %></strong>
                                                                    <span class="teacher-dept-chip"><%= record.student && record.student.enrollmentNumber ? record.student.enrollmentNumber : "-" %></span>
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <td>
                                                            <span class="teacher-status-pill <%= record.status === 'PRESENT' ? 'present' : (record.status === 'LATE' ? 'late' : (record.status === 'EXCUSED' ? 'excused' : 'absent')) %>">
                                                                <i class="fa-solid <%= record.status === 'PRESENT' ? 'fa-circle-check' : (record.status === 'LATE' ? 'fa-clock' : (record.status === 'EXCUSED' ? 'fa-shield-halved' : 'fa-circle-xmark')) %>"></i>
                                                                <%= record.status === 'PRESENT' ? 'Present' : (record.status === 'LATE' ? 'Late' : (record.status === 'EXCUSED' ? 'Excused' : 'Absent')) %>
                                                            </span>
                                                        </td>

                                                        <td>
                                                            <%
                                                                let rawMethod = (record.verificationMethod || "AUTO_GPS").toUpperCase();
                                                                let methodLabel = "Auto GPS";
                                                                let methodIcon = "fa-location-dot";
                                                                let methodClass = "gps";
                                                                if (rawMethod.includes("WEAK")) {
                                                                    methodLabel = "Weak GPS";
                                                                    methodIcon = "fa-satellite-dish";
                                                                    methodClass = "warn";
                                                                } else if (rawMethod.includes("MANUAL") || rawMethod.includes("TEACHER")) {
                                                                    methodLabel = "Manual";
                                                                    methodIcon = "fa-user-pen";
                                                                    methodClass = "manual";
                                                                } else if (rawMethod.includes("QR")) {
                                                                    methodLabel = "QR Code";
                                                                    methodIcon = "fa-qrcode";
                                                                    methodClass = "qr";
                                                                } else if (rawMethod.includes("ACOUSTIC") || rawMethod.includes("ULTRASONIC")) {
                                                                    methodLabel = "Ultrasonic";
                                                                    methodIcon = "fa-tower-broadcast";
                                                                    methodClass = "acoustic";
                                                                } else if (rawMethod.includes("AUTO_GPS") || rawMethod.includes("GPS")) {
                                                                    methodLabel = "Auto GPS";
                                                                    methodIcon = "fa-location-crosshairs";
                                                                    methodClass = "gps";
                                                                } else {
                                                                    methodLabel = rawMethod.replace(/_/g, " ");
                                                                    methodIcon = "fa-circle-dot";
                                                                    methodClass = "default";
                                                                }
                                                            %>
                                                            <span class="teacher-method-pill <%= methodClass %>">
                                                                <i class="fa-solid <%= methodIcon %>"></i>
                                                                <%= methodLabel %>
                                                            </span>
                                                        </td>

                                                        <td>
                                                            <%
                                                                const teacherRecordDeviceInfo = record.deviceInfo || {};
                                                                const teacherHasVerifiedDistance =
                                                                    teacherRecordDeviceInfo.verifiedDistanceFromClassroom !== undefined ||
                                                                    teacherRecordDeviceInfo.minimumPossibleDistance !== undefined;
                                                                const teacherVerifiedDistance =
                                                                    teacherRecordDeviceInfo.verifiedDistanceFromClassroom !== undefined &&
                                                                    teacherRecordDeviceInfo.verifiedDistanceFromClassroom !== null
                                                                        ? teacherRecordDeviceInfo.verifiedDistanceFromClassroom
                                                                        : (
                                                                            teacherRecordDeviceInfo.minimumPossibleDistance !== undefined &&
                                                                            teacherRecordDeviceInfo.minimumPossibleDistance !== null
                                                                                ? teacherRecordDeviceInfo.minimumPossibleDistance
                                                                                : record.distanceFromClassroom
                                                                        );
                                                                const teacherMeasuredDistance =
                                                                    teacherRecordDeviceInfo.measuredDistanceFromClassroom !== undefined &&
                                                                    teacherRecordDeviceInfo.measuredDistanceFromClassroom !== null
                                                                        ? teacherRecordDeviceInfo.measuredDistanceFromClassroom
                                                                        : null;
                                                            %>
                                                            <% if (teacherVerifiedDistance !== undefined && teacherVerifiedDistance !== null) { %>
                                                                <div class="teacher-distance-cell">
                                                                    <span class="gps-distance-pill <%= teacherHasVerifiedDistance ? 'verified' : '' %>">
                                                                        <i class="fa-solid fa-location-dot"></i>
                                                                        <%= teacherHasVerifiedDistance ? "Verified" : "Recorded" %>
                                                                        <%= Math.round(teacherVerifiedDistance) %>m
                                                                    </span>

                                                                    <% if (teacherMeasuredDistance !== null && Math.round(teacherMeasuredDistance) !== Math.round(teacherVerifiedDistance)) { %>
                                                                        <small class="teacher-distance-raw">GPS read <%= Math.round(teacherMeasuredDistance) %>m</small>
                                                                    <% } %>
                                                                </div>
                                                            <% } else { %>
                                                                <span class="teacher-text-muted">-</span>
                                                            <% } %>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                </details>
                            <% }) %>
                        </div>

                        <div class="teacher-empty-state-box hidden-by-filter" data-teacher-record-empty>
                            <div class="teacher-empty-state-icon">
                                <i class="fa-solid fa-magnifying-glass-chart"></i>
                            </div>
                            <h4>No Matching Attendance Records</h4>
                            <p>No records match your search or filter criteria. Try clearing filters or searching for another student or date.</p>
                            <button type="button" class="teacher-empty-reset-btn" onclick="document.querySelector('[data-teacher-record-reset]').click()">
                                <i class="fa-solid fa-rotate-left"></i>
                                Reset Filters
                            </button>
                        </div>
                    </div>
                <% } %>
            </section>

            <section class="teacher-card teacher-report-panel" id="report-suspicious-attempts" data-report-panel="suspicious-attempts">
                <div class="teacher-card-header">
                    <div>
                        <h3>Suspicious Attempts</h3>
