<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attendify | Next-Gen Biometric & Geofenced Smart Attendance</title>

    <!-- Preconnect to external CDNs -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://fonts.gstatic.com">

    <link rel="stylesheet" href="/css/uiShell.css?v=20260901_fixed3">
    <link rel="stylesheet" href="/css/home.css?v=20260901_crazy">
    <link rel="stylesheet" href="/css/attendifyDarkFix.css?v=8">
    <link rel="stylesheet" href="/css/attendifyUIOverhaul.css?v=2">
    <link rel="stylesheet" href="/css/attendifyUIOverhaulExtra.css?v=19">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >
    <link rel="icon" type="image/png" href="/favicon.png">

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#090d16">
    <link rel="apple-touch-icon" href="/icon-192.png">

    <% if (typeof csrfToken !== "undefined") { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
    <% if (typeof realtimeMode !== "undefined") { %>
    <script>
    window.AttendifyRealtimeConfig = {
        mode: <%- JSON.stringify(realtimeMode) %>,
        pollIntervalMs: <%= typeof realtimePollIntervalMs !== "undefined" ? realtimePollIntervalMs : 5000 %>
    };
    </script>
    <% } %>
</head>
<body class="dark-tech-body">

<div class="home-page-crazy">

    <!-- Cyber Background Matrix Grid & Ambient Glows -->
    <div class="cyber-grid-overlay"></div>
    <div class="crazy-glow-orb orb-purple"></div>
    <div class="crazy-glow-orb orb-cyan"></div>
    <div class="crazy-glow-orb orb-emerald"></div>

    <!-- Navigation Header -->
    <header class="crazy-navbar">
        <a href="/" class="crazy-brand">
            <span class="brand-hexagon">
                <i class="fa-solid fa-clipboard-check"></i>
            </span>
            <span class="brand-title">ATTENDIFY</span>
            <span class="brand-ai-tag"><i class="fa-solid fa-bolt"></i> FIDO2</span>
        </a>

        <button
            class="crazy-menu-btn"
            id="homeMenuBtn"
            type="button"
            aria-label="Toggle navigation menu"
            aria-controls="homeNavLinks"
            aria-expanded="false"
        >
            <i class="fa-solid fa-bars"></i>
        </button>

        <nav class="crazy-nav-links" id="homeNavLinks">
            <a href="#features" class="c-nav-item"><i class="fa-solid fa-microchip"></i> Features</a>
            <a href="#how-it-works" class="c-nav-item"><i class="fa-solid fa-network-wired"></i> Architecture</a>
            <a href="/college/register" class="c-nav-item"><i class="fa-solid fa-building-columns"></i> Register College</a>
            <a href="/admin/login" class="c-nav-item"><i class="fa-solid fa-user-shield"></i> Admin</a>
            <a href="/teacher/login" class="c-nav-item"><i class="fa-solid fa-chalkboard-user"></i> Teacher</a>
            <a href="/student/register" class="c-nav-item"><i class="fa-solid fa-user-plus"></i> Student Sign-Up</a>
            <a href="/student/login" class="crazy-cta-btn">
                <i class="fa-solid fa-fingerprint"></i> Student Login
            </a>
        </nav>
    </header>
    <div class="home-nav-overlay" id="homeNavOverlay"></div>

    <main>

        <!-- HERO SECTION -->
        <section class="crazy-hero-section">

            <!-- LEFT: PUNCHY COPY & CALL TO ACTIONS -->
            <div class="crazy-hero-left">

                <div class="live-security-badge animate-fade-up">
                    <span class="radar-ping-dot"></span>
                    <i class="fa-solid fa-shield-halved"></i>
                    <span>ZERO-PROXY BIOMETRIC ATTENDANCE</span>
                </div>

                <h1 class="crazy-hero-title animate-fade-up delay-100">
                    Next-Gen Attendance Powered by <span class="neon-indigo">Hardware Passkeys</span> & <span class="neon-cyan">Geofence Radar</span>.
                </h1>

                <p class="crazy-hero-subtitle animate-fade-up delay-200">
                    Cryptographically verify student identity and physical classroom presence. Zero passwords, zero buddy punching, and zero proxy attendance.
                </p>

                <div class="crazy-hero-actions animate-fade-up delay-300">
                    <a href="/college/register" class="crazy-btn-primary">
                        <i class="fa-solid fa-building-columns"></i>
                        <span>Register Institution</span>
                        <i class="fa-solid fa-arrow-right arrow-shift"></i>
                    </a>

                    <a href="/student/login" class="crazy-btn-secondary">
                        <i class="fa-solid fa-fingerprint text-cyan"></i>
                        <span>Student Passkey Login</span>
                    </a>
                </div>

                <!-- Telemetry mini-strip -->
                <div class="crazy-trust-grid animate-fade-up delay-400">
                    <div class="trust-cell">
                        <i class="fa-solid fa-lock text-indigo"></i>
                        <div>
                            <strong>FIDO2 / WebAuthn</strong>
                            <span>Secure Enclave Bound</span>
                        </div>
                    </div>

                    <div class="trust-cell">
                        <i class="fa-solid fa-satellite text-cyan"></i>
                        <div>
                            <strong>Haversine Geofence</strong>
                            <span>Sub-Meter GPS Precision</span>
                        </div>
                    </div>

                    <div class="trust-cell">
                        <i class="fa-solid fa-bolt text-emerald"></i>
                        <div>
                            <strong>Live WebSockets</strong>
                            <span>Sub-Second Telemetry</span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- RIGHT: INTERACTIVE TACTICAL CYBER TERMINAL -->
            <div class="crazy-hero-right animate-fade-up delay-200">

                <div class="cyber-terminal-card">

                    <!-- Terminal Top Header -->
                    <div class="terminal-header">
                        <div class="terminal-dots">
                            <span class="t-dot red"></span>
                            <span class="t-dot yellow"></span>
                            <span class="t-dot green"></span>
                        </div>

                        <!-- Interactive Tab Switches -->
                        <div class="terminal-nav-tabs">
                            <button class="t-tab-btn active" data-terminal-tab="radar" type="button">
                                <i class="fa-solid fa-satellite-dish"></i> Live Tactical Radar
                            </button>
                            <button class="t-tab-btn" data-terminal-tab="biometrics" type="button">
                                <i class="fa-solid fa-fingerprint"></i> Biometric Scan
                            </button>
                            <button class="t-tab-btn" data-terminal-tab="telemetry" type="button">
                                <i class="fa-solid fa-chart-line"></i> Live Feed
                            </button>
                        </div>

                        <div class="terminal-signal-pill">
                            <span class="signal-beacon"></span> 18ms WebSocket
                        </div>
                    </div>

                    <!-- TAB 1: LIVE TACTICAL RADAR INTERACTION -->
                    <div class="terminal-screen active" id="terminalScreen-radar">

                        <div class="radar-top-meta">
                            <div>
                                <span class="radar-session-tag"><i class="fa-solid fa-circle-dot text-emerald"></i> SESSION ACTIVE</span>
                                <h3 class="radar-session-name">Data Structures (CS401) • Lab 101</h3>
                            </div>
                            <div class="radar-radius-pill">
                                <i class="fa-solid fa-location-crosshairs text-cyan"></i> 100m Geofence
                            </div>
                        </div>

                        <!-- Real Tactical Radar HUD Canvas -->
                        <div class="tactical-hud-container">
                            <div class="hud-sweep-beam"></div>
                            
                            <!-- Concentric Sonar Rings -->
                            <div class="hud-ring r1"></div>
                            <div class="hud-ring r2"></div>
                            <div class="hud-ring r3"></div>
                            <div class="hud-crosshair-x"></div>
                            <div class="hud-crosshair-y"></div>

                            <!-- Faculty GPS Anchor -->
                            <div class="hud-anchor faculty" title="Faculty GPS Anchor (Lab 101)">
                                <div class="anchor-pulse"></div>
                                <div class="anchor-core"><i class="fa-solid fa-chalkboard-user"></i></div>
                                <span class="anchor-name">Faculty Anchor</span>
                            </div>

                            <!-- Live Verified Student Blips -->
                            <div class="hud-blip b1" title="Aarav K. (AIML 4A) • 8.2m inside">
                                <div class="blip-ping-ring"></div>
                                <div class="blip-core"></div>
                                <span class="blip-label">Aarav K. (8m)</span>
                            </div>

                            <div class="hud-blip b2" title="Ananya S. (AIML 4A) • 14.1m inside">
                                <div class="blip-ping-ring"></div>
                                <div class="blip-core"></div>
                                <span class="blip-label">Ananya (14m)</span>
                            </div>

                            <div class="hud-blip b3" title="Harsh K. (AIML 4A) • 2.4m inside">
                                <div class="blip-ping-ring"></div>
                                <div class="blip-core"></div>
                                <span class="blip-label">Harsh (2m)</span>
                            </div>

                            <div class="hud-blip b4" title="Rahul M. (AIML 4A) • 19.5m inside">
                                <div class="blip-ping-ring"></div>
                                <div class="blip-core"></div>
                                <span class="blip-label">Rahul (19m)</span>
                            </div>

                            <div class="hud-blip b5 dynamic-student" id="dynamicStudentBlip" style="display: none;">
                                <div class="blip-ping-ring cyan"></div>
                                <div class="blip-core cyan"></div>
                                <span class="blip-label cyan">You (5m) Verified ✓</span>
                            </div>
                        </div>

                        <!-- Live Interactive Bar & Action -->
                        <div class="radar-telemetry-tray">
                            <div class="tray-row">
                                <div>
                                    <span class="tray-label">VERIFIED ATTENDANCE</span>
                                    <strong class="tray-val" id="radarCountVal">44 / 50 Present (88%)</strong>
                                </div>

                                <button class="simulate-checkin-btn" id="simulateCheckinBtn" type="button">
                                    <i class="fa-solid fa-location-arrow"></i> Test My Check-in
                                </button>
                            </div>

                            <div class="tray-progress-shell">
                                <div class="tray-progress-fill" id="radarProgressBar" style="width: 88%;"></div>
                            </div>
                        </div>

                    </div>

                    <!-- TAB 2: BIOMETRIC ENCLAVE SCANNER -->
                    <div class="terminal-screen" id="terminalScreen-biometrics">

                        <div class="biometric-hud-stage">
                            
                            <!-- Scanner Device Core -->
                            <div class="biometric-scanner-device" id="interactiveScanDevice">
                                <div class="laser-scanner-line" id="laserScannerLine"></div>
                                <div class="fp-glow-core">
                                    <i class="fa-solid fa-fingerprint main-fp-icon"></i>
                                </div>
                                <span class="scanner-instruction" id="scanPromptText">Touch / Click Scanner to Authenticate</span>
                            </div>

                            <!-- Live Cryptographic Telemetry Stream -->
                            <div class="crypto-feed-log" id="cryptoFeedLog">
                                <div class="feed-line"><span class="t-cyan">[WEBAUTHN]</span> Requesting 32-byte cryptographic challenge from server...</div>
                                <div class="feed-line"><span class="t-emerald">[ENCLAVE]</span> Apple Secure Enclave / Android TEE keypair loaded</div>
                                <div class="feed-line"><span class="t-purple">[STATUS]</span> Ready for physical biometric assertion</div>
                            </div>

                        </div>

                        <div class="enclave-specs-strip">
                            <div class="spec-tile">
                                <span>SIGNATURE</span>
                                <strong>ECDSA P-256</strong>
                            </div>
                            <div class="spec-tile">
                                <span>PROXY CHANCE</span>
                                <strong class="text-emerald">0.00% (Locked)</strong>
                            </div>
                            <div class="spec-tile">
                                <span>STORAGE</span>
                                <strong>Hardware HSM</strong>
                            </div>
                        </div>

                    </div>

                    <!-- TAB 3: LIVE TELEMETRY LOGS -->
                    <div class="terminal-screen" id="terminalScreen-telemetry">

                        <div class="telemetry-live-stream">
                            <div class="stream-header">
                                <i class="fa-solid fa-terminal text-cyan"></i> Real-Time Cryptographic Verification Stream
                            </div>

                            <div class="stream-logs-box" id="streamLogsBox">
                                <div class="log-entry"><span class="time">04:30:12</span> <span class="tag verified">[PRESENT]</span> Harsh K. (AIML-3C5CF1) • GPS drift: 2.1m (±4m) • FIDO2 Passkey ✓</div>
                                <div class="log-entry"><span class="time">04:30:18</span> <span class="tag verified">[PRESENT]</span> Aarav K. (AIML-1351EA) • GPS drift: 7.8m (±5m) • FIDO2 Passkey ✓</div>
                                <div class="log-entry"><span class="time">04:30:24</span> <span class="tag verified">[PRESENT]</span> Ananya S. (AIML-2281FB) • GPS drift: 13.9m (±6m) • FIDO2 Passkey ✓</div>
                                <div class="log-entry"><span class="time">04:30:31</span> <span class="tag verified">[PRESENT]</span> Rahul M. (AIML-8821CD) • GPS drift: 18.2m (±8m) • FIDO2 Passkey ✓</div>
                                <div class="log-entry warning"><span class="time">04:30:39</span> <span class="tag blocked">[REJECTED]</span> Unknown Device (Hostel Block) • Distance: 480m • Outside 100m Radius ❌</div>
                            </div>
                        </div>

                    </div>

                    <!-- Terminal Bottom Footer -->
                    <div class="terminal-footer-strip">
                        <div class="footer-telemetry-item">
                            <i class="fa-solid fa-server text-indigo"></i> Multi-Tenant MongoDB Atlas
                        </div>
                        <div class="footer-telemetry-item">
                            <i class="fa-solid fa-shield-check text-emerald"></i> 100% Anti-Proxy Verified
                        </div>
                    </div>

                </div>

            </div>

        </section>

        <!-- LIVE TELEMETRY STATS BANNER -->
        <section class="crazy-metrics-banner scroll-animate">
            <div class="metrics-grid-crazy">
                <div class="metric-glass-card">
                    <div class="m-icon-box indigo"><i class="fa-solid fa-fingerprint"></i></div>
                    <div class="m-info">
                        <strong>100%</strong>
                        <span>Zero-Proxy Hardware Security</span>
                    </div>
                </div>

                <div class="metric-glass-card">
                    <div class="m-icon-box cyan"><i class="fa-solid fa-satellite-dish"></i></div>
                    <div class="m-info">
                        <strong>&lt; 100m</strong>
                        <span>Sub-Meter Classroom Geofencing</span>
                    </div>
                </div>

                <div class="metric-glass-card">
                    <div class="m-icon-box emerald"><i class="fa-solid fa-bolt-lightning"></i></div>
                    <div class="m-info">
                        <strong>0.4s</strong>
                        <span>Average Biometric Check-In</span>
                    </div>
                </div>

                <div class="metric-glass-card">
                    <div class="m-icon-box amber"><i class="fa-solid fa-building-columns"></i></div>
                    <div class="m-info">
                        <strong>Multi-Tenant</strong>
                        <span>Complete Institutional Isolation</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- DEDICATED ROLE PORTALS -->
        <section class="crazy-roles-section" id="portals">

            <div class="crazy-section-heading center scroll-animate">
                <span class="neon-pill"><i class="fa-solid fa-layer-group"></i> ACCESS CONTROL</span>
                <h2>Dedicated Dashboards for Every Stakeholder</h2>
                <p>Streamlined, specialized workflows for campus administrators, faculty members, and students.</p>
            </div>

            <div class="crazy-roles-grid">

                <a href="/admin/login" class="crazy-role-card scroll-animate delay-100 card-admin">
                    <div class="role-card-glow"></div>
                    <div class="role-top">
                        <div class="role-icon-box admin"><i class="fa-solid fa-user-shield"></i></div>
                        <span class="role-tag">MANAGEMENT</span>
                    </div>
                    <h3>College Admin</h3>
                    <p>Manage academic departments, classrooms, faculty assignments, timetables, and student rosters.</p>
                    <span class="role-cta-link">Open Admin Portal <i class="fa-solid fa-arrow-right"></i></span>
                </a>

                <a href="/teacher/login" class="crazy-role-card scroll-animate delay-200 card-teacher">
                    <div class="role-card-glow"></div>
                    <div class="role-top">
                        <div class="role-icon-box teacher"><i class="fa-solid fa-chalkboard-user"></i></div>
                        <span class="role-tag">FACULTY</span>
                    </div>
                    <h3>Teacher / Faculty</h3>
                    <p>Launch live geofenced lecture sessions, track student GPS radar in real time, and export single-click Excel reports.</p>
                    <span class="role-cta-link">Open Teacher Portal <i class="fa-solid fa-arrow-right"></i></span>
                </a>

                <a href="/student/login" class="crazy-role-card scroll-animate delay-300 card-student">
                    <div class="role-card-glow"></div>
                    <div class="role-top">
                        <div class="role-icon-box student"><i class="fa-solid fa-user-graduate"></i></div>
                        <span class="role-tag">STUDENT</span>
                    </div>
                    <h3>Student Portal</h3>
                    <p>Mark attendance using Touch ID/Face ID biometrics, view weekly schedules, and inspect attendance history.</p>
                    <span class="role-cta-link">Open Student Portal <i class="fa-solid fa-arrow-right"></i></span>
                </a>

                <a href="/college/register" class="crazy-role-card highlight scroll-animate delay-100 card-college">
                    <div class="role-card-glow"></div>
                    <div class="role-top">
                        <div class="role-icon-box college"><i class="fa-solid fa-building-columns"></i></div>
                        <span class="role-tag accent">ONBOARDING</span>
                    </div>
                    <h3>Register Institution</h3>
                    <p>Apply for Attendify access. Platform Super Admin verification issues your institution code and credentials.</p>
                    <span class="role-cta-link">Register College <i class="fa-solid fa-arrow-right"></i></span>
                </a>

                <a href="/student/register" class="crazy-role-card highlight scroll-animate delay-200 card-register-student">
                    <div class="role-card-glow"></div>
                    <div class="role-top">
                        <div class="role-icon-box student-reg"><i class="fa-solid fa-user-plus"></i></div>
                        <span class="role-tag">ENROLLMENT</span>
                    </div>
                    <h3>Student Self-Registration</h3>
                    <p>Register yourself for your institution's department and class group. Admin approval activates your passkey.</p>
                    <span class="role-cta-link">Register Student <i class="fa-solid fa-arrow-right"></i></span>
                </a>

            </div>

        </section>

        <!-- FEATURES SECTION -->
        <section class="crazy-features-section" id="features">

            <div class="crazy-section-heading scroll-animate">
                <span class="neon-pill"><i class="fa-solid fa-microchip"></i> CRYPTOGRAPHIC INTEGRITY</span>
                <h2>Engineered for 100% Zero-Proxy Security</h2>
                <p>Combines asymmetric cryptography, hardware secure enclaves, and real-time geodesic calculations.</p>
            </div>

            <div class="crazy-features-grid">

                <article class="crazy-feature-box scroll-animate delay-100">
                    <div class="feature-icon indigo"><i class="fa-solid fa-fingerprint"></i></div>
                    <h3>FIDO2 Biometric Passkeys</h3>
                    <p>Hardware-bound private keys never leave the phone's Secure Enclave, eliminating buddy punching and shared passwords forever.</p>
                </article>

                <article class="crazy-feature-box scroll-animate delay-200">
                    <div class="feature-icon emerald"><i class="fa-solid fa-satellite-dish"></i></div>
                    <h3>Live GPS Classroom Radar</h3>
                    <p>Calculates Haversine geodesic distances in real-time, verifying physical presence within exact classroom geofence perimeters.</p>
                </article>

                <article class="crazy-feature-box scroll-animate delay-300">
                    <div class="feature-icon cyan"><i class="fa-solid fa-shield-virus"></i></div>
                    <h3>Anti-Spoofing Velocity Filter</h3>
                    <p>Temporal velocity models detect and reject mock GPS apps, artificial coordinate injection, and rapid campus teleportation.</p>
                </article>

                <article class="crazy-feature-box scroll-animate delay-100">
                    <div class="feature-icon amber"><i class="fa-solid fa-laptop-code"></i></div>
                    <h3>Trusted Browser Attestation</h3>
                    <p>Entropy-based hardware fingerprinting and cryptographic device cookies provide a secure fallback when biometrics are unavailable.</p>
                </article>

                <article class="crazy-feature-box scroll-animate delay-200">
                    <div class="feature-icon purple"><i class="fa-solid fa-file-excel"></i></div>
                    <h3>Automated Excel Reports</h3>
                    <p>Instant multi-sheet .xlsx generation calculating subject-wise attendance percentages, session logs, and shortfall analytics.</p>
                </article>

                <article class="crazy-feature-box scroll-animate delay-300">
                    <div class="feature-icon rose"><i class="fa-solid fa-bell"></i></div>
                    <h3>VAPID Push Reminders</h3>
                    <p>Automated Service Worker background notifications alert faculty and students before upcoming scheduled lectures.</p>
                </article>

            </div>

        </section>

        <!-- WORKFLOW TIMELINE -->
        <section class="crazy-workflow-section" id="how-it-works">

            <div class="crazy-section-heading center scroll-animate">
                <span class="neon-pill"><i class="fa-solid fa-diagram-project"></i> WORKFLOW</span>
                <h2>From College Onboarding to Live Attendance</h2>
                <p>Four streamlined steps that automate institutional attendance workflows.</p>
            </div>

            <div class="crazy-steps-grid">

                <div class="step-card-crazy scroll-animate delay-100">
                    <div class="step-counter">01</div>
                    <div class="step-icon"><i class="fa-solid fa-building-columns"></i></div>
                    <h3>Institution Onboarding</h3>
                    <p>College submits institutional details. Platform Super Admin reviews and issues admin credentials.</p>
                </div>

                <div class="step-card-crazy scroll-animate delay-200">
                    <div class="step-counter">02</div>
                    <div class="step-icon"><i class="fa-solid fa-calendar-check"></i></div>
                    <h3>Academic Setup</h3>
                    <p>Admin maps classroom GPS coordinates, configures departments, assigns faculty, and builds timetable schedules.</p>
                </div>

                <div class="step-card-crazy scroll-animate delay-300">
                    <div class="step-counter">03</div>
                    <div class="step-icon"><i class="fa-solid fa-play"></i></div>
                    <h3>Lecture Launch</h3>
                    <p>Faculty launches attendance from their dashboard. The live geofence radar and WebSocket stream activate.</p>
                </div>

                <div class="step-card-crazy scroll-animate delay-400">
                    <div class="step-counter">04</div>
                    <div class="step-icon"><i class="fa-solid fa-fingerprint"></i></div>
                    <h3>Instant Biometric Check-In</h3>
                    <p>Students tap Mark Attendance. Hardware passkey + GPS verifies physical presence in under a second.</p>
                </div>

            </div>

        </section>

        <!-- CTA SECTION -->
        <section class="crazy-cta-section">

            <div class="crazy-cta-card scroll-animate">
                <div class="cta-glow-bg"></div>
                <div class="cta-inner-content">
                    <span class="cta-badge"><i class="fa-solid fa-rocket"></i> GET STARTED TODAY</span>
                    <h2>Bring Next-Gen Smart Attendance to Your Campus.</h2>
                    <p>Register your institution today and eliminate proxy attendance with enterprise-grade cryptographic security.</p>
                </div>

                <div class="cta-actions-wrap">
                    <a href="/college/register" class="crazy-btn-primary">
                        <i class="fa-solid fa-building-columns"></i> Register College
                    </a>

                    <a href="/admin/login" class="crazy-btn-secondary">
                        <i class="fa-solid fa-user-shield"></i> Admin Portal
                    </a>
                </div>
            </div>

        </section>

    </main>

    <!-- FOOTER -->
    <footer class="crazy-footer">
        <div class="footer-top-grid">
            <div class="footer-brand-pane">
                <a href="/" class="crazy-brand">
                    <span class="brand-hexagon">
                        <i class="fa-solid fa-clipboard-check"></i>
                    </span>
                    <span class="brand-title">ATTENDIFY</span>
                </a>
                <p>Next-generation smart biometric & GPS verified attendance management system for modern colleges.</p>
            </div>

            <div class="footer-links-pane">
