<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attendify | Next-Gen Biometric & Geofenced Smart Attendance</title>

    <!-- Preconnect to external CDNs -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://fonts.gstatic.com">

    <link rel="stylesheet" href="/css/uiShell.css?v=20260901_fixed5">
    <link rel="stylesheet" href="/css/home.css?v=20260901_crazy_v11">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >
    <link rel="icon" type="image/png" href="/favicon.png">

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#090d16">
    <link rel="apple-touch-icon" href="/icon-192.png">

    <% if (typeof csrfToken !== "undefined") { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
    <% if (typeof realtimeMode !== "undefined") { %>
    <script>
    window.AttendifyRealtimeConfig = {
        mode: <%- JSON.stringify(realtimeMode) %>,
        pollIntervalMs: <%= typeof realtimePollIntervalMs !== "undefined" ? realtimePollIntervalMs : 5000 %>
    };
    </script>
    <% } %>
</head>
<body class="dark-tech-body">

<div class="home-page-crazy">

    <!-- Subtle Ambient Glows -->
    <div class="cyber-grid-overlay"></div>
    <div class="crazy-glow-orb orb-purple"></div>
    <div class="crazy-glow-orb orb-cyan"></div>

    <!-- Navigation Header -->
    <header class="crazy-navbar">
        <a href="/" class="crazy-brand">
            <span class="brand-hexagon">
                <i class="fa-solid fa-clipboard-check"></i>
            </span>
            <span class="brand-title">ATTENDIFY</span>
            <span class="brand-ai-tag"><i class="fa-solid fa-shield-check"></i> FIDO2</span>
        </a>

        <button
            class="crazy-menu-btn"
            id="homeMenuBtn"
            type="button"
            aria-label="Toggle navigation menu"
            aria-controls="homeNavLinks"
            aria-expanded="false"
        >
            <i class="fa-solid fa-bars"></i>
        </button>

        <nav class="crazy-nav-links" id="homeNavLinks">
            <a href="#features" class="c-nav-item"><i class="fa-solid fa-layer-group text-indigo"></i> <span>Features</span></a>
            <a href="#acoustic-radar" class="c-nav-item"><i class="fa-solid fa-tower-broadcast text-purple"></i> <span>Acoustic Radar</span></a>
            <a href="#how-it-works" class="c-nav-item"><i class="fa-solid fa-route text-cyan"></i> <span>How It Works</span></a>
            <a href="/college/register" class="c-nav-item"><i class="fa-solid fa-building-columns text-amber"></i> <span>Register</span></a>
            <a href="/admin/login" class="c-nav-item"><i class="fa-solid fa-user-shield text-purple"></i> <span>Admin</span></a>
            <a href="/teacher/login" class="c-nav-item"><i class="fa-solid fa-chalkboard-user text-cyan"></i> <span>Teacher</span></a>
            <a href="/student/register" class="c-nav-item"><i class="fa-solid fa-user-plus text-emerald"></i> <span>Sign-Up</span></a>
            <a href="/student/login" class="crazy-cta-btn">
                <i class="fa-solid fa-fingerprint"></i> <span>Student Login</span>
            </a>
        </nav>
    </header>

    <main>

        <!-- HERO SECTION -->
        <section class="crazy-hero-section">

            <!-- LEFT: HERO COPY -->
            <div class="crazy-hero-left">

                <div class="live-security-badge animate-fade-up">
                    <span class="radar-ping-dot"></span>
                    <i class="fa-solid fa-shield-halved"></i>
                    <span>ZERO-PROXY BIOMETRIC & ACOUSTIC PLATFORM</span>
                </div>

                <h1 class="crazy-hero-title animate-fade-up delay-100">
                    Smart attendance powered by <span class="neon-indigo">Passkeys</span>, <span class="neon-cyan">Geofencing</span> & <span class="neon-purple">Ultrasonic Radar</span>.
                </h1>

                <p class="crazy-hero-subtitle animate-fade-up delay-200">
                    Eliminate proxy attendance with hardware-bound biometric authentication, sub-meter GPS geofences, and inaudible ultrasonic physical presence verification.
                </p>

                <div class="crazy-hero-actions animate-fade-up delay-300">
                    <a href="/college/register" class="crazy-btn-primary">
                        <i class="fa-solid fa-building-columns"></i>
                        <span>Register Institution</span>
                        <i class="fa-solid fa-arrow-right arrow-shift"></i>
                    </a>

                    <a href="/student/login" class="crazy-btn-secondary">
                        <i class="fa-solid fa-fingerprint text-cyan"></i>
                        <span>Student Passkey Login</span>
                    </a>
                </div>

                <div class="crazy-trust-grid animate-fade-up delay-400">
                    <div class="trust-cell">
                        <i class="fa-solid fa-lock text-indigo"></i>
                        <div>
                            <strong>Hardware Enclave</strong>
                            <span>FIDO2 Passkeys</span>
                        </div>
                    </div>

                    <div class="trust-cell">
                        <i class="fa-solid fa-satellite text-cyan"></i>
                        <div>
                            <strong>Sub-Meter GPS</strong>
                            <span>Geofence Decision Engine</span>
                        </div>
                    </div>

                    <div class="trust-cell">
                        <i class="fa-solid fa-tower-broadcast text-purple"></i>
                        <div>
                            <strong>Ultrasonic Radar</strong>
                            <span>18.6–19.8 kHz 2-FSK</span>
                        </div>
                    </div>

                    <div class="trust-cell">
                        <i class="fa-solid fa-bolt text-emerald"></i>
                        <div>
                            <strong>Live WebSockets</strong>
                            <span>Instant Zero-Refresh Sync</span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- RIGHT: MODERN INTERACTIVE DASHBOARD TERMINAL -->
            <div class="crazy-hero-right animate-fade-up delay-200">

                <div class="modern-dashboard-frame">

                    <!-- Window Header Strip -->
                    <div class="dash-window-header">
                        <div class="dash-mac-dots">
                            <span class="mac-dot red"></span>
                            <span class="mac-dot yellow"></span>
                            <span class="mac-dot green"></span>
                        </div>

                        <div class="dash-nav-pills">
                            <button class="dash-pill-tab active" data-view="map" type="button">
                                <i class="fa-solid fa-map-location-dot"></i> Live Map
                            </button>
                            <button class="dash-pill-tab" data-view="biometric" type="button">
                                <i class="fa-solid fa-fingerprint"></i> Biometrics
                            </button>
                            <button class="dash-pill-tab" data-view="acoustic" type="button">
                                <i class="fa-solid fa-tower-broadcast"></i> Acoustic Radar
                            </button>
                            <button class="dash-pill-tab" data-view="stream" type="button">
                                <i class="fa-solid fa-wave-pulse"></i> Telemetry
                            </button>
                        </div>

                        <div class="dash-connection-status">
                            <span class="pulse-emerald-dot"></span> 18ms
                        </div>
                    </div>

                    <!-- VIEW 1: INTERACTIVE CAMPUS MAP RADAR -->
                    <div class="dash-view-screen active" id="dashView-map">

                        <div class="session-quick-bar">
                            <div class="session-title-cluster">
                                <span class="active-badge"><i class="fa-solid fa-circle"></i> ACTIVE LECTURE</span>
                                <h4>Data Structures (CS401)</h4>
                            </div>
                            <div class="session-geofence-tag">
                                <i class="fa-solid fa-location-crosshairs"></i> 100m Geofence
                            </div>
                        </div>

                        <!-- High-Tech Vector Map Canvas -->
                        <div class="vector-map-canvas">
                            
                            <!-- Campus Building Floorplan Contours -->
                            <div class="map-building-block bldg-a">CS BLOCK</div>
                            <div class="map-building-block bldg-b">LIBRARY</div>
                            <div class="map-road-path road-main"></div>
                            <div class="map-road-path road-cross"></div>

                            <!-- Animated Concentric Geofence Boundary -->
                            <div class="geofence-radar-circle">
                                <div class="radar-scan-sweep"></div>
                                <div class="radar-concentric-line line-1"></div>
                                <div class="radar-concentric-line line-2"></div>
                            </div>

                            <!-- Central Teacher Station Anchor -->
                            <div class="map-pin teacher-anchor" title="Faculty Station (Lab 101)">
                                <div class="pin-halo"></div>
                                <div class="pin-avatar teacher"><i class="fa-solid fa-chalkboard-user"></i></div>
                                <div class="pin-tooltip">Faculty (Lab 101)</div>
                            </div>

                            <!-- Connected Student Pins with Glass Tooltips -->
                            <div class="map-pin student-pin p1" title="Aarav K. • 8.2m">
                                <div class="pin-avatar">AK</div>
                                <div class="pin-tooltip">Aarav K. <span>• 8m</span></div>
                            </div>

                            <div class="map-pin student-pin p2" title="Ananya S. • 14.1m">
                                <div class="pin-avatar">AS</div>
                                <div class="pin-tooltip">Ananya S. <span>• 14m</span></div>
                            </div>

                            <div class="map-pin student-pin p3" title="Harsh K. • 2.4m">
                                <div class="pin-avatar">HK</div>
                                <div class="pin-tooltip">Harsh K. <span>• 2m</span></div>
                            </div>

                            <div class="map-pin student-pin p4" title="Rahul M. • 19.5m">
                                <div class="pin-avatar">RM</div>
                                <div class="pin-tooltip">Rahul M. <span>• 19m</span></div>
                            </div>

                            <!-- Dynamic Simulated Student Pin (Appears on click) -->
                            <div class="map-pin student-pin p5 dynamic" id="simulatedUserPin" style="display: none;">
                                <div class="pin-halo-cyan"></div>
                                <div class="pin-avatar you">YOU</div>
                                <div class="pin-tooltip you">You Verified ✓ <span>• 4.5m</span></div>
                            </div>

                        </div>

                        <!-- Bottom Control & Metric Tray -->
                        <div class="map-metric-tray">
                            <div class="metric-tray-top">
                                <div>
                                    <span class="tray-sub">VERIFIED ATTENDANCE</span>
                                    <strong class="tray-counter" id="liveAttendanceCounter">44 / 50 Present (88%)</strong>
                                </div>
                                <button class="btn-simulate-checkin" id="btnSimulateCheckin" type="button">
                                    <i class="fa-solid fa-location-arrow"></i> Test My Attendance
                                </button>
                            </div>

                            <div class="tray-progress-track">
                                <div class="tray-progress-bar" id="liveAttendanceProgressBar" style="width: 88%;"></div>
                            </div>
                        </div>

                    </div>

                    <!-- VIEW 2: BIOMETRIC SCANNER EXPERIENCE -->
                    <div class="dash-view-screen" id="dashView-biometric">

                        <div class="session-quick-bar">
                            <div class="session-title-cluster">
                                <span class="active-badge fido"><i class="fa-solid fa-shield-check"></i> FIDO2 WEBAUTHN</span>
                                <h4>Hardware Biometric Attestation</h4>
                            </div>
                            <span class="enclave-bound-pill"><i class="fa-solid fa-lock"></i> Secure Enclave</span>
                        </div>

                        <!-- Modern Biometric Scanner Pod -->
                        <div class="biometric-scanner-pod">
                            <div class="biometric-touch-target" id="modernTouchTarget">
                                <div class="scanner-laser-beam" id="scannerLaserBeam"></div>
                                <div class="scanner-glow-circle">
                                    <i class="fa-solid fa-fingerprint scanner-fp-svg"></i>
                                </div>
                                <span class="scanner-helper-text" id="scannerHelperText">Touch to Authenticate</span>
                            </div>

                            <div class="biometric-crypto-terminal" id="cryptoTerminalStream">
                                <div class="term-row"><span class="c-dim">[04:35:10]</span> <span class="c-cyan">WEBAUTHN:</span> 32-Byte challenge issued</div>
                                <div class="term-row"><span class="c-dim">[04:35:11]</span> <span class="c-purple">ENCLAVE:</span> Hardware keypair (ES256 P-256) loaded</div>
                                <div class="term-row"><span class="c-dim">[04:35:12]</span> <span class="c-emerald">READY:</span> Touch sensor to generate assertion signature</div>
                            </div>
                        </div>

                        <!-- Bottom 3 Telemetry Info Chips (Consistent Format) -->
                        <div class="crypto-meta-triplet">
                            <div class="triplet-card">
                                <div class="t-icon-box indigo"><i class="fa-solid fa-key"></i></div>
                                <div class="t-meta-content">
                                    <span>ALGORITHM</span>
                                    <strong class="text-indigo">ES256 (P-256)</strong>
                                    <small class="meta-subtext">ECDSA Hardware Sign</small>
                                </div>
                            </div>
                            <div class="triplet-card">
                                <div class="t-icon-box emerald"><i class="fa-solid fa-shield-halved"></i></div>
                                <div class="t-meta-content">
                                    <span>KEY ISOLATION</span>
                                    <strong class="text-emerald">Hardware HSM</strong>
                                    <small class="meta-subtext">Secure Enclave Bound</small>
                                </div>
                            </div>
                            <div class="triplet-card">
                                <div class="t-icon-box cyan"><i class="fa-solid fa-user-xmark"></i></div>
                                <div class="t-meta-content">
                                    <span>PROXY RISK</span>
                                    <strong class="text-cyan">0.00% (Locked)</strong>
                                    <small class="meta-subtext">Non-Exportable Keys</small>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- VIEW 3: INAUDIBLE ULTRASONIC ACOUSTIC RADAR -->
                    <div class="dash-view-screen" id="dashView-acoustic">

                        <div class="session-quick-bar">
                            <div class="session-title-cluster">
                                <span class="active-badge ultrasonic"><i class="fa-solid fa-tower-broadcast"></i> ULTRASONIC 2-FSK</span>
                                <h4>Acoustic Presence & Seating Ranging</h4>
                            </div>
                            <span class="enclave-bound-pill ultrasonic"><i class="fa-solid fa-volume-xmark text-purple"></i> Inaudible 18.6–19.8 kHz</span>
                        </div>

                        <!-- Ultrasonic Radar Scanner Pod -->
                        <div class="acoustic-scanner-pod">
                            <!-- Left: Interactive Sonar Emitter -->
                            <div class="acoustic-sonar-target" id="acousticSonarTarget" title="Click to transmit ultrasonic 2-FSK chirp">
                                <div class="sonar-radar-grid"></div>
                                <div class="acoustic-wave-ring ring-1"></div>
                                <div class="acoustic-wave-ring ring-2"></div>
                                <div class="acoustic-wave-ring ring-3"></div>
                                <div class="acoustic-wave-ring ring-4"></div>
                                <div class="acoustic-center-emitter">
                                    <div class="emitter-core-glow"></div>
                                    <i class="fa-solid fa-tower-broadcast emitter-icon"></i>
                                </div>
                                <div class="sonar-emitter-label">
                                    <span class="sonar-pulse-dot"></span>
                                    <span id="acousticHelperText">TRANSMIT CHIRP</span>
                                </div>
                            </div>

                            <!-- Right: High-Precision 2-FSK FFT Equalizer Spectrum -->
                            <div class="acoustic-spectrum-card">
                                <div class="spectrum-header-row">
                                    <div class="spectrum-title-wrap">
                                        <div class="spectrum-icon-box"><i class="fa-solid fa-wave-square"></i></div>
                                        <div>
                                            <span class="spectrum-main-title">2-FSK Audio Spectrum</span>
                                            <span class="spectrum-sub-title">2048-pt FFT · Real-Time</span>
                                        </div>
                                    </div>
                                    <span class="seating-row-badge" id="acousticSeatingBadge">
                                        <i class="fa-solid fa-chair text-emerald"></i>
                                        <span class="seating-label-text">Front Row (1.2m)</span>
                                    </span>
                                </div>

                                <div class="spectrum-visualizer-box">
                                    <div class="spectrum-grid-lines">
                                        <span class="db-line"><i>0 dB</i></span>
                                        <span class="db-line"><i>-12 dB</i></span>
                                        <span class="db-line"><i>-24 dB</i></span>
                                        <span class="db-line cutoff-line"><i>18kHz</i></span>
                                    </div>

                                    <div class="spectrum-bars-row" id="spectrumBarsRow">
                                        <div class="spectrum-channel-col cutoff">
                                            <div class="spectrum-bar-track">
                                                <div class="spectrum-bar" style="height: 14%;"></div>
                                            </div>
                                        </div>

                                        <div class="spectrum-channel-col pilot active">
                                            <div class="spectrum-bar-track">
                                                <div class="spectrum-bar pilot active" style="height: 88%;"></div>
                                            </div>
                                        </div>

                                        <div class="spectrum-channel-col">
                                            <div class="spectrum-bar-track">
                                                <div class="spectrum-bar" style="height: 18%;"></div>
                                            </div>
                                        </div>

                                        <div class="spectrum-channel-col bit0 active">
                                            <div class="spectrum-bar-track">
                                                <div class="spectrum-bar bit0 active" style="height: 78%;"></div>
                                            </div>
                                        </div>

                                        <div class="spectrum-channel-col">
                                            <div class="spectrum-bar-track">
                                                <div class="spectrum-bar" style="height: 16%;"></div>
                                            </div>
                                        </div>

                                        <div class="spectrum-channel-col bit1 active">
                                            <div class="spectrum-bar-track">
                                                <div class="spectrum-bar bit1 active" style="height: 92%;"></div>
                                            </div>
                                        </div>

                                        <div class="spectrum-channel-col">
                                            <div class="spectrum-bar-track">
                                                <div class="spectrum-bar" style="height: 12%;"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Clean Frequency Legend Row Below the Grid (Zero Collision!) -->
                                <div class="spectrum-channel-labels-row">
                                    <div class="channel-info"><span class="channel-freq">18.0k</span><span class="channel-tag">CUTOFF</span></div>
                                    <div class="channel-info"><span class="channel-freq text-cyan">18.6k</span><span class="channel-tag pilot">PILOT</span></div>
                                    <div class="channel-info"><span class="channel-freq">19.0k</span><span class="channel-tag">GUARD</span></div>
                                    <div class="channel-info"><span class="channel-freq text-purple">19.2k</span><span class="channel-tag bit0">BIT 0</span></div>
                                    <div class="channel-info"><span class="channel-freq">19.5k</span><span class="channel-tag">GUARD</span></div>
                                    <div class="channel-info"><span class="channel-freq text-rose">19.8k</span><span class="channel-tag bit1">BIT 1</span></div>
                                    <div class="channel-info"><span class="channel-freq">20.0k</span><span class="channel-tag">EDGE</span></div>
                                </div>
                            </div>
                        </div>

                        <!-- Bottom 3 Telemetry Info Chips -->
                        <div class="crypto-meta-triplet acoustic-meta">
                            <div class="triplet-card">
                                <div class="t-icon-box purple"><i class="fa-solid fa-wave-square"></i></div>
                                <div class="t-meta-content">
                                    <span>MODULATION</span>
                                    <strong class="text-purple">2-FSK Pilot Sync</strong>
                                    <small class="meta-subtext">Δf = 600 Hz · 25ms/bit</small>
                                </div>
                            </div>
                            <div class="triplet-card">
                                <div class="t-icon-box cyan"><i class="fa-solid fa-filter"></i></div>
                                <div class="t-meta-content">
                                    <span>FILTER CUTOFF</span>
                                    <strong class="text-cyan">18.0 kHz High-Pass</strong>
                                    <small class="meta-subtext">Speech & Noise Blocked</small>
                                </div>
                            </div>
                            <div class="triplet-card">
                                <div class="t-icon-box emerald"><i class="fa-solid fa-laptop-code"></i></div>
                                <div class="t-meta-content">
                                    <span>HARDWARE NEEDED</span>
                                    <strong class="text-emerald">Zero (Built-In Audio)</strong>
                                    <small class="meta-subtext">Built-in Mic & Speaker</small>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- VIEW 4: LIVE TELEMETRY LOGS -->
                    <div class="dash-view-screen" id="dashView-stream">

                        <div class="session-quick-bar">
                            <div class="session-title-cluster">
                                <span class="active-badge"><i class="fa-solid fa-satellite"></i> LIVE STREAM</span>
                                <h4>Cryptographic Verification Feed</h4>
                            </div>
                            <span class="badge-socket-live"><i class="fa-solid fa-bolt"></i> Real-Time</span>
                        </div>

                        <div class="telemetry-log-stream" id="telemetryLogStream">
                            <div class="log-row verified">
                                <span class="log-time">04:34:12</span>
                                <span class="log-badge pass">VERIFIED</span>
                                <span class="log-desc">Harsh K. (AIML-3C5CF1) • GPS: 2.1m inside • FIDO2 Passkey ✓</span>
                            </div>
                            <div class="log-row verified">
                                <span class="log-time">04:34:20</span>
                                <span class="log-badge pass">VERIFIED</span>
                                <span class="log-desc">Aarav K. (AIML-1351EA) • GPS: 7.8m inside • FIDO2 Passkey ✓</span>
                            </div>
                            <div class="log-row verified">
                                <span class="log-time">04:34:31</span>
                                <span class="log-badge pass">VERIFIED</span>
                                <span class="log-desc">Ananya S. (AIML-2281FB) • GPS: 13.9m inside • FIDO2 Passkey ✓</span>
                            </div>
                            <div class="log-row verified">
                                <span class="log-time">04:34:45</span>
                                <span class="log-badge pass">VERIFIED</span>
                                <span class="log-desc">Rahul M. (AIML-8821CD) • GPS: 18.2m inside • FIDO2 Passkey ✓</span>
                            </div>
                            <div class="log-row blocked">
                                <span class="log-time">04:34:52</span>
                                <span class="log-badge reject">BLOCKED</span>
                                <span class="log-desc">Unknown Device • Distance: 480m (Hostel Block) • Outside 100m Geofence ❌</span>
                            </div>
                        </div>

                        <!-- Bottom 3 Telemetry Info Chips (Matching Format) -->
                        <div class="crypto-meta-triplet telemetry-meta">
                            <div class="triplet-card">
                                <div class="t-icon-box indigo"><i class="fa-solid fa-bolt"></i></div>
                                <div class="t-meta-content">
                                    <span>SOCKET PROTOCOL</span>
                                    <strong class="text-indigo">WebSocket (TLS 1.3)</strong>
                                    <small class="meta-subtext">Sub-20ms Event Delivery</small>
                                </div>
                            </div>
                            <div class="triplet-card">
                                <div class="t-icon-box emerald"><i class="fa-solid fa-database"></i></div>
                                <div class="t-meta-content">
                                    <span>MULTI-TENANT</span>
                                    <strong class="text-emerald">Atlas Isolated</strong>
                                    <small class="meta-subtext">Institution Data Siloed</small>
                                </div>
                            </div>
                            <div class="triplet-card">
                                <div class="t-icon-box cyan"><i class="fa-solid fa-file-shield"></i></div>
                                <div class="t-meta-content">
                                    <span>AUDIT TRAIL</span>
                                    <strong class="text-cyan">Tamper-Evident</strong>
                                    <small class="meta-subtext">Immutable Session Logs</small>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Bottom Frame Footer -->
                    <div class="dash-window-footer">
                        <div class="footer-chip">
                            <i class="fa-solid fa-server text-indigo"></i> MongoDB Atlas Multi-Tenant
                        </div>
                        <div class="footer-chip">
                            <i class="fa-solid fa-shield-check text-emerald"></i> 100% Anti-Proxy Verified
                        </div>
                    </div>

                </div>

            </div>

        </section>

        <!-- METRICS SECTION -->
        <section class="crazy-metrics-banner scroll-animate">
