<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Attendify | Next-Gen Biometric & Geofenced Smart Attendance</title>

    <!-- Preconnect to external CDNs -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://fonts.gstatic.com">

    <link rel="stylesheet" href="/css/uiShell.css?v=20260901_fixed3">
    <link rel="stylesheet" href="/css/home.css?v=20260901_modern">
    <link rel="stylesheet" href="/css/attendifyDarkFix.css?v=8">
    <link rel="stylesheet" href="/css/attendifyUIOverhaul.css?v=2">
    <link rel="stylesheet" href="/css/attendifyUIOverhaulExtra.css?v=19">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >
    <link rel="icon" type="image/png" href="/favicon.png">

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#090d16">
    <link rel="apple-touch-icon" href="/icon-192.png">

    <% if (typeof csrfToken !== "undefined") { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
    <% if (typeof realtimeMode !== "undefined") { %>
    <script>
    window.AttendifyRealtimeConfig = {
        mode: <%- JSON.stringify(realtimeMode) %>,
        pollIntervalMs: <%= typeof realtimePollIntervalMs !== "undefined" ? realtimePollIntervalMs : 5000 %>
    };
    </script>
    <% } %>
</head>
<body class="dark-tech-body">

<div class="home-page-crazy">

    <!-- Subtle Ambient Glows -->
    <div class="cyber-grid-overlay"></div>
    <div class="crazy-glow-orb orb-purple"></div>
    <div class="crazy-glow-orb orb-cyan"></div>

    <!-- Navigation Header -->
    <header class="crazy-navbar">
        <a href="/" class="crazy-brand">
            <span class="brand-hexagon">
                <i class="fa-solid fa-clipboard-check"></i>
            </span>
            <span class="brand-title">ATTENDIFY</span>
            <span class="brand-ai-tag"><i class="fa-solid fa-shield-check"></i> FIDO2</span>
        </a>

        <button
            class="crazy-menu-btn"
            id="homeMenuBtn"
            type="button"
            aria-label="Toggle navigation menu"
            aria-controls="homeNavLinks"
            aria-expanded="false"
        >
            <i class="fa-solid fa-bars"></i>
        </button>

        <nav class="crazy-nav-links" id="homeNavLinks">
            <a href="#features" class="c-nav-item">Features</a>
            <a href="#how-it-works" class="c-nav-item">How It Works</a>
            <a href="/college/register" class="c-nav-item">Register College</a>
            <a href="/admin/login" class="c-nav-item">Admin</a>
            <a href="/teacher/login" class="c-nav-item">Teacher</a>
            <a href="/student/register" class="c-nav-item">Student Sign-Up</a>
            <a href="/student/login" class="crazy-cta-btn">
                <i class="fa-solid fa-fingerprint"></i> Student Login
            </a>
        </nav>
    </header>
    <div class="home-nav-overlay" id="homeNavOverlay"></div>

    <main>

        <!-- HERO SECTION -->
        <section class="crazy-hero-section">

            <!-- LEFT: HERO COPY -->
            <div class="crazy-hero-left">

                <div class="live-security-badge animate-fade-up">
                    <span class="radar-ping-dot"></span>
                    <i class="fa-solid fa-shield-halved"></i>
                    <span>ZERO-PROXY BIOMETRIC & GPS PLATFORM</span>
                </div>

                <h1 class="crazy-hero-title animate-fade-up delay-100">
                    Smart attendance powered by <span class="neon-indigo">FIDO2 Passkeys</span> & <span class="neon-cyan">Live Geofencing</span>.
                </h1>

                <p class="crazy-hero-subtitle animate-fade-up delay-200">
                    Eliminate proxy attendance with hardware-bound biometric authentication, sub-meter GPS verification, and real-time live lecture telemetry.
                </p>

                <div class="crazy-hero-actions animate-fade-up delay-300">
                    <a href="/college/register" class="crazy-btn-primary">
                        <i class="fa-solid fa-building-columns"></i>
                        <span>Register Institution</span>
                        <i class="fa-solid fa-arrow-right arrow-shift"></i>
                    </a>

                    <a href="/student/login" class="crazy-btn-secondary">
                        <i class="fa-solid fa-fingerprint text-cyan"></i>
                        <span>Student Passkey Login</span>
                    </a>
                </div>

                <div class="crazy-trust-grid animate-fade-up delay-400">
                    <div class="trust-cell">
                        <i class="fa-solid fa-lock text-indigo"></i>
                        <div>
                            <strong>Hardware Enclave</strong>
                            <span>FIDO2 Passkeys</span>
                        </div>
                    </div>

                    <div class="trust-cell">
                        <i class="fa-solid fa-satellite text-cyan"></i>
                        <div>
                            <strong>Sub-Meter GPS</strong>
                            <span>Geofence Decision Engine</span>
                        </div>
                    </div>

                    <div class="trust-cell">
                        <i class="fa-solid fa-bolt text-emerald"></i>
                        <div>
                            <strong>Live WebSockets</strong>
                            <span>Instant Zero-Refresh Sync</span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- RIGHT: MODERN INTERACTIVE DASHBOARD TERMINAL -->
            <div class="crazy-hero-right animate-fade-up delay-200">

                <div class="modern-dashboard-frame">

                    <!-- Window Header Strip -->
                    <div class="dash-window-header">
                        <div class="dash-mac-dots">
                            <span class="mac-dot red"></span>
                            <span class="mac-dot yellow"></span>
                            <span class="mac-dot green"></span>
                        </div>

                        <div class="dash-nav-pills">
                            <button class="dash-pill-tab active" data-view="map" type="button">
                                <i class="fa-solid fa-map-location-dot"></i> Live Map
                            </button>
                            <button class="dash-pill-tab" data-view="biometric" type="button">
                                <i class="fa-solid fa-fingerprint"></i> Biometrics
                            </button>
                            <button class="dash-pill-tab" data-view="stream" type="button">
                                <i class="fa-solid fa-wave-pulse"></i> Telemetry
                            </button>
                        </div>

                        <div class="dash-connection-status">
                            <span class="pulse-emerald-dot"></span> 18ms
                        </div>
                    </div>

                    <!-- VIEW 1: INTERACTIVE CAMPUS MAP RADAR -->
                    <div class="dash-view-screen active" id="dashView-map">

                        <div class="session-quick-bar">
                            <div class="session-title-cluster">
                                <span class="active-badge"><i class="fa-solid fa-circle"></i> ACTIVE LECTURE</span>
                                <h4>Data Structures (CS401)</h4>
                            </div>
                            <div class="session-geofence-tag">
                                <i class="fa-solid fa-location-crosshairs"></i> 100m Geofence
                            </div>
                        </div>

                        <!-- High-Tech Vector Map Canvas -->
                        <div class="vector-map-canvas">
                            
                            <!-- Campus Building Floorplan Contours -->
                            <div class="map-building-block bldg-a">CS BLOCK</div>
                            <div class="map-building-block bldg-b">LIBRARY</div>
                            <div class="map-road-path road-main"></div>
                            <div class="map-road-path road-cross"></div>

                            <!-- Animated Concentric Geofence Boundary -->
                            <div class="geofence-radar-circle">
                                <div class="radar-scan-sweep"></div>
                                <div class="radar-concentric-line line-1"></div>
                                <div class="radar-concentric-line line-2"></div>
                            </div>

                            <!-- Central Teacher Station Anchor -->
                            <div class="map-pin teacher-anchor" title="Faculty Station (Lab 101)">
                                <div class="pin-halo"></div>
                                <div class="pin-avatar teacher"><i class="fa-solid fa-chalkboard-user"></i></div>
                                <div class="pin-tooltip">Faculty (Lab 101)</div>
                            </div>

                            <!-- Connected Student Pins with Glass Tooltips -->
                            <div class="map-pin student-pin p1" title="Aarav K. • 8.2m">
                                <div class="pin-avatar">AK</div>
                                <div class="pin-tooltip">Aarav K. <span>• 8m</span></div>
                            </div>

                            <div class="map-pin student-pin p2" title="Ananya S. • 14.1m">
                                <div class="pin-avatar">AS</div>
                                <div class="pin-tooltip">Ananya S. <span>• 14m</span></div>
                            </div>

                            <div class="map-pin student-pin p3" title="Harsh K. • 2.4m">
                                <div class="pin-avatar">HK</div>
                                <div class="pin-tooltip">Harsh K. <span>• 2m</span></div>
                            </div>

                            <div class="map-pin student-pin p4" title="Rahul M. • 19.5m">
                                <div class="pin-avatar">RM</div>
                                <div class="pin-tooltip">Rahul M. <span>• 19m</span></div>
                            </div>

                            <!-- Dynamic Simulated Student Pin (Appears on click) -->
                            <div class="map-pin student-pin p5 dynamic" id="simulatedUserPin" style="display: none;">
                                <div class="pin-halo-cyan"></div>
                                <div class="pin-avatar you">YOU</div>
                                <div class="pin-tooltip you">You Verified ✓ <span>• 4.5m</span></div>
                            </div>

                        </div>

                        <!-- Bottom Control & Metric Tray -->
                        <div class="map-metric-tray">
                            <div class="metric-tray-top">
                                <div>
                                    <span class="tray-sub">VERIFIED ATTENDANCE</span>
                                    <strong class="tray-counter" id="liveAttendanceCounter">44 / 50 Present (88%)</strong>
                                </div>
                                <button class="btn-simulate-checkin" id="btnSimulateCheckin" type="button">
                                    <i class="fa-solid fa-location-arrow"></i> Test My Attendance
                                </button>
                            </div>

                            <div class="tray-progress-track">
                                <div class="tray-progress-bar" id="liveAttendanceProgressBar" style="width: 88%;"></div>
                            </div>
                        </div>

                    </div>

                    <!-- VIEW 2: BIOMETRIC SCANNER EXPERIENCE -->
                    <div class="dash-view-screen" id="dashView-biometric">

                        <div class="session-quick-bar">
                            <div class="session-title-cluster">
                                <span class="active-badge fido"><i class="fa-solid fa-shield-check"></i> FIDO2 WEBAUTHN</span>
                                <h4>Hardware Biometric Attestation</h4>
                            </div>
                            <span class="enclave-bound-pill"><i class="fa-solid fa-lock"></i> Secure Enclave</span>
                        </div>

                        <!-- Modern Biometric Scanner Pod -->
                        <div class="biometric-scanner-pod">
                            <div class="biometric-touch-target" id="modernTouchTarget">
                                <div class="scanner-laser-beam" id="scannerLaserBeam"></div>
                                <div class="scanner-glow-circle">
                                    <i class="fa-solid fa-fingerprint scanner-fp-svg"></i>
                                </div>
                                <span class="scanner-helper-text" id="scannerHelperText">Touch to Authenticate</span>
                            </div>

                            <div class="biometric-crypto-terminal" id="cryptoTerminalStream">
                                <div class="term-row"><span class="c-dim">[04:35:10]</span> <span class="c-cyan">WEBAUTHN:</span> 32-Byte challenge issued</div>
                                <div class="term-row"><span class="c-dim">[04:35:11]</span> <span class="c-purple">ENCLAVE:</span> Hardware keypair (ES256 P-256) loaded</div>
                                <div class="term-row"><span class="c-dim">[04:35:12]</span> <span class="c-emerald">READY:</span> Touch sensor to generate assertion signature</div>
                            </div>
                        </div>

                        <div class="crypto-meta-triplet">
                            <div class="triplet-card">
                                <span>ALGORITHM</span>
                                <strong>ES256 (P-256)</strong>
                            </div>
                            <div class="triplet-card">
                                <span>KEY ISOLATION</span>
                                <strong class="text-emerald">Hardware HSM</strong>
                            </div>
                            <div class="triplet-card">
                                <span>PROXY CHANCE</span>
                                <strong class="text-cyan">0.00% (Locked)</strong>
                            </div>
                        </div>

                    </div>

                    <!-- VIEW 3: LIVE TELEMETRY LOGS -->
                    <div class="dash-view-screen" id="dashView-stream">

                        <div class="session-quick-bar">
                            <div class="session-title-cluster">
                                <span class="active-badge"><i class="fa-solid fa-satellite"></i> LIVE STREAM</span>
                                <h4>Cryptographic Verification Feed</h4>
                            </div>
                            <span class="badge-socket-live"><i class="fa-solid fa-bolt"></i> Real-Time</span>
                        </div>

                        <div class="telemetry-log-stream" id="telemetryLogStream">
                            <div class="log-row verified">
                                <span class="log-time">04:34:12</span>
                                <span class="log-badge pass">VERIFIED</span>
                                <span class="log-desc">Harsh K. (AIML-3C5CF1) • GPS: 2.1m inside • FIDO2 Passkey ✓</span>
                            </div>
                            <div class="log-row verified">
                                <span class="log-time">04:34:20</span>
                                <span class="log-badge pass">VERIFIED</span>
                                <span class="log-desc">Aarav K. (AIML-1351EA) • GPS: 7.8m inside • FIDO2 Passkey ✓</span>
                            </div>
                            <div class="log-row verified">
                                <span class="log-time">04:34:31</span>
                                <span class="log-badge pass">VERIFIED</span>
                                <span class="log-desc">Ananya S. (AIML-2281FB) • GPS: 13.9m inside • FIDO2 Passkey ✓</span>
                            </div>
                            <div class="log-row verified">
                                <span class="log-time">04:34:45</span>
                                <span class="log-badge pass">VERIFIED</span>
                                <span class="log-desc">Rahul M. (AIML-8821CD) • GPS: 18.2m inside • FIDO2 Passkey ✓</span>
                            </div>
                            <div class="log-row blocked">
                                <span class="log-time">04:34:52</span>
                                <span class="log-badge reject">BLOCKED</span>
                                <span class="log-desc">Unknown Device • Distance: 480m (Hostel Block) • Outside 100m Geofence ❌</span>
                            </div>
                        </div>

                    </div>

                    <!-- Bottom Frame Footer -->
                    <div class="dash-window-footer">
                        <div class="footer-chip">
                            <i class="fa-solid fa-server text-indigo"></i> MongoDB Atlas Multi-Tenant
                        </div>
                        <div class="footer-chip">
                            <i class="fa-solid fa-shield-check text-emerald"></i> 100% Anti-Proxy Verified
                        </div>
                    </div>

                </div>

            </div>

        </section>

        <!-- METRICS SECTION -->
        <section class="crazy-metrics-banner scroll-animate">
            <div class="metrics-grid-crazy">
                <div class="metric-glass-card">
                    <div class="m-icon-box indigo"><i class="fa-solid fa-fingerprint"></i></div>
                    <div class="m-info">
                        <strong>100%</strong>
                        <span>Zero-Proxy Hardware Security</span>
                    </div>
                </div>

                <div class="metric-glass-card">
                    <div class="m-icon-box cyan"><i class="fa-solid fa-satellite-dish"></i></div>
                    <div class="m-info">
                        <strong>&lt; 100m</strong>
                        <span>Sub-Meter Classroom Geofencing</span>
                    </div>
                </div>

                <div class="metric-glass-card">
                    <div class="m-icon-box emerald"><i class="fa-solid fa-bolt-lightning"></i></div>
                    <div class="m-info">
                        <strong>0.4s</strong>
                        <span>Average Biometric Check-In</span>
                    </div>
                </div>

                <div class="metric-glass-card">
                    <div class="m-icon-box amber"><i class="fa-solid fa-building-columns"></i></div>
                    <div class="m-info">
                        <strong>Multi-Tenant</strong>
                        <span>Complete Institutional Isolation</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- DEDICATED ROLE PORTALS -->
        <section class="crazy-roles-section" id="portals">

            <div class="crazy-section-heading center scroll-animate">
                <span class="neon-pill"><i class="fa-solid fa-layer-group"></i> ACCESS CONTROL</span>
                <h2>Dedicated Dashboards for Every Stakeholder</h2>
                <p>Streamlined, specialized workflows for campus administrators, faculty members, and students.</p>
            </div>

            <div class="crazy-roles-grid">

                <a href="/admin/login" class="crazy-role-card scroll-animate delay-100">
                    <div class="role-top">
                        <div class="role-icon-box admin"><i class="fa-solid fa-user-shield"></i></div>
                        <span class="role-tag">MANAGEMENT</span>
                    </div>
                    <h3>College Admin</h3>
                    <p>Manage academic departments, classrooms, faculty assignments, timetables, and student rosters.</p>
                    <span class="role-cta-link">Open Admin Portal <i class="fa-solid fa-arrow-right"></i></span>
                </a>

                <a href="/teacher/login" class="crazy-role-card scroll-animate delay-200">
                    <div class="role-top">
                        <div class="role-icon-box teacher"><i class="fa-solid fa-chalkboard-user"></i></div>
                        <span class="role-tag">FACULTY</span>
                    </div>
                    <h3>Teacher / Faculty</h3>
                    <p>Launch live geofenced lecture sessions, track student GPS radar in real time, and export single-click Excel reports.</p>
                    <span class="role-cta-link">Open Teacher Portal <i class="fa-solid fa-arrow-right"></i></span>
                </a>

                <a href="/student/login" class="crazy-role-card scroll-animate delay-300">
                    <div class="role-top">
                        <div class="role-icon-box student"><i class="fa-solid fa-user-graduate"></i></div>
                        <span class="role-tag">STUDENT</span>
                    </div>
                    <h3>Student Portal</h3>
                    <p>Mark attendance using Touch ID/Face ID biometrics, view weekly schedules, and inspect attendance history.</p>
                    <span class="role-cta-link">Open Student Portal <i class="fa-solid fa-arrow-right"></i></span>
                </a>

                <a href="/college/register" class="crazy-role-card highlight scroll-animate delay-100">
                    <div class="role-top">
                        <div class="role-icon-box college"><i class="fa-solid fa-building-columns"></i></div>
                        <span class="role-tag accent">ONBOARDING</span>
                    </div>
                    <h3>Register Institution</h3>
                    <p>Apply for Attendify access. Platform Super Admin verification issues your institution code and credentials.</p>
                    <span class="role-cta-link">Register College <i class="fa-solid fa-arrow-right"></i></span>
                </a>

                <a href="/student/register" class="crazy-role-card highlight scroll-animate delay-200">
                    <div class="role-top">
                        <div class="role-icon-box student-reg"><i class="fa-solid fa-user-plus"></i></div>
                        <span class="role-tag">ENROLLMENT</span>
                    </div>
                    <h3>Student Self-Registration</h3>
                    <p>Register yourself for your institution's department and class group. Admin approval activates your passkey.</p>
                    <span class="role-cta-link">Register Student <i class="fa-solid fa-arrow-right"></i></span>
                </a>

                <a href="/platform-admin/login" class="crazy-role-card highlight scroll-animate delay-300">
                    <div class="role-top">
                        <div class="role-icon-box platform-admin"><i class="fa-solid fa-server"></i></div>
                        <span class="role-tag">SUPERADMIN</span>
                    </div>
                    <h3>Platform Governance</h3>
                    <p>Institutional approvals, global multi-tenant isolation parameters, audit trail logs, and system controls.</p>
                    <span class="role-cta-link">Open Superadmin <i class="fa-solid fa-arrow-right"></i></span>
                </a>

            </div>

        </section>

        <!-- FEATURES SECTION -->
        <section class="crazy-features-section" id="features">

            <div class="crazy-section-heading scroll-animate">
                <span class="neon-pill"><i class="fa-solid fa-microchip"></i> CRYPTOGRAPHIC INTEGRITY</span>
                <h2>Engineered for 100% Zero-Proxy Security</h2>
                <p>Combines asymmetric cryptography, hardware secure enclaves, and real-time geodesic calculations.</p>
            </div>

            <div class="crazy-features-grid">

                <article class="crazy-feature-box scroll-animate delay-100">
                    <div class="feature-icon indigo"><i class="fa-solid fa-fingerprint"></i></div>
                    <h3>FIDO2 Biometric Passkeys</h3>
                    <p>Hardware-bound private keys never leave the phone's Secure Enclave, eliminating buddy punching and shared passwords forever.</p>
                </article>

                <article class="crazy-feature-box scroll-animate delay-200">
                    <div class="feature-icon emerald"><i class="fa-solid fa-satellite-dish"></i></div>
                    <h3>Live GPS Classroom Radar</h3>
                    <p>Calculates Haversine geodesic distances in real-time, verifying physical presence within exact classroom geofence perimeters.</p>
                </article>

                <article class="crazy-feature-box scroll-animate delay-300">
                    <div class="feature-icon cyan"><i class="fa-solid fa-shield-virus"></i></div>
                    <h3>Anti-Spoofing Velocity Filter</h3>
                    <p>Temporal velocity models detect and reject mock GPS apps, artificial coordinate injection, and rapid campus teleportation.</p>
                </article>

                <article class="crazy-feature-box scroll-animate delay-100">
                    <div class="feature-icon amber"><i class="fa-solid fa-laptop-code"></i></div>
                    <h3>Trusted Browser Attestation</h3>
                    <p>Entropy-based hardware fingerprinting and cryptographic device cookies provide a secure fallback when biometrics are unavailable.</p>
                </article>

                <article class="crazy-feature-box scroll-animate delay-200">
                    <div class="feature-icon purple"><i class="fa-solid fa-file-excel"></i></div>
                    <h3>Automated Excel Reports</h3>
                    <p>Instant multi-sheet .xlsx generation calculating subject-wise attendance percentages, session logs, and shortfall analytics.</p>
                </article>

                <article class="crazy-feature-box scroll-animate delay-300">
                    <div class="feature-icon rose"><i class="fa-solid fa-bell"></i></div>
                    <h3>VAPID Push Reminders</h3>
                    <p>Automated Service Worker background notifications alert faculty and students before upcoming scheduled lectures.</p>
                </article>

            </div>

        </section>

        <!-- WORKFLOW SECTION -->
        <section class="crazy-workflow-section" id="how-it-works">

            <div class="crazy-section-heading center scroll-animate">
                <span class="neon-pill"><i class="fa-solid fa-diagram-project"></i> WORKFLOW</span>
                <h2>From College Onboarding to Live Attendance</h2>
                <p>Four streamlined steps that automate institutional attendance workflows.</p>
            </div>

            <div class="crazy-steps-grid">

                <div class="step-card-crazy scroll-animate delay-100">
                    <div class="step-counter">01</div>
                    <div class="step-icon"><i class="fa-solid fa-building-columns"></i></div>
                    <h3>Institution Onboarding</h3>
                    <p>College submits institutional details. Platform Super Admin reviews and issues admin credentials.</p>
                </div>

                <div class="step-card-crazy scroll-animate delay-200">
                    <div class="step-counter">02</div>
                    <div class="step-icon"><i class="fa-solid fa-calendar-check"></i></div>
                    <h3>Academic Setup</h3>
                    <p>Admin maps classroom GPS coordinates, configures departments, assigns faculty, and builds timetable schedules.</p>
                </div>

                <div class="step-card-crazy scroll-animate delay-300">
                    <div class="step-counter">03</div>
                    <div class="step-icon"><i class="fa-solid fa-play"></i></div>
                    <h3>Lecture Launch</h3>
                    <p>Faculty launches attendance from their dashboard. The live geofence radar and WebSocket stream activate.</p>
                </div>

                <div class="step-card-crazy scroll-animate delay-400">
                    <div class="step-counter">04</div>
                    <div class="step-icon"><i class="fa-solid fa-fingerprint"></i></div>
                    <h3>Instant Biometric Check-In</h3>
                    <p>Students tap Mark Attendance. Hardware passkey + GPS verifies physical presence in under a second.</p>
                </div>

            </div>

        </section>

        <!-- CTA SECTION -->
        <section class="crazy-cta-section">

            <div class="crazy-cta-card scroll-animate">
                <div class="cta-inner-content">
                    <span class="cta-badge"><i class="fa-solid fa-rocket"></i> GET STARTED TODAY</span>
                    <h2>Bring Next-Gen Smart Attendance to Your Campus.</h2>
                    <p>Register your institution today and eliminate proxy attendance with enterprise-grade cryptographic security.</p>
