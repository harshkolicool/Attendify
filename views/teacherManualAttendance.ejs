<!DOCTYPE html>
<html lang="en">
<head>
    <script>
        (function(){try{var t=localStorage.getItem('attendifyTheme')||localStorage.getItem('theme');if(t==='dark'||(!t&&window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches)){document.documentElement.setAttribute('data-theme','dark');document.documentElement.classList.add('dark-mode');document.documentElement.style.backgroundColor='#0b0f19';}else{document.documentElement.setAttribute('data-theme','light');document.documentElement.classList.remove('dark-mode');document.documentElement.style.backgroundColor='#f8fafc';}}catch(e){}})();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manual Attendance | Attendify</title>

    <!-- Preconnect to external CDNs -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://fonts.gstatic.com">

    <link rel="stylesheet" href="/css/uiShell.css?v=20260901_fixed3">
    <link rel="stylesheet" href="/css/teacherDashboard.css?v=1783707422685">
    <link rel="stylesheet" href="/css/teacherManualAttendance.css?v=20260831">
    <link rel="stylesheet" href="/css/attendifyDarkFix.css?v=8">
    <link rel="stylesheet" href="/css/attendifyUIOverhaul.css?v=1">
    <link rel="stylesheet" href="/css/attendifyUIOverhaulExtra.css?v=19">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" type="image/png" href="/favicon.png">

    <!-- Flatpickr Date Picker -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.js"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" defer></script>
    <script src="/js/customAlerts.js" defer></script>

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#4f46e5">
    <link rel="apple-touch-icon" href="/icon-192.png">

    <% if (typeof csrfToken !== "undefined") { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
    <% if (typeof realtimeMode !== "undefined") { %>
    <script>
    window.AttendifyRealtimeConfig = {
        mode: <%- JSON.stringify(realtimeMode) %>,
        pollIntervalMs: <%= typeof realtimePollIntervalMs !== "undefined" ? realtimePollIntervalMs : 5000 %>
    };
    </script>
    <% } %>
</head>
<body>

<div class="teacher-page">

    <%- include("teacher/partials/sidebar", { activePage: typeof activePage !== "undefined" ? activePage : "manual-attendance", teacher: typeof teacher !== "undefined" ? teacher : null }) %>

    <main class="teacher-main teacher-manual-page">

        <!-- Executive Header Deck -->
        <header class="teacher-header">
            <div class="teacher-header-left">
                <div class="teacher-avatar-badge">
                    <%= typeof teacher !== "undefined" && teacher.name ? teacher.name.charAt(0).toUpperCase() : "T" %>
                    <span class="teacher-online-dot" title="Active"></span>
                </div>
                <div class="teacher-header-titles">
                    <div class="teacher-header-badge-row">
                        <span class="teacher-kicker">Faculty Portal</span>
                        <span class="teacher-dept-chip">
                            <i class="fa-solid fa-pen-to-square"></i>
                            Manual Entry Mode
                        </span>
                    </div>
                    <h1>Manual Attendance</h1>
                    <p>
                        Mark and adjust attendance for completed and past class lectures.
                    </p>
                </div>
            </div>

            <div class="teacher-header-actions">
                <a href="/teacher/dashboard" class="teacher-header-action-btn secondary" title="Back to Live Dashboard">
                    <i class="fa-solid fa-gauge-high"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/teacher/reports" class="teacher-header-action-btn primary" title="View Detailed Reports">
                    <i class="fa-solid fa-chart-pie"></i>
                    <span>Reports</span>
                </a>
            </div>
        </header>

        <% if (typeof error !== "undefined" && error) { %>
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    if (typeof window.showToast === "function") {
                        window.showToast(<%- JSON.stringify(error) %>, "error");
                    } else if (typeof Swal !== "undefined") {
                        Swal.fire({ toast: true, position: "top-end", icon: "error", title: <%- JSON.stringify(error) %>, showConfirmButton: false, timer: 3500, timerProgressBar: true });
                    }
                    try {
                        const url = new URL(window.location);
                        url.searchParams.delete("error");
                        window.history.replaceState({}, document.title, url.pathname + (url.searchParams.toString() ? "?" + url.searchParams.toString() : ""));
                    } catch(e) {}
                });
            </script>
        <% } %>

        <% if (typeof message !== "undefined" && message) { %>
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    if (typeof window.showToast === "function") {
                        window.showToast(<%- JSON.stringify(message) %>, "success");
                    } else if (typeof Swal !== "undefined") {
                        Swal.fire({ toast: true, position: "top-end", icon: "success", title: <%- JSON.stringify(message) %>, showConfirmButton: false, timer: 3500, timerProgressBar: true });
                    }
                    try {
                        const url = new URL(window.location);
                        url.searchParams.delete("message");
                        window.history.replaceState({}, document.title, url.pathname + (url.searchParams.toString() ? "?" + url.searchParams.toString() : ""));
                    } catch(e) {}
                });
            </script>
        <% } %>

        <%
            const manualDateBasePath = "/teacher/manual-attendance";
        %>

        <!-- Date Navigator & Quick Ribbon Deck -->
        <section class="manual-nav-deck">
            <div class="manual-nav-top-row">
                <div class="manual-nav-stepper">
                    <a
                        href="<%= manualDateBasePath %>?date=<%= manualDatePreviousInput %>"
                        class="manual-step-btn"
                        title="Go to Previous Day"
                    >
                        <i class="fa-solid fa-chevron-left"></i>
                        Previous Day
                    </a>

                    <% if (manualDateNextInput) { %>
                        <a
                            href="<%= manualDateBasePath %>?date=<%= manualDateNextInput %>"
                            class="manual-step-btn"
                            title="Go to Next Day"
                        >
                            Next Day
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    <% } else { %>
                        <span class="manual-step-btn disabled" title="Cannot select future dates">
                            Next Day
                            <i class="fa-solid fa-chevron-right"></i>
                        </span>
                    <% } %>
                </div>

                <div>
                    <button
                        type="button"
                        class="manual-calendar-trigger-btn"
                        id="manualDateTriggerBtn"
                    >
                        <i class="fa-regular fa-calendar-days"></i>
                        <span>Calendar Picker</span>
                    </button>
                    <input
                        type="text"
                        id="manualDateFlatpickr"
                        class="manual-flatpickr-hidden"
                        value="<%= selectedDateInput %>"
                    >
                </div>
            </div>

            <!-- Date Chips Horizontal Ribbon -->
            <% if (manualDateOptions && manualDateOptions.length > 0) { %>
                <div class="manual-date-ribbon-wrap">
                    <div class="manual-date-ribbon">
                        <% manualDateOptions.forEach(function(option) { %>
                            <a
                                href="/teacher/manual-attendance?date=<%= option.dateInput %>"
                                class="manual-ribbon-chip <%= selectedDateInput === option.dateInput ? 'active' : '' %>"
                                title="<%= option.label %>"
                            >
                                <span class="chip-kicker"><%= option.quickLabel || option.dayName %></span>
                                <span class="chip-date"><%= option.shortLabel || option.label %></span>
                            </a>
                        <% }) %>
                    </div>
                </div>
            <% } %>
        </section>

        <% if (!selectedSchedule) { %>

            <!-- Date Overview & Status KPI Card -->
            <section class="manual-overview-card">
                <div class="manual-overview-header">
                    <div class="manual-overview-date-title">
                        <div class="manual-date-icon-box">
                            <i class="fa-regular fa-calendar-check"></i>
                        </div>
                        <div>
                            <h2><%= selectedDayName %>, <%= selectedDateLabel %></h2>
                            <p>Select a completed lecture below to record or modify student attendance.</p>
                        </div>
                    </div>

                    <% if (manualSummary) { %>
                        <div class="manual-kpi-pill-group">
                            <span class="manual-kpi-pill indigo" title="Total scheduled classes">
                                <strong><%= manualSummary.totalClasses %></strong> Total Classes
                            </span>

                            <span class="manual-kpi-pill sky" title="Classes that have ended and are eligible">
                                <strong><%= manualSummary.manualEligibleClasses %></strong> Eligible
                            </span>

                            <span class="manual-kpi-pill emerald" title="Attendance recorded">
                                <i class="fa-solid fa-circle-check"></i>
                                <strong><%= manualSummary.recordedClasses %></strong> Recorded
                            </span>

                            <% if (manualSummary.pendingClasses > 0) { %>
                                <span class="manual-kpi-pill amber" title="Awaiting manual attendance">
                                    <i class="fa-solid fa-clock-rotate-left"></i>
                                    <strong><%= manualSummary.pendingClasses %></strong> Pending
                                </span>
                            <% } %>
                        </div>
                    <% } %>
                </div>

                <div class="manual-instruction-banner">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>Manual attendance is accessible for all lectures after their scheduled class end time.</span>
                </div>
            </section>

            <!-- Schedule Cards Grid -->
            <% if (!manualSchedules || manualSchedules.length === 0) { %>
                <div class="manual-empty-card">
                    <div class="manual-empty-icon">
                        <i class="fa-regular fa-calendar-xmark"></i>
                    </div>
                    <h3>No Classes Found For This Date</h3>
                    <p>There are no completed lectures eligible for manual attendance on <%= selectedDateLabel %>.</p>
                </div>
            <% } else { %>

                <section class="manual-schedule-grid">
                    <% manualSchedules.forEach(function(item) { %>
                        <% const schedule = item.schedule; %>

                        <article class="manual-lecture-card">
                            <div class="manual-card-top-row">
                                <span class="manual-time-badge">
                                    <i class="fa-regular fa-clock"></i>
                                    <%= schedule.startTime %> - <%= schedule.endTime %>
                                </span>

                                <% if (item.isRecorded) { %>
                                    <span class="manual-status-badge recorded">
                                        <i class="fa-solid fa-circle-check"></i>
                                        Recorded
                                    </span>
                                <% } else { %>
                                    <span class="manual-status-badge pending">
                                        <i class="fa-solid fa-clock-rotate-left"></i>
                                        Awaiting Entry
                                    </span>
                                <% } %>
                            </div>

                            <div class="manual-card-body">
                                <div class="manual-subject-title-row">
                                    <h3><%= schedule.subject ? schedule.subject.subjectName : "Subject Missing" %></h3>
                                    <% if (schedule.subject && schedule.subject.subjectCode) { %>
                                        <span class="manual-code-chip"><%= schedule.subject.subjectCode %></span>
                                    <% } %>
                                </div>

                                <div class="manual-meta-chips-row">
                                    <span class="manual-meta-chip">
                                        <i class="fa-solid fa-users"></i>
                                        <%= schedule.classGroup ? schedule.classGroup.name : "Class Missing" %>
                                    </span>

                                    <span class="manual-meta-chip">
                                        <i class="fa-solid fa-location-dot"></i>
                                        <%= schedule.classroom ? schedule.classroom.classroomName : "Room Missing" %>
                                    </span>
                                </div>
                            </div>

                            <div>
                                <% if (item.isRecorded) { %>
                                    <a
                                        href="/teacher/manual-attendance/<%= schedule._id %>?date=<%= selectedDateInput %>"
                                        class="manual-card-action-btn edit"
                                    >
                                        <i class="fa-solid fa-pen-to-square"></i>
                                        <span>Edit Attendance</span>
                                    </a>
                                <% } else { %>
                                    <a
                                        href="/teacher/manual-attendance/<%= schedule._id %>?date=<%= selectedDateInput %>"
                                        class="manual-card-action-btn mark"
                                    >
                                        <i class="fa-solid fa-clipboard-check"></i>
                                        <span>Mark Attendance</span>
                                    </a>
                                <% } %>
                            </div>
                        </article>
                    <% }) %>
                </section>

            <% } %>

        <% } else { %>

            <!-- Student Roll / Marking Section -->
            <section class="manual-roster-hero-card">
                <div class="manual-roster-hero-top">
                    <div class="manual-roster-class-info">
                        <h2><%= selectedSchedule.subject ? selectedSchedule.subject.subjectName : "Subject Missing" %></h2>
                        <div class="manual-roster-tags-row">
                            <span class="manual-roster-tag">
                                <i class="fa-regular fa-calendar"></i>
                                <%= selectedDateLabel %>
                            </span>
                            <span class="manual-roster-tag">
                                <i class="fa-solid fa-users"></i>
                                <%= selectedSchedule.classGroup ? selectedSchedule.classGroup.name : "Class Missing" %>
                            </span>
                            <span class="manual-roster-tag">
                                <i class="fa-solid fa-location-dot"></i>
                                <%= selectedSchedule.classroom ? selectedSchedule.classroom.classroomName : "Room Missing" %>
                            </span>
                            <span class="manual-roster-tag">
                                <i class="fa-regular fa-clock"></i>
                                <%= selectedSchedule.startTime %> - <%= selectedSchedule.endTime %>
                            </span>
                        </div>
                    </div>

                    <a href="/teacher/manual-attendance?date=<%= selectedDateInput %>" class="manual-roster-back-btn">
                        <i class="fa-solid fa-arrow-left"></i>
                        <span>Back to Class List</span>
                    </a>
                </div>

                <% if (!students || students.length === 0) { %>
                    <div class="manual-empty-card">
                        <div class="manual-empty-icon">
                            <i class="fa-solid fa-user-slash"></i>
                        </div>
                        <h3>No Students Enrolled</h3>
                        <p>There are no active students mapped to <%= selectedSchedule.classGroup ? selectedSchedule.classGroup.name : "this class group" %>.</p>
                    </div>
                <% } else { %>

                    <form
                        action="/teacher/manual-attendance/<%= selectedSchedule._id %>?date=<%= selectedDateInput %>"
                        method="POST"
                        id="manualAttendanceForm"
                    >
                        <div class="manual-roster-toolbar">
                            <div class="manual-roster-toolbar-left">
                                <h4>Student Roll</h4>
                                <span class="manual-roster-count-badge" id="rosterCountBadge">
                                    <%= students.length %> Students
                                </span>
                            </div>

                            <div class="manual-bulk-actions">
                                <button type="button" class="manual-bulk-btn all-present" onclick="setAllManualStudents(true)">
                                    <i class="fa-solid fa-check-double"></i>
                                    <span>Mark All Present</span>
                                </button>

                                <button type="button" class="manual-bulk-btn clear-all" onclick="setAllManualStudents(false)">
                                    <i class="fa-solid fa-xmark"></i>
                                    <span>Clear All</span>
                                </button>
                            </div>
                        </div>

                        <div class="manual-student-grid" style="margin-top: 16px;">
                            <% students.forEach(function(student) { %>
                                <%
                                    const existingStatus = existingRecordsByStudent[student._id.toString()];
                                    const checked = existingStatus === "PRESENT";
                                    const studentInitials = student.fullName
                                        ? student.fullName.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase()
                                        : "ST";
                                %>

                                <label class="manual-student-card <%= checked ? 'checked' : '' %>">
                                    <input
                                        type="checkbox"
                                        name="presentStudents"
                                        value="<%= student._id %>"
                                        <%= checked ? "checked" : "" %>
                                        onchange="updateStudentCardState(this)"
                                    >

                                    <div class="manual-student-check-box">
                                        <i class="fa-solid fa-check"></i>
                                    </div>

                                    <div class="manual-student-avatar">
                                        <%= studentInitials %>
                                    </div>

                                    <div class="manual-student-info">
                                        <strong><%= typeof student !== "undefined" && student.fullName %></strong>
                                        <small><%= student.enrollmentNumber %></small>
                                    </div>
                                </label>
                            <% }) %>
                        </div>

                        <div class="manual-save-bar">
                            <button class="manual-save-submit-btn" type="submit">
                                <i class="fa-solid fa-floppy-disk"></i>
                                <span>Save Attendance Record</span>
                            </button>
                        </div>

                    </form>

                <% } %>
            </section>

        <% } %>

    </main>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Flatpickr initialization
        const hiddenPicker = document.getElementById("manualDateFlatpickr");
        const triggerBtn = document.getElementById("manualDateTriggerBtn");

        if (hiddenPicker && window.flatpickr) {
            const fp = flatpickr(hiddenPicker, {
                dateFormat: "Y-m-d",
                defaultDate: "<%= selectedDateInput %>",
                maxDate: "<%= manualDateMaxInput %>",
                minDate: "<%= manualDateMinInput %>",
                disableMobile: true,
                onChange: function (selectedDates, dateStr) {
                    if (dateStr) {
                        window.location.href = "<%= manualDateBasePath %>?date=" + encodeURIComponent(dateStr);
                    }
                }
            });

            if (triggerBtn && fp) {
                triggerBtn.addEventListener("click", function (e) {
                    e.preventDefault();
                    fp.open();
                });
            }
        }

        updateRosterCount();
    });

    function updateStudentCardState(checkbox) {
        const card = checkbox.closest(".manual-student-card");
        if (card) {
            if (checkbox.checked) {
                card.classList.add("checked");
            } else {
                card.classList.remove("checked");
            }
        }
        updateRosterCount();
    }

    function setAllManualStudents(checked) {
        document.querySelectorAll("input[name='presentStudents']").forEach(function (input) {
            input.checked = checked;
            const card = input.closest(".manual-student-card");
            if (card) {
                if (checked) {
                    card.classList.add("checked");
                } else {
                    card.classList.remove("checked");
                }
            }
        });
        updateRosterCount();
    }

    function updateRosterCount() {
        const total = document.querySelectorAll("input[name='presentStudents']").length;
        const present = document.querySelectorAll("input[name='presentStudents']:checked").length;
        const badge = document.getElementById("rosterCountBadge");
        if (badge && total > 0) {
            badge.textContent = present + " / " + total + " Present";
        }
    }
</script>

<script src="/js/uiShell.js"></script>
<script src="/js/csrfAuto.js" defer></script>
<script src="/js/selectEnhancer.js" defer></script>
<script src="/js/teacherNav.js" defer></script>
</body>
</html>
