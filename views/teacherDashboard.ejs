<body>

<%
    const now = new Date();
    const currentDate = now.getDate();
    const currentHour = now.getHours();
    let greeting = "Good morning";
    if (currentHour >= 12 && currentHour < 17) greeting = "Good afternoon";
    else if (currentHour >= 17) greeting = "Good evening";

    const teacherName = typeof teacher !== "undefined" && teacher && teacher.fullName ? teacher.fullName : "Teacher";

    function parseTeacherTimeToMinutes(timeValue) {
        if (!timeValue) {
            return Number.MAX_SAFE_INTEGER;
        }

        const raw = String(timeValue).trim().toUpperCase();
        const amPmMatch = raw.match(/^(\d{1,2}):(\d{2})\s*(AM|PM)$/);

        if (amPmMatch) {
            let hours = Number(amPmMatch[1]) % 12;
            const minutes = Number(amPmMatch[2]);

            if (amPmMatch[3] === "PM") {
                hours += 12;
            }

            return (hours * 60) + minutes;
        }

        const plainMatch = raw.match(/^(\d{1,2}):(\d{2})$/);
        if (plainMatch) {
            return (Number(plainMatch[1]) * 60) + Number(plainMatch[2]);
        }

        return Number.MAX_SAFE_INTEGER;
    }

    function getScheduleCardStateKey(card) {
        if (card.liveSession) {
            return "live";
        }

        if (card.canStart) {
            return "ready";
        }

        if (card.showManual) {
            return "manual";
        }

        if (card.todaySession || card.manualAlreadyDone) {
            return "recorded";
        }

        if (card.timeStatus === "upcoming") {
            return "upcoming";
        }

        if (card.timeStatus === "ended") {
            return "ended";
        }

        return "invalid";
    }

    function getScheduleCardStateLabel(stateKey) {
        if (stateKey === "live") {
            return "Live";
        }

        if (stateKey === "ready") {
            return "Ready";
        }

        if (stateKey === "manual") {
            return "Manual";
        }

        if (stateKey === "recorded") {
            return "Recorded";
        }

        if (stateKey === "upcoming") {
            return "Upcoming";
        }

        if (stateKey === "ended") {
            return "Ended";
        }

        return "Invalid";
    }

    const scheduleDirectoryMap = {};
    const scheduleRoomOptionMap = {};
    const scheduleStateOptionMap = {};

    (scheduleCards || []).forEach(function(card) {
        const scheduleItem = card.schedule || {};
        const stateKey = getScheduleCardStateKey(card);
        const classGroup = scheduleItem.classGroup || null;

        let groupId = "missing";
        let groupName = "Class Group Missing";
        let groupMeta = "Schedules without linked class group";
        let groupSortKey = "zzz-missing";

        if (classGroup && classGroup._id) {
            const department = classGroup.department || "";
            const semester = classGroup.semester || "";
            const section = classGroup.section || "";

            groupId = classGroup._id.toString();
            groupName = classGroup.name || "Unnamed Class Group";
            groupMeta = [
                department,
                semester ? "Sem " + semester : "",
                section ? "Section " + section : ""
            ].filter(Boolean).join(" · ");

            if (!groupMeta) {
                groupMeta = "Class metadata not set";
            }

            groupSortKey = [
                department || "zzz",
                String(semester || 99).padStart(2, "0"),
                section || "ZZ",
                groupName
            ].join("-");
        }

        if (!scheduleDirectoryMap[groupId]) {
            scheduleDirectoryMap[groupId] = {
                id: groupId,
                name: groupName,
                meta: groupMeta,
                sortKey: groupSortKey,
                roomMap: {},
                cards: []
            };
        }

        if (scheduleItem.classroom) {
            const roomToken = scheduleItem.classroom._id
                ? scheduleItem.classroom._id.toString()
                : (scheduleItem.classroom.classroomName || "missing-room");
            const roomLabel = [
                scheduleItem.classroom.classroomName || "Room Missing",
                scheduleItem.classroom.buildingName || ""
            ].filter(Boolean).join(" · ");

            scheduleDirectoryMap[groupId].roomMap[roomToken] = roomLabel;
            scheduleRoomOptionMap[roomToken] = roomLabel;
        }

        scheduleStateOptionMap[stateKey] = getScheduleCardStateLabel(stateKey);
        scheduleDirectoryMap[groupId].cards.push(card);
    });

    const scheduleStateOrder = {
        live: 1,
        ready: 2,
        manual: 3,
        recorded: 4,
        upcoming: 5,
        ended: 6,
        invalid: 7
    };

    const scheduleDirectoryGroups = Object.values(scheduleDirectoryMap).sort(function(first, second) {
        return first.sortKey.localeCompare(second.sortKey);
    });

    scheduleDirectoryGroups.forEach(function(group) {
        group.cards.sort(function(firstCard, secondCard) {
            const firstTime = parseTeacherTimeToMinutes(firstCard.schedule ? firstCard.schedule.startTime : "");
            const secondTime = parseTeacherTimeToMinutes(secondCard.schedule ? secondCard.schedule.startTime : "");
            return firstTime - secondTime;
        });
    });

    const scheduleGroupOptions = scheduleDirectoryGroups
        .filter(function(group) { return group.id !== "missing"; })
        .map(function(group) {
            return {
                value: group.id,
                label: group.name
            };
        });

    const scheduleRoomOptions = Object.keys(scheduleRoomOptionMap)
        .map(function(roomToken) {
            return {
                value: roomToken,
                label: scheduleRoomOptionMap[roomToken]
            };
        })
        .sort(function(first, second) {
            return first.label.localeCompare(second.label);
        });

    const scheduleStateOptions = Object.keys(scheduleStateOptionMap)
        .map(function(stateKey) {
            return {
                value: stateKey,
                label: scheduleStateOptionMap[stateKey]
            };
        })
        .sort(function(first, second) {
            return (scheduleStateOrder[first.value] || 99) - (scheduleStateOrder[second.value] || 99);
        });
%>

<div class="teacher-layout">

    <%- include("teacher/partials/sidebar", { activePage: typeof activePage !== "undefined" ? activePage : "dashboard", teacher: typeof teacher !== "undefined" ? teacher : null }) %>

    <main class="teacher-main teacher-dashboard-page">

        <header class="teacher-header">
            <div class="teacher-header-left">
                <div class="teacher-avatar-badge">
                    <span><%= teacherName.charAt(0).toUpperCase() %></span>
                    <span class="teacher-online-dot" title="Online"></span>
                </div>
                <div class="teacher-header-titles">
                    <div class="teacher-header-badge-row">
                        <span class="teacher-kicker"><i class="fa-solid fa-chalkboard-user"></i> Faculty Portal</span>
                        <% if (typeof teacher !== "undefined" && teacher && teacher.department) { %>
                            <span class="teacher-dept-chip"><i class="fa-solid fa-graduation-cap"></i> <%= teacher.department %></span>
                        <% } %>
                        <% if (activeSessions.length > 0) { %>
                            <span class="teacher-live-now-chip"><span class="pulse-dot"></span> <%= activeSessions.length %> <%= activeSessions.length === 1 ? 'Session' : 'Sessions' %> Active</span>
                        <% } %>
                    </div>
                    <h1><%= greeting %>, <%= teacherName %>!</h1>
                    <p>
                        <i class="fa-regular fa-calendar-days"></i>
                        <span><%= today %></span> &bull; <span class="teacher-highlight-count"><%= schedules.length %> <%= schedules.length === 1 ? 'class' : 'classes' %> scheduled</span>
                    </p>
                </div>
            </div>

            <div class="teacher-header-actions">
                <button id="enablePushBtn" class="teacher-enable-push-pill" style="display: none;" title="Enable Notifications">
                    <i class="fa-solid fa-bell"></i>
                    <span>Enable Alerts</span>
                </button>

                <div class="teacher-datepicker-btn" id="teacherDateBtn" title="Click to change date">
                    <div class="teacher-datepicker-icon">
                        <i class="fa-solid fa-calendar-days"></i>
                    </div>
                    <div class="teacher-datepicker-text">
                        <span class="teacher-datepicker-kicker">Date Filter</span>
                        <span class="teacher-datepicker-val" id="teacherDisplayDate">
                            <%= typeof targetDate !== 'undefined' && targetDate ? new Date(targetDate + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Today' %>
                        </span>
                    </div>
                    <i class="fa-solid fa-chevron-down teacher-datepicker-arrow"></i>
                    <input type="text" id="teacherDatePicker" class="teacher-hidden-input" value="<%= typeof targetDate !== 'undefined' ? targetDate : '' %>" readonly autocomplete="off">
                </div>

                <a href="/teacher/reports" class="teacher-reports-quick-btn" title="View Detailed Reports">
                    <i class="fa-solid fa-chart-pie"></i>
                    <span>Reports</span>
                </a>
            </div>
        </header>

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const picker = document.getElementById("teacherDatePicker");
                const dateBtn = document.getElementById("teacherDateBtn");
                
                const fp = flatpickr(picker, {
                    dateFormat: "Y-m-d",
                    defaultDate: "<%= typeof targetDate !== 'undefined' ? targetDate : '' %>",
                    disableMobile: true,
                    position: "auto right",
                    locale: {
                        weekdays: {
                            shorthand: ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"],
                            longhand: ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
                        }
                    },
                    onChange: function(selectedDates, dateStr, instance) {
                        if (dateStr) {
                            window.location.href = '/teacher/dashboard?date=' + dateStr;
                        }
                    }
                });

                if (dateBtn && fp) {
                    dateBtn.addEventListener('click', function(e) {
                        if (e.target !== picker) {
                            fp.open();
                        }
                    });
                }
            });
        </script>

        <% if (typeof error !== "undefined" && error) { %>
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    if (typeof window.showToast === "function") {
                        window.showToast(<%- JSON.stringify(error) %>, "error");
                    } else if (typeof Swal !== "undefined") {
                        Swal.fire({ toast: true, position: "top-end", icon: "error", title: <%- JSON.stringify(error) %>, showConfirmButton: false, timer: 3500, timerProgressBar: true });
                    }
                    try {
                        const url = new URL(window.location);
                        url.searchParams.delete("error");
                        window.history.replaceState({}, document.title, url.pathname + (url.searchParams.toString() ? "?" + url.searchParams.toString() : ""));
                    } catch(e) {}
                });
            </script>
        <% } %>

        <% if (typeof message !== "undefined" && message) { %>
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    if (typeof window.showToast === "function") {
                        window.showToast(<%- JSON.stringify(message) %>, "success");
                    } else if (typeof Swal !== "undefined") {
                        Swal.fire({ toast: true, position: "top-end", icon: "success", title: <%- JSON.stringify(message) %>, showConfirmButton: false, timer: 3500, timerProgressBar: true });
                    }
                    try {
                        const url = new URL(window.location);
                        url.searchParams.delete("message");
                        window.history.replaceState({}, document.title, url.pathname + (url.searchParams.toString() ? "?" + url.searchParams.toString() : ""));
                    } catch(e) {}
                });
            </script>
        <% } %>

        <section class="teacher-stats-grid">
            <article class="teacher-stat-card blue">
                <div class="teacher-stat-glow-orb blue"></div>
                <div class="teacher-stat-icon-tile blue">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
                <div class="teacher-stat-content">
                    <span class="teacher-stat-label">Today's Classes</span>
                    <div class="teacher-stat-val-row">
                        <strong class="teacher-stat-value"><%= schedules.length %></strong>
                        <span class="teacher-stat-badge blue"><i class="fa-solid fa-book-open"></i> Schedule</span>
                    </div>
                    <span class="teacher-stat-subtext"><%= schedules.length === 1 ? '1 lecture scheduled' : schedules.length + ' lectures scheduled' %></span>
                </div>
            </article>

            <article class="teacher-stat-card <%= activeSessions.length > 0 ? 'sky active-pulse' : 'sky' %>">
                <div class="teacher-stat-glow-orb sky"></div>
                <div class="teacher-stat-icon-tile sky">
                    <i class="fa-solid fa-satellite-dish"></i>
                </div>
                <div class="teacher-stat-content">
                    <span class="teacher-stat-label">Active Sessions</span>
                    <div class="teacher-stat-val-row">
                        <strong class="teacher-stat-value"><%= activeSessions.length %></strong>
                        <% if (activeSessions.length > 0) { %>
                            <span class="teacher-stat-badge sky"><span class="pulse-dot"></span> Live</span>
                        <% } else { %>
                            <span class="teacher-stat-badge slate">Standby</span>
                        <% } %>
                    </div>
                    <span class="teacher-stat-subtext"><%= activeSessions.length > 0 ? 'Realtime telemetry active' : 'No active session' %></span>
                </div>
            </article>

            <article class="teacher-stat-card <%= manualAttendanceList.length > 0 ? 'amber' : 'purple' %>">
                <div class="teacher-stat-glow-orb <%= manualAttendanceList.length > 0 ? 'amber' : 'purple' %>"></div>
                <div class="teacher-stat-icon-tile <%= manualAttendanceList.length > 0 ? 'amber' : 'purple' %>">
                    <i class="fa-solid fa-clipboard-user"></i>
                </div>
                <div class="teacher-stat-content">
                    <span class="teacher-stat-label">Manual Entries</span>
                    <div class="teacher-stat-val-row">
                        <strong class="teacher-stat-value"><%= manualAttendanceList.length %></strong>
                        <% if (manualAttendanceList.length > 0) { %>
                            <span class="teacher-stat-badge amber"><i class="fa-solid fa-clock-rotate-left"></i> Pending</span>
                        <% } else { %>
                            <span class="teacher-stat-badge purple"><i class="fa-solid fa-circle-check"></i> Clean</span>
                        <% } %>
                    </div>
                    <span class="teacher-stat-subtext"><%= manualAttendanceList.length > 0 ? 'Awaiting manual entry' : 'All classes recorded' %></span>
                </div>
            </article>
        </section>

        <section class="content-area">

            <div class="panel-box teacher-schedule-panel" id="schedule-section">
                <div class="teacher-schedule-panel-head">
                    <div>
                        <h3 class="panel-title">
                            <i class="fa-solid fa-list-check"></i>
                            Class Schedule
                        </h3>

                        <p class="panel-subtitle">
                            Start and monitor GPS-verified attendance during scheduled class hours.
                        </p>
                    </div>
                </div>

                <div class="gps-help-banner teacher-gps-help-banner">
                    <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                    <strong>GPS Tip:</strong> For best accuracy when starting class, enable precise location, step away from thick walls, and wait a few seconds.
                </div>

                <% if (scheduleCards.length === 0) { %>
                    <div class="empty-box">
                        <div><i class="fa-solid fa-calendar-xmark"></i></div>
                        <p>No classes scheduled for today</p>
                    </div>
                <% } else { %>

                    <div class="teacher-schedule-toolbar-card">

                        <div class="teacher-schedule-search-row">
                            <label for="teacherScheduleSearchInput">Search Schedule</label>

                            <div class="teacher-search-box">
                                <i class="fa-solid fa-magnifying-glass"></i>
                                <input
                                    id="teacherScheduleSearchInput"
                                    type="text"
                                    placeholder="Search subject, class group, room or status..."
                                    data-teacher-schedule-search
                                >
                            </div>
                        </div>

                        <div class="teacher-schedule-filter-grid">

                            <div class="teacher-schedule-filter-field">
                                <label for="teacherScheduleGroupFilter">Class Group</label>

                                <div class="select-shell">
                                    <i class="fa-solid fa-users select-shell-icon"></i>
                                    <select id="teacherScheduleGroupFilter" data-teacher-schedule-filter="group">
                                        <option value="">All Class Groups</option>

                                        <% scheduleGroupOptions.forEach(function(option) { %>
                                            <option value="<%= option.value %>"><%= option.label %></option>
                                        <% }) %>
                                    </select>
                                    <i class="fa-solid fa-chevron-down select-shell-chevron"></i>
                                </div>
                            </div>

                            <div class="teacher-schedule-filter-field">
                                <label for="teacherScheduleRoomFilter">Classroom</label>

                                <div class="select-shell">
                                    <i class="fa-solid fa-door-open select-shell-icon"></i>
                                    <select id="teacherScheduleRoomFilter" data-teacher-schedule-filter="room">
                                        <option value="">All Classrooms</option>

                                        <% scheduleRoomOptions.forEach(function(option) { %>
                                            <option value="<%= option.value %>"><%= option.label %></option>
                                        <% }) %>
                                    </select>
                                    <i class="fa-solid fa-chevron-down select-shell-chevron"></i>
                                </div>
                            </div>

                            <div class="teacher-schedule-filter-field">
                                <label for="teacherScheduleStateFilter">Status</label>

                                <div class="select-shell">
                                    <i class="fa-solid fa-filter select-shell-icon"></i>
                                    <select id="teacherScheduleStateFilter" data-teacher-schedule-filter="state">
                                        <option value="">All Statuses</option>

                                        <% scheduleStateOptions.forEach(function(option) { %>
                                            <option value="<%= option.value %>"><%= option.label %></option>
                                        <% }) %>
                                    </select>
                                    <i class="fa-solid fa-chevron-down select-shell-chevron"></i>
                                </div>
                            </div>

                            <div class="teacher-schedule-filter-field teacher-schedule-filter-action">
                                <label for="teacherScheduleClearFilters">Reset</label>

                                <button
                                    id="teacherScheduleClearFilters"
                                    type="button"
                                    class="teacher-secondary-btn"
                                    data-teacher-schedule-reset
                                >
                                    <i class="fa-solid fa-rotate-left"></i>
                                    Clear Filters
                                </button>
                            </div>

                        </div>

                    </div>

                    <div class="teacher-schedule-groups">
                        <% scheduleDirectoryGroups.forEach(function(group, groupIndex) { %>
                            <%
                                const groupRooms = Object.keys(group.roomMap)
                                    .map(function(roomKey) { return group.roomMap[roomKey]; })
                                    .sort();
                            %>

                            <details
                                class="teacher-schedule-group-panel"
                                data-teacher-schedule-container
                                data-filter-group="<%= group.id %>"
                                <%= groupIndex === 0 ? "open" : "" %>
                            >
                                <summary class="teacher-schedule-group-summary">
                                    <div class="teacher-schedule-group-summary-copy">
                                        <h4><%= group.name %></h4>
                                        <p><%= group.meta %></p>

                                        <div class="teacher-schedule-room-list">
                                            <% if (groupRooms.length > 0) { %>
                                                <% groupRooms.forEach(function(roomLabel) { %>
                                                    <span class="teacher-room-chip">
                                                        <i class="fa-solid fa-door-open"></i>
                                                        <%= roomLabel %>
                                                    </span>
                                                <% }) %>
                                            <% } else { %>
                                                <span class="teacher-room-chip muted">
                                                    <i class="fa-regular fa-circle-question"></i>
                                                    Classroom not mapped
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>

                                    <span class="teacher-count-pill" data-teacher-schedule-visible-count>
                                        <%= group.cards.length %> <%= group.cards.length === 1 ? 'Class' : 'Classes' %>
                                    </span>
                                </summary>

                                <div class="teacher-schedule-group-list">
                                    <% group.cards.forEach(function(card) { %>
                                        <%
                                            const item = card.schedule;
                                            const stateKey = getScheduleCardStateKey(card);
                                            const roomToken = item && item.classroom
                                                ? (item.classroom._id
                                                    ? item.classroom._id.toString()
                                                    : (item.classroom.classroomName || "missing-room"))
                                                : "missing-room";
                                        %>

                                        <article
                                            class="class-card teacher-schedule-class-card"
                                            data-teacher-schedule-item
                                            data-filter-group="<%= group.id %>"
                                            data-filter-room="<%= roomToken %>"
                                            data-filter-state="<%= stateKey %>"
                                            data-start-time="<%= item.startTime %>"
                                            data-end-time="<%= item.endTime %>"
                                        >

                                            <div class="time-box teacher-schedule-time">
                                                <strong><%= item.startTime %></strong>
                                                <span><%= item.endTime %></span>
                                            </div>

                                            <div class="class-info teacher-schedule-class-info">

                                                <div class="teacher-card-subject-row">
                                                    <h4><%= item.subject ? item.subject.subjectName : 'Subject Missing' %></h4>
                                                    <% if (item.subject && item.subject.subjectCode) { %>
                                                        <span class="subject-code-chip"><%= item.subject.subjectCode %></span>
                                                    <% } %>
                                                </div>

                                                <div class="teacher-card-meta-row">
                                                    <span class="teacher-meta-tag group">
                                                        <i class="fa-solid fa-users"></i>
                                                        <%= item.classGroup ? item.classGroup.name : 'Class Missing' %>
                                                    </span>

                                                    <span class="teacher-meta-tag room">
                                                        <i class="fa-solid fa-location-dot"></i>
                                                        <%= item.classroom ? item.classroom.classroomName : 'Room Missing' %>
                                                    </span>
                                                </div>

                                            </div>

