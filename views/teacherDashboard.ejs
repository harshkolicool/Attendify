<script>
// ---- Pending Attendance Reviews ----
(function() {
    function getCsrfToken() {
        const meta = document.querySelector('meta[name="csrf-token"]');
        return meta ? meta.getAttribute('content') : '';
    }

    function formatDate(dateStr) {
        if (!dateStr) return '-';
        return new Date(dateStr).toLocaleDateString([], { day: '2-digit', month: 'short', year: 'numeric' });
    }

    function renderReviews(reviews) {
        const section = document.getElementById('pendingReviewsSection');
        const list = document.getElementById('pendingReviewsList');
        const empty = document.getElementById('pendingReviewsEmpty');
        const count = document.getElementById('pendingReviewCount');

        if (!section || !list || !empty || !count) return;

        count.textContent = reviews.length + ' Pending';

        if (reviews.length === 0) {
            section.style.display = '';
            empty.style.display = '';
            list.innerHTML = '';
            return;
        }

        section.style.display = '';
        empty.style.display = 'none';

        list.innerHTML = reviews.map(function(record) {
            const student = record.student || {};
            const subject = record.subject || {};
            const session = record.attendanceSession || {};
            const classGroup = record.classGroup || {};

            return '<div class="teacher-review-item" data-record-id="' + record._id + '">' +
                '<div class="review-header-row">' +
                    '<div class="review-student-info">' +
                        '<div class="review-student-name-row">' +
                            '<strong class="review-student-name">' + (student.fullName || 'Student') + '</strong>' +
                            '<span class="review-enrollment-pill">' + (student.enrollmentNumber || '') + '</span>' +
                        '</div>' +
                        '<div class="review-class-details">' +
                            '<i class="fa-solid fa-book fa-fw"></i> ' + (subject.subjectName || 'Subject') + ' &middot; ' + (classGroup.name || '') +
                        '</div>' +
                        '<div class="review-date">' +
                            '<i class="fa-solid fa-clock fa-fw"></i> ' + formatDate(session.startTime) +
                        '</div>' +
                    '</div>' +
                    '<div class="review-actions">' +
                        '<button class="teacher-primary-btn review-approve-btn" data-record-id="' + record._id + '">' +
                            '<i class="fa-solid fa-check"></i> Approve' +
                        '</button>' +
                        '<button class="teacher-secondary-btn review-reject-btn" data-record-id="' + record._id + '">' +
                            '<i class="fa-solid fa-xmark"></i> Reject' +
                        '</button>' +
                    '</div>' +
                '</div>' +
                '<div class="review-reason-box">' +
                    '<i class="fa-solid fa-quote-left"></i>' +
                    '<span>' + (record.reviewReason || 'No reason provided.') + '</span>' +
                '</div>' +
            '</div>';
        }).join('');

        // Attach approve handlers
        list.querySelectorAll('.review-approve-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                const recordId = btn.getAttribute('data-record-id');
                Swal.fire({
                    title: 'Approve Review?',
                    text: 'This will mark the student as PRESENT.',
                    icon: 'question',
                    iconColor: '#22c55e',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Approve',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#22c55e',
                    customClass: {
                        container: 'shell-enhanced-container',
                        popup: 'shell-enhanced-alert',
                        title: 'shell-enhanced-title',
                        htmlContainer: 'shell-enhanced-text',
                        actions: 'shell-enhanced-actions',
                        confirmButton: 'shell-enhanced-confirm',
                        cancelButton: 'shell-enhanced-cancel'
                    }
                }).then(function(result) {
                    if (!result.isConfirmed) return;
                    fetch('/teacher/reviews/' + recordId + '/approve', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
                        credentials: 'same-origin',
                        body: JSON.stringify({})
                    })
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        if (data.success) {
                            Swal.fire({
                                title: 'Approved!',
                                text: data.message,
                                icon: 'success',
                                timer: 2000,
                                showConfirmButton: false,
                                customClass: {
                                    container: 'shell-enhanced-container',
                                    popup: 'shell-enhanced-alert',
                                    title: 'shell-enhanced-title',
                                    htmlContainer: 'shell-enhanced-text'
                                }
                            });
                            loadPendingReviews();
                        } else {
                            Swal.fire({
                                title: 'Error',
                                text: data.message || 'Could not approve.',
                                icon: 'error',
                                customClass: {
                                    container: 'shell-enhanced-container',
                                    popup: 'shell-enhanced-alert',
                                    title: 'shell-enhanced-title',
                                    htmlContainer: 'shell-enhanced-text'
                                }
                            });
                        }
                    })
                    .catch(function() {
                        Swal.fire({
                            title: 'Error',
                            text: 'Network error.',
                            icon: 'error',
                            customClass: {
                                container: 'shell-enhanced-container',
                                popup: 'shell-enhanced-alert',
                                title: 'shell-enhanced-title',
                                htmlContainer: 'shell-enhanced-text'
                            }
                        });
                    });
                });
            });
        });

        // Attach reject handlers
        list.querySelectorAll('.review-reject-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                const recordId = btn.getAttribute('data-record-id');
                Swal.fire({
                    title: 'Reject Review?',
                    text: 'Student will remain marked ABSENT.',
                    icon: 'warning',
                    iconColor: '#ef4444',
                    input: 'textarea',
                    inputLabel: 'Reason for rejection (optional)',
                    inputPlaceholder: 'e.g. Insufficient proof provided',
                    showCancelButton: true,
                    confirmButtonText: 'Reject',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#dc2626',
                    customClass: {
                        container: 'shell-enhanced-container',
                        popup: 'shell-enhanced-alert attendify-review-modal',
                        title: 'shell-enhanced-title',
                        htmlContainer: 'shell-enhanced-text',
                        inputLabel: 'shell-enhanced-input-label',
                        input: 'shell-enhanced-textarea',
                        actions: 'shell-enhanced-actions',
                        confirmButton: 'shell-enhanced-confirm',
                        cancelButton: 'shell-enhanced-cancel'
                    }
                }).then(function(result) {
                    if (!result.isConfirmed) return;
                    fetch('/teacher/reviews/' + recordId + '/reject', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
                        credentials: 'same-origin',
                        body: JSON.stringify({ rejectReason: result.value || '' })
                    })
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        if (data.success) {
                            Swal.fire({
                                title: 'Rejected',
                                text: data.message,
                                icon: 'info',
                                timer: 2000,
                                showConfirmButton: false,
                                customClass: {
                                    container: 'shell-enhanced-container',
                                    popup: 'shell-enhanced-alert',
                                    title: 'shell-enhanced-title',
                                    htmlContainer: 'shell-enhanced-text'
                                }
                            });
                            loadPendingReviews();
                        } else {
                            Swal.fire({
                                title: 'Error',
                                text: data.message || 'Could not reject.',
                                icon: 'error',
                                customClass: {
                                    container: 'shell-enhanced-container',
                                    popup: 'shell-enhanced-alert',
                                    title: 'shell-enhanced-title',
                                    htmlContainer: 'shell-enhanced-text'
                                }
                            });
                        }
                    })
                    .catch(function() {
                        Swal.fire({
                            title: 'Error',
                            text: 'Network error.',
                            icon: 'error',
                            customClass: {
                                container: 'shell-enhanced-container',
                                popup: 'shell-enhanced-alert',
                                title: 'shell-enhanced-title',
                                htmlContainer: 'shell-enhanced-text'
                            }
                        });
                    });
                });
            });
        });
    }

    function loadPendingReviews() {
        fetch('/teacher/reviews/pending', { credentials: 'same-origin' })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    renderReviews(data.pendingReviews || []);
                }
            })
            .catch(function() {
                // silently fail — non-critical
            });
    }

    document.addEventListener('DOMContentLoaded', loadPendingReviews);
})();
</script>
<script src="/js/pushManager.js"></script>
<script>
document.addEventListener("DOMContentLoaded", async () => {
    const btn = document.getElementById("enablePushBtn");
    if (!btn || !window.PushManagerHelper) return;
    
    const status = await window.PushManagerHelper.init("teacher");
    if (status.supported && !status.subscribed) {
        if (Notification.permission === 'granted') {
            try { await window.PushManagerHelper.subscribe("teacher"); } catch (err) {}
        } else if (Notification.permission === 'default' || !Notification.permission) {
            btn.style.display = "block";
            btn.addEventListener("click", async () => {
                const originalText = btn.innerHTML;
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Enabling...';
                btn.disabled = true;
                try {
                    await window.PushManagerHelper.subscribe("teacher");
                    btn.innerHTML = '<i class="fa-solid fa-check"></i> Enabled';
                    setTimeout(() => btn.style.display = "none", 2000);
                } catch (err) {
                    btn.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> Error';
                    setTimeout(() => { btn.innerHTML = originalText; btn.disabled = false; }, 3000);
                }
            });
        }
    }
});
</script>
</html>
