<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Waiting for Approval | Attendify</title>
    <link rel="stylesheet" href="/css/uiShell.css">
    <link rel="stylesheet" href="/css/authPages.css?v=20260901_3">
    <link rel="stylesheet" href="/css/attendifyDarkFix.css?v=8">
    <link rel="stylesheet" href="/css/attendifyUIOverhaulExtra.css?v=19">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="icon" type="image/png" href="/favicon.png">

    <style>
        .waiting-pod {
            text-align: center;
            padding: 44px 32px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .waiting-radar-wrap {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            background: rgba(99, 102, 241, 0.15);
            border: 2px solid rgba(99, 102, 241, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            margin-bottom: 24px;
            box-shadow: 0 0 30px rgba(99, 102, 241, 0.35);
        }

        .waiting-radar-ping {
            position: absolute;
            inset: -8px;
            border-radius: 50%;
            border: 1px solid rgba(99, 102, 241, 0.6);
            animation: pulseWave 2s infinite ease-out;
            pointer-events: none;
        }

        @keyframes pulseWave {
            0% { transform: scale(0.9); opacity: 1; }
            100% { transform: scale(1.4); opacity: 0; }
        }

        .waiting-radar-icon {
            font-size: 2.4rem;
            color: #818cf8;
            transition: all 0.3s ease;
        }

        .waiting-status-pill {
            font-family: "JetBrains Mono", monospace;
            font-size: 0.72rem;
            font-weight: 700;
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.35);
            color: #34d399;
            padding: 4px 12px;
            border-radius: 999px;
            margin-top: 20px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .waiting-spinner-ring {
            width: 22px;
            height: 22px;
            border: 2.5px solid rgba(255, 255, 255, 0.15);
            border-top-color: #38bdf8;
            border-radius: 50%;
            animation: spin 0.9s linear infinite;
            margin-top: 18px;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>

    <!-- SweetAlert2 for Custom UI Alerts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" defer></script>
    <script src="/js/customAlerts.js" defer></script>

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#6366f1">
    <link rel="apple-touch-icon" href="/icon-192.png">

    <% if (typeof csrfToken !== "undefined") { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
    <% if (typeof realtimeMode !== "undefined") { %>
    <script>
    window.AttendifyRealtimeConfig = {
        mode: <%- JSON.stringify(realtimeMode) %>,
        pollIntervalMs: <%= typeof realtimePollIntervalMs !== "undefined" ? realtimePollIntervalMs : 5000 %>
    };
    </script>
    <% } %>
</head>
<body class="auth-redesign-body">

<div class="auth-bg-ambient">
    <div class="auth-grid-overlay"></div>
</div>

<div class="auth-container" style="max-width: 640px;">
    <div class="auth-card-split" style="grid-template-columns: 1fr;">

        <div class="waiting-pod">
            <div class="waiting-radar-wrap">
                <div class="waiting-radar-ping"></div>
                <i id="waiting-status-icon" class="fa-solid fa-clock-rotate-left waiting-radar-icon"></i>
            </div>

            <span class="auth-role-pill student" style="margin-bottom: 8px;">
                <i class="fa-solid fa-hourglass-half"></i> APPROVAL PENDING
            </span>

            <h2 id="waiting-status-title" style="font-family: 'Outfit', sans-serif; font-size: 1.8rem; font-weight: 800; color: #ffffff; margin-bottom: 8px;">
                Waiting for Admin Approval
            </h2>

            <p style="color: var(--auth-muted); font-size: 0.92rem; line-height: 1.6; max-width: 480px; margin: 0 auto;">
                Welcome, <strong><%= student.fullName %></strong>! Your registration has been submitted. 
                Please keep this window open — you will be automatically redirected the moment your college administrator approves your account.
            </p>

            <div class="waiting-spinner-ring" id="waitingSpinner"></div>

            <div class="waiting-status-pill" id="status-pill">
                <span style="width: 6px; height: 6px; border-radius: 50%; background: #10b981; animation: blipPulse 1.8s infinite;"></span>
                <span id="status-text">Verifying real-time connection...</span>
            </div>

            <div class="auth-structured-footer" style="width: 100%; margin-top: 32px;">
                <div class="footer-nav-row" style="justify-content: center;">
                    <a href="/" class="footer-nav-btn"><i class="fa-solid fa-arrow-left"></i> Back to Home</a>
                </div>
            </div>
        </div>

    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        var studentId = "<%= student._id %>";
        var statusText = document.getElementById("status-text");
        var statusIcon = document.getElementById("waiting-status-icon");
        var statusTitle = document.getElementById("waiting-status-title");
        var spinner = document.getElementById("waitingSpinner");
        var redirecting = false;

        function doRedirect(redirectUrl) {
            if (redirecting) return;
            redirecting = true;
            if (typeof pollTimer !== 'undefined' && pollTimer) clearInterval(pollTimer);
            
            if (spinner) spinner.style.display = "none";
            
            if (statusIcon) {
                statusIcon.className = "fa-solid fa-circle-check waiting-radar-icon";
                statusIcon.style.color = "#10b981";
            }

            if (statusTitle) {
                statusTitle.textContent = "Registration Approved!";
            }
            if (statusText) {
                statusText.textContent = "Redirecting to login...";
                statusText.style.color = "#10b981";
            }

            var url = redirectUrl ? redirectUrl : "/student/login?message=approved";
            setTimeout(function() {
                window.location.href = url;
            }, 600);
        }

        // Socket connection
        try {
            var socket = io({ query: { waitingId: studentId } });

            socket.on("connect", function() {
                if (!redirecting && statusText) {
                    statusText.textContent = "Real-Time Verification Active • Awaiting confirmation...";
                }
            });

            socket.on("student:approved", function(data) {
                doRedirect(data && data.redirectUrl ? data.redirectUrl : null);
            });

            socket.on("disconnect", function() {
                if (!redirecting && statusText) {
                    statusText.textContent = "Checking approval status...";
                }
            });
        } catch (e) {
            console.log("Socket connection fallback:", e);
        }

        // Polling fallback
        function checkApproval() {
            if (redirecting) return;
            if (typeof socket !== "undefined" && socket.connected) return;

            fetch("/student/check-approval/" + studentId)
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    if (data && data.approved) {
                        doRedirect(data.redirectUrl || null);
                    }
                })
                .catch(function(err) {
                    console.log("Poll check failed:", err);
                });
        }

        var pollTimer = setInterval(checkApproval, 5000);
        checkApproval();
    });
</script>

<script src="/js/csrfAuto.js" defer></script>
<script src="/js/selectEnhancer.js" defer></script>
</body>
</html>
