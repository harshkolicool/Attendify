<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notifications & Passkeys | Admin</title>

    <link rel="stylesheet" href="/css/uiShell.css?v=20260901_fixed4">
    <link rel="stylesheet" href="/css/adminDashboard.css?v=20260901_fixed4">
    <link rel="stylesheet" href="/css/attendifyAdminTheme.css?v=20260901_fixed4">
    <link rel="stylesheet" href="/css/attendifyDarkFix.css?v=20260901_fixed4">
    <link rel="stylesheet" href="/css/attendifyUIOverhaul.css?v=20260901_fixed4">
    <link rel="stylesheet" href="/css/attendifyUIOverhaulExtra.css?v=20260901_fixed4">

    <style>
    /* Modern Admin Card Header */
    .admin-card .admin-card-head {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        justify-content: space-between !important;
        gap: 16px !important;
        flex-wrap: wrap !important;
        margin-bottom: 16px !important;
        width: 100% !important;
    }

    .admin-card-head-title {
        display: flex !important;
        align-items: center !important;
        gap: 14px !important;
        flex: 1 1 auto !important;
        min-width: 240px !important;
    }

    .adm-head-icon-box {
        width: 42px !important;
        height: 42px !important;
        min-width: 42px !important;
        border-radius: 12px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        font-size: 1.2rem !important;
        flex-shrink: 0 !important;
    }

    .adm-head-icon-box.passkey {
        background: rgba(99, 102, 241, 0.15) !important;
        color: #818cf8 !important;
        border: 1px solid rgba(99, 102, 241, 0.3) !important;
        box-shadow: 0 4px 14px rgba(99, 102, 241, 0.18) !important;
    }

    .adm-head-icon-box.inbox {
        background: rgba(14, 165, 233, 0.15) !important;
        color: #38bdf8 !important;
        border: 1px solid rgba(14, 165, 233, 0.3) !important;
        box-shadow: 0 4px 14px rgba(14, 165, 233, 0.18) !important;
    }

    .admin-card-head-title h3 {
        margin: 0 !important;
        font-size: 1.12rem !important;
        font-weight: 800 !important;
        color: #ffffff !important;
        letter-spacing: -0.01em !important;
    }

    .admin-card-head-title p {
        margin: 3px 0 0 0 !important;
        font-size: 0.84rem !important;
        color: #94a3b8 !important;
    }

    .admin-card-head .adm-head-status-group,
    .admin-card-head .notification-head-actions {
        margin-left: auto !important;
        display: flex !important;
        align-items: center !important;
        justify-content: flex-end !important;
        gap: 10px !important;
        flex: 0 0 auto !important;
    }

    .admin-count-pill {
        display: inline-flex !important;
        align-items: center !important;
        gap: 6px !important;
        padding: 5px 13px !important;
        border-radius: 999px !important;
        font-size: 0.8rem !important;
        font-weight: 800 !important;
        white-space: nowrap !important;
    }

    .admin-count-pill.emerald {
        background: rgba(16, 185, 129, 0.14) !important;
        color: #34d399 !important;
        border: 1px solid rgba(16, 185, 129, 0.3) !important;
    }

    .admin-count-pill.amber {
        background: rgba(245, 158, 11, 0.14) !important;
        color: #fbbf24 !important;
        border: 1px solid rgba(245, 158, 11, 0.3) !important;
    }

    .admin-count-pill.indigo {
        background: rgba(99, 102, 241, 0.14) !important;
        color: #a5b4fc !important;
        border: 1px solid rgba(99, 102, 241, 0.3) !important;
    }

    /* Notification Card & Actions Responsiveness */
    .notification-list {
        display: flex !important;
        flex-direction: column !important;
        gap: 12px !important;
    }

    .notification-card {
        border-radius: 16px !important;
        background: rgba(15, 23, 42, 0.45) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        padding: 18px 20px !important;
        display: flex !important;
        flex-direction: column !important;
        gap: 8px !important;
        transition: all 0.2s ease !important;
    }

    .notification-card.unread {
        border-color: rgba(99, 102, 241, 0.3) !important;
        background: rgba(30, 41, 59, 0.55) !important;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25) !important;
    }

    .notification-top {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        justify-content: space-between !important;
        gap: 12px !important;
        width: 100% !important;
    }

    .notification-top h4 {
        margin: 0 !important;
        font-size: 1.05rem !important;
        font-weight: 700 !important;
        color: #ffffff !important;
        text-align: left !important;
    }

    .notification-top span {
        font-size: 0.8rem !important;
        color: #94a3b8 !important;
        white-space: nowrap !important;
    }

    .notification-card > p {
        margin: 4px 0 10px 0 !important;
        font-size: 0.9rem !important;
        color: #cbd5e1 !important;
        line-height: 1.5 !important;
        text-align: left !important;
    }

    .notification-meta {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        justify-content: space-between !important;
        gap: 12px !important;
        border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
        padding-top: 14px !important;
        margin-top: 6px !important;
        flex-wrap: wrap !important;
        width: 100% !important;
    }

    .notification-meta .admin-badge {
        margin: 0 !important;
        font-size: 0.74rem !important;
        font-weight: 800 !important;
        padding: 5px 12px !important;
        border-radius: 999px !important;
        flex: 0 0 auto !important;
    }

    .notification-action-buttons {
        display: inline-flex !important;
        align-items: center !important;
        gap: 8px !important;
        flex-wrap: wrap !important;
        margin-left: auto !important;
    }

    .notification-action-buttons form {
        margin: 0 !important;
        display: inline-block !important;
        width: auto !important;
        flex: 0 0 auto !important;
    }

    .notification-action-buttons a,
    .notification-action-buttons button,
    .notification-open-link,
    .notification-action-btn,
    .notification-delete-btn {
        width: auto !important;
        min-width: 0 !important;
        max-width: none !important;
        height: 36px !important;
        padding: 0 14px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 6px !important;
        font-size: 0.82rem !important;
        font-weight: 700 !important;
        border-radius: 9px !important;
        flex: 0 0 auto !important;
        box-sizing: border-box !important;
    }

    .notification-open-link {
        background: rgba(99, 102, 241, 0.15) !important;
        color: #818cf8 !important;
        border: 1px solid rgba(99, 102, 241, 0.3) !important;
        text-decoration: none !important;
    }

    .notification-open-link:hover {
        background: rgba(99, 102, 241, 0.25) !important;
        color: #a5b4fc !important;
    }

    .notification-action-btn {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
        color: #ffffff !important;
        border: none !important;
        cursor: pointer !important;
    }

    .notification-delete-btn {
        background: rgba(239, 68, 68, 0.12) !important;
        color: #f87171 !important;
        border: 1px solid rgba(239, 68, 68, 0.25) !important;
        cursor: pointer !important;
    }

    .notification-delete-btn:hover {
        background: rgba(239, 68, 68, 0.22) !important;
        color: #fca5a5 !important;
    }

    /* Mobile Media Queries (< 768px) */
    @media (max-width: 768px) {
        .admin-card .admin-card-head {
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 12px !important;
        }

        .admin-card-head-title {
            width: 100% !important;
            min-width: 0 !important;
        }

        .admin-card-head .adm-head-status-group,
        .admin-card-head .notification-head-actions {
            width: 100% !important;
            margin-left: 0 !important;
            justify-content: flex-start !important;
            flex-wrap: wrap !important;
            gap: 8px !important;
        }

        .admin-card-head .notification-head-actions form,
        .admin-card-head .notification-head-actions button,
        .admin-card-head .notification-head-actions a {
            width: auto !important;
            flex: 0 0 auto !important;
        }

        .adm-radar-grid {
            grid-template-columns: repeat(2, 1fr) !important;
            gap: 10px !important;
        }

        .adm-radar-card {
            padding: 12px 14px !important;
        }

        .admin-empty-compact-bar {
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 12px !important;
            padding: 12px 14px !important;
        }
    }

    @media (max-width: 480px) {
        .adm-radar-grid {
            grid-template-columns: 1fr !important;
        }

        .notification-top {
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 4px !important;
        }

        .notification-meta {
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 10px !important;
        }

        .notification-action-buttons {
            width: 100% !important;
            margin-left: 0 !important;
            justify-content: flex-start !important;
            gap: 8px !important;
        }

        .notification-action-buttons form,
        .notification-action-buttons a,
        .notification-action-buttons button {
            flex: 1 1 auto !important;
        }
    }
    </style>

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >
    <link rel="icon" type="image/png" href="/favicon.png">

    <!-- SweetAlert2 for Custom UI Alerts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" defer></script>
    <script src="/js/customAlerts.js" defer></script>

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#4f46e5">
    <link rel="apple-touch-icon" href="/icon-192.png">
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/service-worker.js');
            });
        }
    </script>

    <% if (typeof csrfToken !== "undefined") { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
    <% if (typeof realtimeMode !== "undefined") { %>
    <script>
    window.AttendifyRealtimeConfig = {
        mode: <%- JSON.stringify(realtimeMode) %>,
        pollIntervalMs: <%= typeof realtimePollIntervalMs !== "undefined" ? realtimePollIntervalMs : 5000 %>
    };
    </script>
    <% } %>
</head>
<body>

<%
    const safeNotifications = (typeof notifications !== "undefined" && notifications) ? notifications : [];
    const safePasskeyRequests = (typeof pendingPasskeyRequests !== "undefined" && pendingPasskeyRequests) ? pendingPasskeyRequests : [];
    const safeUnreadCount = (typeof unreadCount !== "undefined") ? unreadCount : safeNotifications.filter(n => !n.isRead).length;
%>

<div class="admin-layout">
    <%- include("partials/sidebar", { activePage: "notifications", currentCollege: typeof college !== "undefined" ? college : null }) %>

    <main class="admin-main">
        <header class="admin-header">
            <div>
                <span class="admin-kicker">Admin Panel</span>
                <h1>Security Alerts & Notification Hub</h1>
                <p>Approve student biometric passkey enrollment requests and monitor real-time security events.</p>
            </div>
        </header>

        <% if (typeof message !== "undefined" && message) { %>
            <% const adminNotificationFlash = String(message || "").toLowerCase(); %>
            <div class="admin-alert <%= adminNotificationFlash.includes('success') || adminNotificationFlash.includes('approved') || adminNotificationFlash.includes('rejected') || adminNotificationFlash.includes('read') || adminNotificationFlash.includes('deleted') || adminNotificationFlash.includes('cleared') ? 'success' : 'error' %>">
                <%= message %>
            </div>
        <% } %>

        <!-- OVERVIEW STAT RADAR CARDS -->
        <section class="adm-radar-grid">
            <div class="adm-radar-card">
                <div class="adm-radar-icon room">
                    <i class="fa-solid fa-bell"></i>
                </div>
                <div class="adm-radar-info">
                    <span class="adm-radar-label">Total Dispatches</span>
                    <span class="adm-radar-val"><%= safeNotifications.length %> Alerts</span>
                </div>
            </div>

            <div class="adm-radar-card">
                <div class="adm-radar-icon <%= safePasskeyRequests.length > 0 ? 'gps' : 'security' %>">
                    <i class="fa-solid fa-key"></i>
                </div>
                <div class="adm-radar-info">
                    <span class="adm-radar-label">Passkey Approvals</span>
                    <span class="adm-radar-val" style="color: <%= safePasskeyRequests.length > 0 ? '#f59e0b' : '#10b981' %>;"><%= safePasskeyRequests.length %> Pending</span>
                </div>
            </div>

            <div class="adm-radar-card">
                <div class="adm-radar-icon <%= safeUnreadCount > 0 ? 'dept' : 'sync' %>">
                    <i class="fa-solid fa-inbox"></i>
                </div>
                <div class="adm-radar-info">
                    <span class="adm-radar-label">Unread Inbox</span>
                    <span class="adm-radar-val" style="color: <%= safeUnreadCount > 0 ? '#6366f1' : '#10b981' %>;"><%= safeUnreadCount %> Unread</span>
                </div>
            </div>

            <div class="adm-radar-card">
                <div class="adm-radar-icon security">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div class="adm-radar-info">
                    <span class="adm-radar-label">Audit Engine</span>
                    <span class="adm-radar-val" style="color: #10b981;">100% Guarded</span>
                </div>
            </div>
        </section>

        <!-- PENDING PASSKEY REQUESTS -->
        <section class="admin-card admin-passkey-pending-card">
            <div class="admin-card-head">
                <div class="admin-card-head-title">
                    <div class="adm-head-icon-box passkey">
                        <i class="fa-solid fa-fingerprint"></i>
                    </div>
                    <div>
                        <h3>Pending Passkey Requests</h3>
                        <p>Students waiting for biometric passkey authorization to take attendance securely.</p>
                    </div>
                </div>

                <div class="adm-head-status-group">
                    <span class="admin-count-pill <%= safePasskeyRequests.length > 0 ? 'amber' : 'emerald' %>">
                        <i class="fa-solid <%= safePasskeyRequests.length > 0 ? 'fa-clock' : 'fa-shield-check' %>"></i>
                        <%= safePasskeyRequests.length %> Pending
                    </span>
                </div>
            </div>

            <% if (safePasskeyRequests.length === 0) { %>
                <div class="admin-empty-compact-bar passkey">
                    <div class="empty-compact-left">
                        <div class="empty-compact-orb emerald">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                        <div class="empty-compact-text">
                            <strong>All Biometric Passkeys Synchronized</strong>
                            <span>No students awaiting authorization &bull; All credentials active</span>
                        </div>
                    </div>
                    <div class="empty-compact-chip emerald">
                        <span class="pulse-dot green"></span>
                        <span>Zero Backlog</span>
                    </div>
                </div>
            <% } else { %>
                <div class="admin-grid">
                    <% safePasskeyRequests.forEach(function(request) { %>
                        <article class="admin-item-card">
                            <h4><%= request.student ? request.student.fullName : "Student" %></h4>
                            <p><%= request.student ? request.student.enrollmentNumber : "-" %></p>

                            <div class="admin-meta">
                                <span class="admin-badge" style="background: rgba(99, 102, 241, 0.12); color: #6366f1; font-weight: 700;">
                                    <i class="fa-solid fa-graduation-cap"></i>
                                    <%= request.student && request.student.classGroup && request.student.classGroup.name ? request.student.classGroup.name : "Class Group" %>
                                </span>
                                <span class="admin-badge">
                                    <i class="fa-solid fa-clock"></i> <%= new Date(request.requestedAt || request.createdAt).toLocaleString() %>
                                </span>
                            </div>

                            <div class="admin-passkey-actions" style="margin-top: 14px; display: flex; gap: 10px; flex-wrap: wrap;">
                                <form action="/admin/passkey-requests/<%= request._id %>/approve" method="POST" style="flex: 1;">
                                    <button class="admin-primary-btn" type="submit" style="width: 100%; justify-content: center; background: linear-gradient(135deg, #10b981 0%, #059669 100%);">
                                        <i class="fa-solid fa-circle-check"></i>
                                        Approve (30m)
                                    </button>
                                </form>

                                <form action="/admin/passkey-requests/<%= request._id %>/reject" method="POST" style="flex: 1;">
                                    <div class="admin-passkey-reject-group" style="display: flex; gap: 6px;">
                                        <input
                                            type="text"
                                            name="reviewNote"
                                            placeholder="Reason (optional)"
                                            style="font-size: 0.82rem; height: 38px;"
                                        >
                                        <button class="admin-warning-btn" type="submit" style="height: 38px; white-space: nowrap;">
                                            <i class="fa-solid fa-circle-xmark"></i>
                                            Reject
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } %>
        </section>

        <!-- NOTIFICATION INBOX -->
        <section class="admin-card">
            <div class="admin-card-head">
                <div class="admin-card-head-title">
                    <div class="adm-head-icon-box inbox">
                        <i class="fa-solid fa-inbox"></i>
                    </div>
                    <div>
                        <h3>Notification Inbox</h3>
                        <p>Recent audit dispatches, attendance anomaly alerts, and system notices.</p>
                    </div>
                </div>

                <div class="notification-head-actions" style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                    <span class="admin-count-pill <%= safeUnreadCount > 0 ? 'indigo' : 'emerald' %>">
                        <i class="fa-solid <%= safeUnreadCount > 0 ? 'fa-bell' : 'fa-check' %>"></i>
                        <%= safeUnreadCount %> Unread
                    </span>

                    <form action="/admin/notifications/mark-all-read" method="POST">
                        <button class="admin-secondary-btn" type="submit" style="font-size: 0.82rem;">
                            <i class="fa-solid fa-check-double"></i>
                            Mark All Read
                        </button>
                    </form>

                    <form
                        action="/admin/notifications/clear-all"
                        method="POST"
                        onsubmit="return uiConfirm(event, 'Clear all notifications? This cannot be undone.')"
                    >
                        <button class="admin-warning-btn notification-delete-btn" type="submit" style="font-size: 0.82rem;">
                            <i class="fa-solid fa-trash"></i>
                            Clear All
                        </button>
                    </form>
                </div>
            </div>

            <% if (safeNotifications.length === 0) { %>
                <div class="admin-empty-compact-bar inbox">
                    <div class="empty-compact-left">
                        <div class="empty-compact-orb indigo">
                            <i class="fa-solid fa-envelope-open-text"></i>
                        </div>
                        <div class="empty-compact-text">
                            <strong>Notification Inbox is Clear</strong>
                            <span>All audit dispatches and system notices have been reviewed</span>
                        </div>
                    </div>
                    <div class="empty-compact-chip indigo">
                        <span class="pulse-dot indigo"></span>
                        <span>All Clear</span>
                    </div>
                </div>
            <% } else { %>
                <div class="notification-list">
                    <% safeNotifications.forEach(function(notification) { %>
                        <article class="notification-card <%= notification.isRead ? 'read' : 'unread' %>">
                            <div class="notification-top">
                                <h4><%= notification.title %></h4>
                                <span><%= new Date(notification.createdAt).toLocaleString() %></span>
                            </div>

                            <p><%= notification.message %></p>

                            <div class="notification-meta">
                                <span class="admin-badge" style="background: rgba(99, 102, 241, 0.12); color: #6366f1; font-weight: 700;"><%= notification.category || "GENERAL" %></span>

                                <div class="notification-action-buttons">
                                    <% if (notification.link) { %>
                                        <a class="admin-secondary-btn notification-open-link" href="<%= notification.link %>">
                                            <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                            Open
                                        </a>
                                    <% } %>

                                    <% if (!notification.isRead) { %>
                                        <form action="/admin/notifications/<%= notification.id %>/read" method="POST">
                                            <button class="admin-primary-btn notification-action-btn" type="submit">
                                                <i class="fa-solid fa-check"></i>
                                                Mark Read
                                            </button>
                                        </form>
                                    <% } %>

                                    <form
                                        action="/admin/notifications/<%= notification.id %>/delete"
                                        method="POST"
                                        onsubmit="return uiConfirm(event, 'Delete this notification?')"
                                    >
                                        <button class="admin-warning-btn notification-delete-btn notification-action-btn" type="submit">
                                            <i class="fa-solid fa-trash"></i>
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } %>
        </section>
    </main>
</div>

<script src="/js/uiShell.js"></script>

    <script src="/js/csrfAuto.js" defer></script>
    <script src="/js/selectEnhancer.js?v=3" defer></script>
    <script src="/js/adminRealtime.js"></script>
</body>
</html>
