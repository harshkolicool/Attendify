<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login | Attendify</title>
    
    <link rel="stylesheet" href="/css/uiShell.css">
    <link rel="stylesheet" href="/css/authPages.css?v=20260901_1">
    <link rel="stylesheet" href="/css/attendifyDarkFix.css?v=8">
    <link rel="stylesheet" href="/css/attendifyUIOverhaulExtra.css?v=19">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="icon" type="image/png" href="/favicon.png">

    <!-- SweetAlert2 for Custom UI Alerts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" defer></script>
    <script src="/js/customAlerts.js" defer></script>

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#8b5cf6">
    <link rel="apple-touch-icon" href="/icon-192.png">

    <% if (typeof csrfToken !== "undefined") { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
    <% if (typeof realtimeMode !== "undefined") { %>
    <script>
    window.AttendifyRealtimeConfig = {
        mode: <%- JSON.stringify(realtimeMode) %>,
        pollIntervalMs: <%= typeof realtimePollIntervalMs !== "undefined" ? realtimePollIntervalMs : 5000 %>
    };
    </script>
    <% } %>
</head>
<body class="auth-redesign-body">

<div class="auth-bg-ambient">
    <div class="auth-grid-overlay"></div>
</div>

<div class="auth-container">
    <div class="auth-card-split">

        <!-- LEFT BRAND PANEL -->
        <aside class="auth-hero-pane admin">
            <div class="auth-brand-top">
                <a href="/" class="auth-brand-header">
                    <span class="auth-brand-icon admin">
                        <i class="fa-solid fa-shield-halved"></i>
                    </span>
                    <span class="auth-brand-title">ATTENDIFY</span>
                </a>
            </div>

            <div class="auth-hero-body">
                <span class="auth-role-pill admin">
                    <i class="fa-solid fa-user-shield"></i> COLLEGE ADMIN
                </span>
                <h2>Institutional Management</h2>
                <p>Configure academic departments, map classroom GPS bounds, manage faculty assignments, and oversee campus attendance.</p>
            </div>

            <ul class="auth-perks-list admin">
                <li><i class="fa-solid fa-check"></i> Department & Classroom GPS Boundary Mapping</li>
                <li><i class="fa-solid fa-check"></i> Faculty & Timetable Schedule Controls</li>
                <li><i class="fa-solid fa-check"></i> Institutional Multi-Class Reports & Audit Logs</li>
            </ul>
        </aside>

        <!-- RIGHT FORM CARD -->
        <div class="auth-form-pane">
            <div>
                <div class="auth-form-header">
                    <div class="auth-icon-badge admin">
                        <i class="fa-solid fa-user-shield"></i>
                    </div>
                    <h3>College Admin Login</h3>
                    <p>Enter your institutional administrator credentials</p>
                </div>

                <% if (typeof error !== "undefined" && error) { %>
                    <div class="auth-alert-box">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <form action="/admin/login" method="POST" class="modern-auth-form">
                    <div class="form-group-modern">
                        <label for="adminEmail">Administrator Email</label>
                        <div class="input-field-wrap">
                            <i class="fa-regular fa-envelope field-icon"></i>
                            <input type="email" id="adminEmail" name="email" placeholder="admin@college.edu" required autocomplete="email">
                        </div>
                    </div>

                    <div class="form-group-modern">
                        <label for="adminPassword">Password</label>
                        <div class="input-field-wrap">
                            <i class="fa-solid fa-lock field-icon"></i>
                            <input type="password" id="adminPassword" name="password" placeholder="Enter password" required autocomplete="current-password">
                            <button type="button" class="password-toggle-btn" aria-label="Toggle password visibility">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="auth-submit-btn admin">
                        <i class="fa-solid fa-arrow-right-to-bracket"></i>
                        <span>Sign In as Admin</span>
                    </button>
                </form>
            </div>

            <div class="auth-card-footer">
                <a href="/"><i class="fa-solid fa-arrow-left"></i> Home</a>
                <span>Need an account? <a href="/college/register" class="role-switch-link">Register College</a></span>
                <a href="/teacher/login" class="role-switch-link">Teacher Login <i class="fa-solid fa-arrow-right"></i></a>
            </div>
        </div>

    </div>
</div>

<script src="/js/authHelper.js" defer></script>
<script src="/js/csrfAuto.js" defer></script>
<script src="/js/selectEnhancer.js" defer></script>
</body>
</html>
