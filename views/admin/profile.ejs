<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administrator Profile | Attendify</title>

    <link rel="stylesheet" href="/css/uiShell.css?v=20260901_fixed3">
    <link rel="stylesheet" href="/css/attendifyAdminTheme.css?v=2">
    <link rel="stylesheet" href="/css/attendifyDarkFix.css?v=8">
    <link rel="stylesheet" href="/css/attendifyUIOverhaul.css?v=2">
    <link rel="stylesheet" href="/css/attendifyUIOverhaulExtra.css?v=19">
    <link rel="stylesheet" href="/css/profilePage.css?v=20260901c">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >
    <link rel="icon" type="image/png" href="/favicon.png">

    <!-- SweetAlert2 for Custom UI Alerts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" defer></script>
    <script src="/js/customAlerts.js" defer></script>

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#4f46e5">
    <link rel="apple-touch-icon" href="/icon-192.png">

    <% if (typeof csrfToken !== "undefined") { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
    <% if (typeof realtimeMode !== "undefined") { %>
    <script>
    window.AttendifyRealtimeConfig = {
        mode: <%- JSON.stringify(realtimeMode) %>,
        pollIntervalMs: <%= typeof realtimePollIntervalMs !== "undefined" ? realtimePollIntervalMs : 5000 %>
    };
    </script>
    <% } %>
</head>
<body>

<%
    const safeAdmin = (typeof admin !== "undefined" && admin) ? admin : (typeof user !== "undefined" ? user : {});
    const safeCollege = (typeof college !== "undefined" && college) ? college : (typeof currentCollege !== "undefined" ? currentCollege : null);
    const safeCounts = (typeof counts !== "undefined" && counts) ? counts : { students: 0, teachers: 0, classGroups: 0, schedules: 0, classrooms: 0, subjects: 0 };
    const adminInitial = (safeAdmin.fullName || "Admin").charAt(0).toUpperCase();
%>

<div class="admin-layout">

    <%- include("partials/sidebar", { activePage: "profile", currentCollege: safeCollege }) %>

    <main class="admin-main">

        <header class="admin-header">
            <div>
                <span class="admin-kicker">Admin Panel</span>
                <h1>Administrator Profile</h1>
                <p>Manage administrative credentials, security keys, and institutional campus capacity.</p>
            </div>
        </header>

        <% if (typeof message !== "undefined" && message) { %>
            <div class="admin-alert <%= message && message.includes('success') ? 'success' : 'error' %>">
                <%= message %>
            </div>
        <% } %>

        <!-- EXECUTIVE PROFILE HERO CARD -->
        <section class="profile-hero platform-admin-hero" style="margin-bottom: 24px;">
            <div class="profile-hero-content">
                <div class="profile-hero-avatar-wrap">
                    <div class="profile-hero-avatar">
                        <%= adminInitial %>
                    </div>
                    <span class="profile-avatar-badge" title="Verified College Administrator">
                        <i class="fa-solid fa-shield-halved"></i>
                    </span>
                </div>

                <div class="profile-hero-info">
                    <div class="profile-hero-header-row">
                        <h1><%= safeAdmin.fullName || "Administrator" %></h1>
                        <span class="profile-hero-badge super-admin">
                            <i class="fa-solid fa-building-columns"></i> College Admin
                        </span>
                    </div>

                    <p class="profile-hero-email">
                        <span><i class="fa-regular fa-envelope"></i> <%= safeAdmin.email || "admin@institution.edu" %></span>
                        <span class="profile-hero-dot">·</span>
                        <span class="profile-hero-access"><i class="fa-solid fa-id-badge"></i> ID: <%= safeAdmin.employeeId || "ADM-01" %></span>
                        <% if (safeCollege) { %>
                            <span class="profile-hero-dot">·</span>
                            <span class="profile-hero-access"><i class="fa-solid fa-landmark"></i> <%= safeCollege.collegeName %> (<%= safeCollege.collegeCode %>)</span>
                        <% } %>
                    </p>
                </div>
            </div>

            <div class="profile-hero-status-tag">
                <span class="status-pulse-dot"></span>
                <span>Active Administrator</span>
            </div>
        </section>

        <!-- OVERVIEW STAT RADAR CARDS -->
        <section class="adm-radar-grid">
            <div class="adm-radar-card">
                <div class="adm-radar-icon room">
                    <i class="fa-solid fa-user-graduate"></i>
                </div>
                <div class="adm-radar-info">
                    <span class="adm-radar-label">Enrolled Students</span>
                    <span class="adm-radar-val"><%= safeCounts.students %> Students</span>
                </div>
            </div>

            <div class="adm-radar-card">
                <div class="adm-radar-icon security">
                    <i class="fa-solid fa-chalkboard-user"></i>
                </div>
                <div class="adm-radar-info">
                    <span class="adm-radar-label">Faculty Members</span>
                    <span class="adm-radar-val"><%= safeCounts.teachers %> Professors</span>
                </div>
            </div>

            <div class="adm-radar-card">
                <div class="adm-radar-icon sync">
                    <i class="fa-solid fa-layer-group"></i>
                </div>
                <div class="adm-radar-info">
                    <span class="adm-radar-label">Class Cohorts</span>
                    <span class="adm-radar-val"><%= safeCounts.classGroups %> Groups</span>
                </div>
            </div>

            <div class="adm-radar-card">
                <div class="adm-radar-icon dept">
                    <i class="fa-solid fa-calendar-days"></i>
                </div>
                <div class="adm-radar-info">
                    <span class="adm-radar-label">Active Schedules</span>
                    <span class="adm-radar-val"><%= safeCounts.schedules %> Lectures</span>
                </div>
            </div>
        </section>

        <!-- ACTIONS ROW -->
        <section class="admin-card" style="margin-bottom: 24px; padding: 18px 22px;">
            <div style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center; justify-content: space-between;">
                <div style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
                    <a href="/admin/dashboard" class="admin-secondary-btn">
                        <i class="fa-solid fa-chart-line"></i> Dashboard
                    </a>
                    <a href="/admin/change-password" class="admin-secondary-btn">
                        <i class="fa-solid fa-key"></i> Change Password
                    </a>
                    <a href="/admin/notifications" class="admin-secondary-btn">
                        <i class="fa-solid fa-bell"></i> Notifications
                    </a>
                    <button type="button" class="admin-secondary-btn js-theme-toggle">
                        <i class="fa-solid fa-moon"></i> Toggle Theme
                    </button>
                </div>

                <form action="/logout" method="POST" style="margin: 0;">
                    <button type="submit" class="admin-secondary-btn danger">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i> Log Out
                    </button>
                </form>
            </div>
        </section>

        <!-- ACCOUNT & INSTITUTIONAL DETAILS -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 20px; margin-bottom: 24px;">

            <!-- ADMINISTRATOR IDENTITY CARD -->
            <section class="admin-card" style="margin-bottom: 0;">
                <div class="admin-card-head">
                    <div>
                        <h3><i class="fa-solid fa-id-card" style="color: #6366f1; margin-right: 8px;"></i> Administrator Identity</h3>
                        <p>Core credentials and system privilege assignments.</p>
                    </div>
                </div>

                <ul class="profile-field-list" style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px;">
                    <li style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
                        <span style="font-size: 0.86rem; color: #94a3b8; font-weight: 600;">Full Name</span>
                        <strong style="font-size: 0.95rem;"><%= safeAdmin.fullName %></strong>
                    </li>
                    <li style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
                        <span style="font-size: 0.86rem; color: #94a3b8; font-weight: 600;">Email Address</span>
                        <span style="font-size: 0.9rem; font-family: monospace; opacity: 0.9;"><%= safeAdmin.email %></span>
                    </li>
                    <li style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
                        <span style="font-size: 0.86rem; color: #94a3b8; font-weight: 600;">Employee ID</span>
                        <span class="admin-badge" style="background: rgba(99, 102, 241, 0.12); color: #6366f1; font-weight: 800;"><%= safeAdmin.employeeId || "ADM-01" %></span>
                    </li>
                    <li style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
                        <span style="font-size: 0.86rem; color: #94a3b8; font-weight: 600;">Role Privilege</span>
                        <span class="admin-badge gold" style="background: rgba(245, 158, 11, 0.15); color: #d97706; font-weight: 800;"><i class="fa-solid fa-shield-halved"></i> College Admin</span>
                    </li>
                    <li style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
                        <span style="font-size: 0.86rem; color: #94a3b8; font-weight: 600;">Department</span>
                        <span style="font-size: 0.9rem; font-weight: 600;"><%= safeAdmin.department || "Academic Administration" %></span>
                    </li>
                    <li style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-size: 0.86rem; color: #94a3b8; font-weight: 600;">Member Since</span>
                        <span style="font-size: 0.9rem; color: #94a3b8;">
                            <%= safeAdmin.createdAt ? new Date(safeAdmin.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : "Active" %>
                        </span>
                    </li>
                </ul>
            </section>

            <!-- INSTITUTIONAL OVERVIEW CARD -->
            <section class="admin-card" style="margin-bottom: 0;">
                <div class="admin-card-head">
                    <div>
                        <h3><i class="fa-solid fa-building-columns" style="color: #6366f1; margin-right: 8px;"></i> Institutional Overview</h3>
                        <p>Campus organization and infrastructure metrics.</p>
                    </div>
                </div>

                <ul class="profile-field-list" style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px;">
                    <li style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
                        <span style="font-size: 0.86rem; color: #94a3b8; font-weight: 600;">Institution Name</span>
                        <strong style="font-size: 0.95rem;"><%= safeCollege ? safeCollege.collegeName : "Mirai School of Technology" %></strong>
                    </li>
                    <li style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
                        <span style="font-size: 0.86rem; color: #94a3b8; font-weight: 600;">Institution Code</span>
                        <span class="admin-badge" style="background: rgba(6, 182, 212, 0.12); color: #0891b2; font-weight: 800;"><%= safeCollege ? safeCollege.collegeCode : "MIRAI001" %></span>
                    </li>
                    <li style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
                        <span style="font-size: 0.86rem; color: #94a3b8; font-weight: 600;">Configured Classrooms</span>
                        <strong style="font-size: 0.95rem;"><%= safeCounts.classrooms %> Rooms</strong>
                    </li>
                    <li style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
                        <span style="font-size: 0.86rem; color: #94a3b8; font-weight: 600;">Registered Subjects</span>
                        <strong style="font-size: 0.95rem;"><%= safeCounts.subjects %> Courses</strong>
                    </li>
                    <li style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.06);">
                        <span style="font-size: 0.86rem; color: #94a3b8; font-weight: 600;">Active Class Groups</span>
                        <strong style="font-size: 0.95rem;"><%= safeCounts.classGroups %> Cohorts</strong>
                    </li>
                    <li style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-size: 0.86rem; color: #94a3b8; font-weight: 600;">Last Active Session</span>
                        <span style="font-size: 0.9rem; color: #10b981; font-weight: 700;">
                            <i class="fa-solid fa-circle" style="font-size: 0.5rem; vertical-align: middle; margin-right: 4px;"></i> Live Now
                        </span>
                    </li>
                </ul>
            </section>

        </div>

    </main>
</div>

<script src="/js/uiShell.js"></script>
<script src="/js/adminValidation.js"></script>
<script src="/js/csrfAuto.js" defer></script>
<script src="/js/selectEnhancer.js?v=3" defer></script>
<script src="/js/adminRealtime.js"></script>
</body>
</html>
