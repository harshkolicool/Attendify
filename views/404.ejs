<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Page Not Found | Attendify</title>

    <link rel="stylesheet" href="/css/uiShell.css">
    <link rel="stylesheet" href="/css/authPages.css?v=20260901_3">
    <link rel="stylesheet" href="/css/attendifyDarkFix.css?v=8">
    <link rel="stylesheet" href="/css/attendifyUIOverhaulExtra.css?v=19">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="icon" type="image/png" href="/favicon.png">

    <style>
        .notfound-pod {
            text-align: center;
            padding: 50px 32px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .notfound-mark {
            width: 84px;
            height: 84px;
            border-radius: 20px;
            background: rgba(244, 63, 94, 0.15);
            border: 2px solid rgba(244, 63, 94, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.2rem;
            color: #fb7185;
            margin-bottom: 20px;
            box-shadow: 0 0 30px rgba(244, 63, 94, 0.3);
        }

        .notfound-code {
            font-family: "Outfit", sans-serif;
            font-size: clamp(3.5rem, 8vw, 5.5rem);
            font-weight: 900;
            line-height: 1;
            background: linear-gradient(135deg, #fb7185, #818cf8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 8px;
        }

        .notfound-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-top: 28px;
            flex-wrap: wrap;
            justify-content: center;
        }
    </style>

    <!-- SweetAlert2 for Custom UI Alerts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" defer></script>
    <script src="/js/customAlerts.js" defer></script>

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#090d16">
    <link rel="apple-touch-icon" href="/icon-192.png">

    <% if (typeof csrfToken !== "undefined") { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
    <% if (typeof realtimeMode !== "undefined") { %>
    <script>
    window.AttendifyRealtimeConfig = {
        mode: <%- JSON.stringify(realtimeMode) %>,
        pollIntervalMs: <%= typeof realtimePollIntervalMs !== "undefined" ? realtimePollIntervalMs : 5000 %>
    };
    </script>
    <% } %>
</head>
<body class="auth-redesign-body">

<div class="auth-bg-ambient">
    <div class="auth-grid-overlay"></div>
</div>

<div class="auth-container" style="max-width: 620px;">
    <div class="auth-card-split" style="grid-template-columns: 1fr;">

        <div class="notfound-pod">
            <div class="notfound-mark">
                <i class="fa-solid fa-map-location-dot"></i>
            </div>

            <div class="notfound-code">404</div>

            <h2 style="font-family: 'Outfit', sans-serif; font-size: 1.6rem; font-weight: 800; color: #ffffff; margin-bottom: 8px;">
                Page Outside Campus Coordinates
            </h2>

            <p style="color: var(--auth-muted); font-size: 0.92rem; line-height: 1.6; max-width: 440px; margin: 0 auto;">
                The endpoint you requested does not exist, has expired, or is outside the permitted institutional routing perimeter.
            </p>

            <div class="notfound-actions">
                <a href="/" class="auth-submit-btn teacher" style="text-decoration: none; padding: 10px 20px;">
                    <i class="fa-solid fa-house"></i>
                    <span>Return to Home</span>
                </a>

                <button type="button" class="footer-nav-btn" onclick="history.back()" style="padding: 10px 18px; font-size: 0.9rem;">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span>Go Back</span>
                </button>
            </div>
        </div>

    </div>
</div>

<script src="/js/csrfAuto.js" defer></script>
<script src="/js/selectEnhancer.js" defer></script>
</body>
</html>
