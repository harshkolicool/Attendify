<!DOCTYPE html>
<html lang="en">

<head>
    <script>
        (function(){try{var t=localStorage.getItem('attendifyTheme')||localStorage.getItem('theme');if(t==='dark'||(!t&&window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches)){document.documentElement.setAttribute('data-theme','dark');document.documentElement.classList.add('dark-mode');document.documentElement.style.backgroundColor='#0b0f19';}else{document.documentElement.setAttribute('data-theme','light');document.documentElement.classList.remove('dark-mode');document.documentElement.style.backgroundColor='#f8fafc';}}catch(e){}})();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Schedule | Attendify</title>

    <!-- Preconnect to external CDNs for faster DNS resolution -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://fonts.gstatic.com">

    <link rel="stylesheet" href="/css/uiShell.css?v=20260901_fixed3">
    <link rel="stylesheet" href="/css/studentSchedule.css?v=20260831_18">
    <link rel="stylesheet" href="/css/attendifyDarkFix.css?v=8_18">
    <link rel="stylesheet" href="/css/attendifyUIOverhaul.css?v=20260831_18">
    <link rel="stylesheet" href="/css/attendifyUIOverhaulExtra.css?v=19_18">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="icon" type="image/png" href="/favicon.png">

    <!-- SweetAlert2 for Custom UI Alerts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11" defer></script>
    <script src="/js/customAlerts.js" defer></script>

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#4f46e5">
    <link rel="apple-touch-icon" href="/icon-192.png">
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/service-worker.js');
            });
        }
    </script>


    <% if (typeof csrfToken !== "undefined") { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
    <% if (typeof realtimeMode !== "undefined") { %>
    <script>
    window.AttendifyRealtimeConfig = {
        mode: <%- JSON.stringify(realtimeMode) %>,
        pollIntervalMs: <%= typeof realtimePollIntervalMs !== "undefined" ? realtimePollIntervalMs : 5000 %>
    };
    </script>
    <% } %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.js"></script>
</head>

<body>
    <%
        const groups = typeof weeklyScheduleGroups !== "undefined" ? weeklyScheduleGroups : [];
        const activeMap = typeof activeSessionsBySchedule !== "undefined" ? activeSessionsBySchedule : {};
        const todaySessionMap = typeof todaySessionsBySchedule !== "undefined" ? todaySessionsBySchedule : {};
        const statusMap = typeof attendanceStatusBySchedule !== "undefined" ? attendanceStatusBySchedule : {};
        const currentRealtimeMode = typeof realtimeMode !== "undefined" ? realtimeMode : "auto";
        const currentPollIntervalMs = typeof realtimePollIntervalMs !== "undefined" ? realtimePollIntervalMs : 5000;

        const studentLiveBootstrap = [];

        for (const scheduleKey in activeMap) {
            if (activeMap[scheduleKey] && activeMap[scheduleKey]._id) {
                studentLiveBootstrap.push({
                    sessionId: activeMap[scheduleKey]._id.toString()
                });
            }
        }

        const scheduleNow = new Date();
        const scheduleNowMinutes = (scheduleNow.getHours() * 60) + scheduleNow.getMinutes();

        function scheduleTimeToMinutes(timeText) {
            if (!timeText || typeof timeText !== "string") {
                return -1;
            }

            const text = timeText.trim().toUpperCase();
            const match = text.match(/^(\d{1,2}):(\d{2})\s*(AM|PM)$/);

            if (!match) {
                return -1;
            }

            let hours = Number(match[1]);
            const minutes = Number(match[2]);
            const meridian = match[3];

            if (meridian === "PM" && hours !== 12) {
                hours += 12;
            }

            if (meridian === "AM" && hours === 12) {
                hours = 0;
            }

            return (hours * 60) + minutes;
        }

        function scheduleIsLiveWindow(startTime, endTime) {
            const startMinutes = scheduleTimeToMinutes(startTime);
            const endMinutes = scheduleTimeToMinutes(endTime);

            if (startMinutes < 0 || endMinutes < 0) {
                return false;
            }

            return scheduleNowMinutes >= startMinutes && scheduleNowMinutes <= endMinutes;
        }

        function getScheduleCardState(group, item) {
            const scheduleId = item._id.toString();
            const activeSession = activeMap[scheduleId];
            const todaySession = todaySessionMap[scheduleId];
            const attendanceInfo = statusMap[scheduleId];
            const isToday = group.offset === 0;
            const isLiveWindow = isToday && scheduleIsLiveWindow(item.startTime, item.endTime);
            const endMinutes = scheduleTimeToMinutes(item.endTime);

            const isEndedWithoutAttendance =
                isToday &&
                endMinutes >= 0 &&
                scheduleNowMinutes > endMinutes &&
                !activeSession &&
                !attendanceInfo;

            let cardState = "waiting";
            let cardSessionId = "";
            let actionResult = null;

            if (isToday && typeof attendanceWindow !== "undefined" && attendanceWindow && typeof attendanceWindow.getStudentAttendanceAction === "function") {
                actionResult = attendanceWindow.getStudentAttendanceAction({
                    record: attendanceInfo ? attendanceInfo.record : null,
                    session: activeSession,
                    schedule: item
                });
            }

            if (actionResult) {
                if (actionResult.action === "PRESENT" || actionResult.action === "LATE") {
                    cardState = "present";
                } else if (actionResult.canMark && activeSession) {
                    cardState = "live";
                    cardSessionId = activeSession._id.toString();
                } else if (actionResult.action === "AUTO_ABSENT_LOCKED" || actionResult.action === "MANUAL_ABSENT") {
                    cardState = "absent";
                } else if (attendanceInfo && attendanceInfo.status === "ABSENT") {
                    cardState = "absent";
                } else if (todaySession && !activeSession) {
                    cardState = "pending";
                    cardSessionId = todaySession._id.toString();
                } else if (isLiveWindow) {
                    cardState = "ongoing";
                } else if (isEndedWithoutAttendance) {
                    cardState = "unmarked";
                } else if (!isToday) {
                    cardState = "upcoming";
                }
            } else {
                if (attendanceInfo && (attendanceInfo.status === "PRESENT" || attendanceInfo.status === "LATE")) {
                    cardState = "present";
                } else if (attendanceInfo && attendanceInfo.status === "ABSENT") {
                    if (isToday && activeSession) {
                        cardState = "live";
                        cardSessionId = activeSession._id.toString();
                    } else {
                        cardState = "absent";
                    }
                } else if (isToday && activeSession) {
                    cardState = "live";
                    cardSessionId = activeSession._id.toString();
                } else if (isToday && todaySession) {
                    cardState = "pending";
                    cardSessionId = todaySession._id.toString();
                } else if (isLiveWindow) {
                    cardState = "ongoing";
                } else if (isEndedWithoutAttendance) {
                    cardState = "unmarked";
                } else if (!isToday) {
                    cardState = "upcoming";
                }
            }

            return {
                scheduleId,
                activeSession,
                todaySession,
                attendanceInfo,
                isToday,
                isLiveWindow,
                cardState,
                cardSessionId,
                actionResult
            };
        }

        function getStatusBadge(cardState) {
            if (cardState === "live") {
                return {
                    className: "status-badge live",
                    icon: "pulse-dot",
                    label: "Live Attendance"
                };
            }

            if (cardState === "ongoing") {
                return {
                    className: "status-badge ongoing",
                    icon: "fa-solid fa-chalkboard-user",
                    label: "Class In Session"
                };
            }

            if (cardState === "present") {
                return {
                    className: "status-badge present",
                    icon: "fa-solid fa-circle-check",
                    label: "Present"
                };
            }

            if (cardState === "absent") {
                return {
                    className: "status-badge absent",
                    icon: "fa-solid fa-circle-xmark",
                    label: "Absent"
                };
            }

            if (cardState === "unmarked") {
                return {
                    className: "status-badge unmarked",
                    icon: "fa-solid fa-triangle-exclamation",
                    label: "Unmarked"
                };
            }

            if (cardState === "pending") {
                return {
                    className: "status-badge pending",
                    icon: "fa-solid fa-hourglass-half",
                    label: "Pending"
                };
            }

            if (cardState === "upcoming") {
                return {
                    className: "status-badge waiting",
                    icon: "fa-solid fa-calendar-day",
                    label: "Upcoming"
                };
            }

            return {
                className: "status-badge waiting",
                icon: "fa-solid fa-clock",
                label: "Waiting"
            };
        }

        function getTeacherName(item) {
            if (!item || !item.teacher) {
                return "Teacher Missing";
            }

            return item.teacher.fullName || item.teacher.name || "Teacher Missing";
        }

        function getClassroomName(item) {
            if (!item || !item.classroom) {
                return "Room Missing";
            }

            return item.classroom.classroomName || item.classroom.name || "Room Missing";
        }

        function getSubjectName(item) {
            if (!item || !item.subject) {
                return "Subject";
            }

            return item.subject.subjectName || item.subject.name || "Subject";
        }

        function getSubjectCode(item) {
            if (!item || !item.subject) {
                return "Subject";
            }

            return item.subject.subjectCode || item.subject.subjectName || item.subject.name || "Subject";
        }
    %>

    <div class="schedule-layout">
        <%- include("student/partials/sidebar", {
            activePage: typeof activePage !== "undefined" ? activePage : "",
            student: typeof student !== "undefined" ? student : null
        }) %>

        <main class="schedule-main">
            <header class="dashboard-header">
                <div>
                    <span class="dashboard-kicker">Student Panel</span>
                    <h1>Weekly Schedule</h1>
                    <p>View today and upcoming classes for the next 7 days.</p>
                </div>

                <div class="schedule-header-actions">
                    <div class="schedule-datepicker-btn" id="scheduleDateBtn" title="Click to change date">
                        <div class="schedule-datepicker-icon">
                            <i class="fa-solid fa-calendar-days"></i>
                        </div>
                        <div class="schedule-datepicker-text">
                            <span class="schedule-datepicker-kicker">Selected Date</span>
                            <span class="schedule-datepicker-val" id="scheduleDisplayDate">
                                <%= typeof targetDate !== 'undefined' && targetDate ? new Date(targetDate + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Today' %>
                            </span>
                        </div>
                        <i class="fa-solid fa-chevron-down schedule-datepicker-arrow"></i>
                        <input type="text" id="scheduleWeekPicker" class="schedule-hidden-input" value="<%= typeof targetDate !== 'undefined' ? targetDate : '' %>" readonly autocomplete="off">
                    </div>

                    <a href="/student/dashboard" class="schedule-dashboard-btn">
                        <i class="fa-solid fa-house"></i>
                        <span>Dashboard</span>
                    </a>
                </div>
            </header>

            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    const picker = document.getElementById("scheduleWeekPicker");
                    const dateBtn = document.getElementById("scheduleDateBtn");
                    const historyDates = <%- typeof historyDates !== 'undefined' ? historyDates : '{"present":[],"absent":[],"unmarked":[]}' %>;
                    
                    const fp = flatpickr(picker, {
                        dateFormat: "Y-m-d",
                        defaultDate: "<%= targetDate %>",
                        disableMobile: true,
                        position: "auto right",
                        locale: {
                            weekdays: {
                                shorthand: ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"],
                                longhand: ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]
                            }
                        },
                        onReady: function(selectedDates, dateStr, instance) {
                            if (!instance.calendarContainer.querySelector(".flatpickr-attendance-legend")) {
                                const legend = document.createElement("div");
                                legend.className = "flatpickr-attendance-legend";
                                legend.innerHTML = `
                                    <span class="legend-item"><span class="legend-dot green"></span> Present</span>
                                    <span class="legend-item"><span class="legend-dot red"></span> Absent</span>
                                    <span class="legend-item"><span class="legend-dot yellow"></span> Unmarked</span>
                                `;
                                instance.calendarContainer.appendChild(legend);
                            }
                        },
                        onChange: function(selectedDates, dateStr, instance) {
                            if (dateStr) {
                                window.location.href = '/student/schedule?date=' + dateStr;
                            }
                        },
                        onDayCreate: function(dObj, dStr, fp, dayElem) {
                            const dateObj = dayElem.dateObj;
                            if (!dateObj) return;
                            
                            const year = dateObj.getFullYear();
                            const month = String(dateObj.getMonth() + 1).padStart(2, "0");
                            const day = String(dateObj.getDate()).padStart(2, "0");
                            const localISOTime = year + "-" + month + "-" + day;
                            
                            if (historyDates.present && historyDates.present.includes(localISOTime)) {
                                dayElem.classList.add("attendance-status-present");
                                dayElem.setAttribute("title", "Present (" + localISOTime + ")");
                            } else if (historyDates.absent && historyDates.absent.includes(localISOTime)) {
                                dayElem.classList.add("attendance-status-absent");
                                dayElem.setAttribute("title", "Absent (" + localISOTime + ")");
                            } else if (historyDates.unmarked && historyDates.unmarked.includes(localISOTime)) {
                                dayElem.classList.add("attendance-status-unmarked");
                                dayElem.setAttribute("title", "Unmarked (" + localISOTime + ")");
                            }
                        }
                    });

                    if (dateBtn && fp) {
                        dateBtn.addEventListener('click', function(e) {
                            if (e.target !== picker) {
                                fp.open();
                            }
                        });
                    }
                });
            </script>

            <div id="messageBox" class="schedule-message"></div>

            <% if (!groups || groups.length === 0) { %>
                <section class="dashboard-panel">
                    <div class="empty-state">
                        <i class="fa-solid fa-calendar-xmark"></i>
                        <h3>No schedule found</h3>
                        <p>Your class schedule has not been assigned yet.</p>
                    </div>
                </section>
            <% } %>

            <% groups.forEach(function(group) { %>
                <section class="dashboard-panel weekly-day-panel" data-day-offset="<%= group.offset %>">
                    <div class="weekly-day-head">
                        <div class="weekly-day-info">
                            <div class="date-highlight-badge">
                                <span class="date-highlight-day"><%= new Date(group.date).getDate() %></span>
                                <span class="date-highlight-month"><%= new Date(group.date).toLocaleString('default', { month: 'short' }) %></span>
                            </div>
                            <div>
                                <% 
                                    const cDate = new Date(group.date);
                                    const isToday = cDate.toDateString() === new Date().toDateString();
                                    const isTomorrow = new Date(new Date().setDate(new Date().getDate() + 1)).toDateString() === cDate.toDateString();
                                    const displayTitle = isToday ? "Today" : (isTomorrow ? "Tomorrow" : cDate.toLocaleString('default', { weekday: 'long' }));
                                %>
                                <h3 class="weekly-day-title">
                                    <%= displayTitle %>
                                </h3>
                                <p class="weekly-day-date">
                                    <%= cDate.toLocaleDateString("en-IN", { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                    <% if (displayTitle === "Today" || displayTitle === "Tomorrow") { %>
                                        · <%= cDate.toLocaleString('default', { weekday: 'long' }) %>
                                    <% } %>
                                </p>
                            </div>
                        </div>

                        <span class="panel-count">
                            <i class="fa-solid fa-graduation-cap"></i>
                            <%= group.schedules ? group.schedules.length : 0 %> <%= (group.schedules && group.schedules.length === 1) ? 'Class' : 'Classes' %>
                        </span>
                    </div>

                    <% if (!group.schedules || group.schedules.length === 0) { %>
                        <div class="student-history-empty">
                            <i class="fa-regular fa-calendar-check"></i>
                            <span>No classes scheduled for this day</span>
                        </div>
                    <% } else { %>
                        <% if (group.offset === 0) { %>
                            <div class="gps-help-banner" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                                <div>
                                    <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                                    <strong>GPS Tip:</strong>
                                    For best accuracy, use mobile Chrome, enable precise location, turn off battery saver, and wait 5–10 seconds.
                                </div>
                                <button type="button" class="view-btn" onclick="warmUpGPS(this)" style="white-space: nowrap;">
                                    <i class="fa-solid fa-satellite-dish"></i> Calibrate GPS
                                </button>
                            </div>
                        <% } %>

                        <div class="schedule-list">
                            <% group.schedules.forEach(function(item) { %>
                                <%
                                    const state = getScheduleCardState(group, item);
                                    const badge = getStatusBadge(state.cardState);
                                %>

                                <article
                                    class="class-card"
                                    data-schedule-id="<%= state.scheduleId %>"
                                    data-session-id="<%= state.cardSessionId %>"
                                    data-attendance-state="<%= state.cardState %>"
                                    data-start-time="<%= item.startTime %>"
                                    data-end-time="<%= item.endTime %>"
                                    data-day-offset="<%= group.offset %>"
                                >
                                    <div class="class-card-top">
                                        <div class="class-card-badges">
                                            <span class="subject-pill">
                                                <%= getSubjectCode(item) %>
                                            </span>
                                        </div>

                                        <div class="class-card-status-wrap">
                                            <span class="<%= badge.className %>">
                                                <i class="<%= badge.icon %>"></i>
                                                <%= badge.label %>
                                            </span>
                                        </div>
                                    </div>

                                    <div class="class-content">
                                        <div class="class-info">
                                            <h4><%= getSubjectName(item) %></h4>

                                            <div class="class-meta-row">
                                                <span class="class-meta-item">
                                                    <i class="fa-solid fa-user-tie"></i>
                                                    <%= getTeacherName(item) %>
                                                </span>
                                                <span class="class-meta-dot">·</span>
                                                <span class="class-meta-item">
                                                    <i class="fa-solid fa-door-open"></i>
                                                    <%= getClassroomName(item) %>
                                                </span>
                                            </div>
                                        </div>

                                        <div class="class-action-group">
                                            <div class="class-time">
                                                <i class="fa-regular fa-clock"></i>
                                                <span><%= item.startTime %> – <%= item.endTime %></span>
                                            </div>

                                            <div class="js-schedule-action class-action">
                                                <% if (state.actionResult) { %>
                                                    <% if (state.actionResult.canMark) { %>
                                                        <button
                                                            class="view-btn live js-mark-attendance-btn"
                                                            type="button"
                                                            data-session-id="<%= state.cardSessionId %>"
                                                        >
                                                            <i class="fa-solid fa-location-crosshairs"></i>
                                                            <%= state.actionResult.label %>
                                                        </button>
                                                    <% } else { %>
                                                        <%
                                                            let btnClass = "view-btn";

                                                            if (state.cardState === "present" || state.cardState === "absent") {
                                                                btnClass += " marked " + state.cardState;
                                                            } else if (state.cardState === "unmarked") {
                                                                btnClass += " unmarked";
                                                            } else if (state.cardState === "pending") {
                                                                btnClass += " pending";
                                                            }
                                                        %>

                                                        <button class="<%= btnClass %>" type="button" disabled>
                                                            <% if (state.cardState === "present") { %>
                                                                <i class="fa-solid fa-check"></i>
                                                            <% } else if (state.cardState === "absent") { %>
                                                                <i class="fa-solid fa-xmark"></i>
                                                            <% } else if (state.cardState === "ongoing") { %>
                                                                <i class="fa-solid fa-hourglass-half"></i>
                                                            <% } %>
                                                            <%= state.actionResult.label %>
                                                        </button>
                                                    <% } %>
                                                <% } else { %>
                                                    <% if (state.cardState === "live") { %>
                                                        <button
                                                            class="view-btn live js-mark-attendance-btn"
                                                            type="button"
                                                            data-session-id="<%= state.cardSessionId %>"
                                                        >
                                                            <i class="fa-solid fa-location-crosshairs"></i>
                                                            Mark Attendance
                                                        </button>
                                                    <% } else if (state.cardState === "ongoing") { %>
                                                        <button class="view-btn" type="button" disabled>
                                                            <i class="fa-solid fa-hourglass-half"></i>
                                                            Teacher Not Started
                                                        </button>
                                                    <% } else if (state.cardState === "present") { %>
                                                        <button class="view-btn marked present" type="button" disabled>
                                                            <i class="fa-solid fa-check"></i>
                                                            Attendance Marked
                                                        </button>
                                                    <% } else if (state.cardState === "absent") { %>
                                                        <button class="view-btn marked absent" type="button" disabled>
                                                            <i class="fa-solid fa-xmark"></i>
                                                            Marked Absent
                                                        </button>
                                                    <% } else if (state.cardState === "unmarked") { %>
                                                        <button class="view-btn unmarked" type="button" disabled>
                                                            Unmarked
                                                        </button>
                                                    <% } else if (state.cardState === "pending") { %>
                                                        <button class="view-btn pending" type="button" disabled>
                                                            Pending
                                                        </button>
                                                    <% } else if (state.cardState === "upcoming") { %>
                                                        <button class="view-btn" type="button" disabled>
                                                            Upcoming
                                                        </button>
                                                    <% } else { %>
                                                        <button class="view-btn" type="button" disabled>
                                                            Not Started
                                                        </button>
                                                    <% } %>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </article>
                            <% }) %>
                        </div>
                    <% } %>
                </section>
            <% }) %>
        </main>

        <aside class="profile-panel">
            <div class="profile-card">
                <div class="profile-avatar">
                    <%= typeof student !== "undefined" && student.fullName ? student.fullName.charAt(0).toUpperCase() : "S" %>
                </div>

                <div>
                    <h3>
                        <%= typeof student !== "undefined" && student.fullName ? student.fullName : "Student" %>
                    </h3>
                    <a href="/student/dashboard">Open Profile</a>
                </div>
            </div>

            <div class="side-stat">
                <div class="side-stat-icon blue">
                    <i class="fa-solid fa-users-rectangle"></i>
                </div>

                <div>
                    <span>Class Group</span>
                    <strong>
                        <%= typeof student !== "undefined" && student.classGroup ? student.classGroup.name : "-" %>
                    </strong>
                </div>
            </div>

            <div class="side-stat">
                <div class="side-stat-icon purple">
                    <i class="fa-solid fa-book-open"></i>
                </div>

                <div>
                    <span>Subjects</span>
                    <strong>
                        <%= typeof student !== "undefined" && student.subjects ? student.subjects.length : 0 %> Subjects
                    </strong>
                </div>
            </div>

            <div class="side-stat">
                <div class="side-stat-icon green">
                    <i class="fa-solid fa-fingerprint"></i>
                </div>

                <div>
                    <span>Security</span>
                    <strong>
                        <%= typeof passkeyCount !== "undefined" ? passkeyCount : 0 %> Passkey ·
                        <%= typeof trustedDeviceCount !== "undefined" ? trustedDeviceCount : 0 %> Browser
                    </strong>
                </div>
            </div>
        </aside>
    </div>

    <script type="application/json" id="studentLiveSessionBootstrap"><%- JSON.stringify(studentLiveBootstrap).replace(/</g, "\\u003c") %></script>

    <script>
        window.AttendifyRealtimeConfig = {
            mode: "<%= currentRealtimeMode %>",
            pollIntervalMs: <%= currentPollIntervalMs %>
        };
    </script>

    <% if (currentRealtimeMode === "socket" || currentRealtimeMode === "auto") { %>
        <script src="/socket.io/socket.io.js"></script>
    <% } %>

    <script src="https://unpkg.com/@simplewebauthn/browser/dist/bundle/index.umd.min.js"></script>
    <script src="/js/studentPasskey.js"></script>
    <script src="/js/kalmanFilter.js"></script>
